{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "style": "${SeverityStyle}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "🔑 Credential Oversharing Detector",
                  "weight": "Bolder",
                  "size": "Medium",
                  "color": "${SeverityColor}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${AlertSeverity}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "color": "${SeverityColor}"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${Timestamp}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Scan Summary",
          "weight": "Bolder",
          "size": "Medium",
          "spacing": "Medium"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Scan Time",
              "value": "${Timestamp}"
            },
            {
              "title": "Environments Scanned",
              "value": "${TotalEnvironments}"
            },
            {
              "title": "Agents Scanned",
              "value": "${AgentsScanned}"
            },
            {
              "title": "Violations Found",
              "value": "${ViolationsFound}"
            },
            {
              "title": "Overall Severity",
              "value": "${AlertSeverity}"
            }
          ],
          "spacing": "Medium"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Zone Compliance Breakdown",
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone",
                  "weight": "Bolder",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Compliant",
                  "weight": "Bolder",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Total",
                  "weight": "Bolder",
                  "size": "Small"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 1",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z1Compliant}",
                  "size": "Small",
                  "color": "${Z1StatusColor}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z1Total}",
                  "size": "Small"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 2",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z2Compliant}",
                  "size": "Small",
                  "color": "${Z2StatusColor}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z2Total}",
                  "size": "Small"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 3",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z3Compliant}",
                  "size": "Small",
                  "color": "${Z3StatusColor}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${Z3Total}",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Top Findings",
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "Container",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding1Type}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding1SeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding1Severity}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding1SeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Agent",
                  "value": "${Finding1Agent}"
                },
                {
                  "title": "Connector",
                  "value": "${Finding1Connector}"
                },
                {
                  "title": "Description",
                  "value": "${Finding1Description}"
                }
              ],
              "spacing": "Small"
            }
          ],
          "separator": false,
          "spacing": "Small"
        },
        {
          "type": "Container",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding2Type}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding2SeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding2Severity}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding2SeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Agent",
                  "value": "${Finding2Agent}"
                },
                {
                  "title": "Connector",
                  "value": "${Finding2Connector}"
                },
                {
                  "title": "Description",
                  "value": "${Finding2Description}"
                }
              ],
              "spacing": "Small"
            }
          ],
          "separator": true,
          "spacing": "Small"
        },
        {
          "type": "Container",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding3Type}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding3SeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding3Severity}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding3SeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Agent",
                  "value": "${Finding3Agent}"
                },
                {
                  "title": "Connector",
                  "value": "${Finding3Connector}"
                },
                {
                  "title": "Description",
                  "value": "${Finding3Description}"
                }
              ],
              "spacing": "Small"
            }
          ],
          "separator": true,
          "spacing": "Small"
        },
        {
          "type": "Container",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding4Type}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding4SeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding4Severity}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding4SeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Agent",
                  "value": "${Finding4Agent}"
                },
                {
                  "title": "Connector",
                  "value": "${Finding4Connector}"
                },
                {
                  "title": "Description",
                  "value": "${Finding4Description}"
                }
              ],
              "spacing": "Small"
            }
          ],
          "separator": true,
          "spacing": "Small"
        },
        {
          "type": "Container",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding5Type}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding5SeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${Finding5Severity}",
                      "weight": "Bolder",
                      "size": "Small",
                      "color": "${Finding5SeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Agent",
                  "value": "${Finding5Agent}"
                },
                {
                  "title": "Connector",
                  "value": "${Finding5Connector}"
                },
                {
                  "title": "Description",
                  "value": "${Finding5Description}"
                }
              ],
              "spacing": "Small"
            }
          ],
          "separator": true,
          "spacing": "Small"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "View in Power Platform Admin Center",
      "url": "https://admin.powerplatform.microsoft.com/environments"
    },
    {
      "type": "Action.OpenUrl",
      "title": "View Documentation",
      "url": "${DocumentationUrl}"
    },
    {
      "type": "Action.Submit",
      "title": "Acknowledge Findings",
      "data": {
        "action": "acknowledge",
        "scanId": "${ScanId}",
        "timestamp": "${Timestamp}",
        "acknowledgedBy": "${AcknowledgedBy}"
      }
    }
  ],
  "_metadata": {
    "description": "Teams Adaptive Card template for Credential Oversharing Detector alerts. Populated by the scan script and sent via the Power Automate Teams connector or Microsoft Graph.",
    "severityColorMappings": {
      "Critical": {
        "style": "attention",
        "color": "Attention",
        "description": "Red — immediate remediation required"
      },
      "High": {
        "style": "warning",
        "color": "Warning",
        "description": "Orange — review within 24 hours"
      },
      "Medium": {
        "style": "accent",
        "color": "Accent",
        "description": "Blue — review within 1 business week"
      },
      "Low": {
        "style": "good",
        "color": "Good",
        "description": "Green — document for governance awareness"
      },
      "Informational": {
        "style": "default",
        "color": "Default",
        "description": "Gray — logged for audit trail, no action required"
      }
    },
    "placeholderTokens": {
      "header": ["AlertSeverity", "SeverityStyle", "SeverityColor", "Timestamp"],
      "scanSummary": ["Timestamp", "TotalEnvironments", "AgentsScanned", "ViolationsFound", "AlertSeverity"],
      "zoneCompliance": ["Z1Compliant", "Z1Total", "Z1StatusColor", "Z2Compliant", "Z2Total", "Z2StatusColor", "Z3Compliant", "Z3Total", "Z3StatusColor"],
      "findings": ["Finding{N}Type", "Finding{N}Agent", "Finding{N}Connector", "Finding{N}Severity", "Finding{N}SeverityColor", "Finding{N}Description"],
      "actions": ["DocumentationUrl", "ScanId", "AcknowledgedBy"]
    },
    "flowIntegration": {
      "teamsConnectorMethod": "Post the populated card via Power Automate using the Teams 'Post adaptive card in a chat or channel' action. Microsoft 365 connectors and Teams Incoming Webhooks are retired or nearing retirement; do not use them for new alerting flows.",
      "graphMethod": "Alternatively, use Microsoft Graph chatMessage endpoint to post to a Teams channel. Note: Action.Submit responses require a bot or Power Automate Workflows endpoint to receive the callback; chatMessage posting alone will not capture acknowledgement clicks.",
      "populationNotes": "Replace all ${Token} placeholders before sending. Findings 1-5 are optional — omit unused finding containers by filtering the body array. Set SeverityStyle and SeverityColor based on the severityColorMappings above using the highest severity violation found."
    }
  }
}
