{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_expansion_request_created": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "fsi_expansionrequest",
          "subscriptionRequest/scope": 4
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Get_Request_Details": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_expansionrequests",
          "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
          "$expand": "fsi_agentscopeid($select=fsi_name,fsi_agentid,fsi_zone,fsi_allowedconnectors,fsi_allowedsites,fsi_allowedtables,fsi_allowedapis),fsi_requestedby($select=internalemailaddress,fullname),fsi_scopeviolationid($select=fsi_name,fsi_scopeviolationid)",
          "$select": "fsi_expansionrequestid,fsi_name,fsi_requesttype,fsi_resourcename,fsi_resourceurl,fsi_justification,fsi_requestedon,fsi_requestedaccesslevel"
        },
        "authentication": "@parameters('$authentication')"
      },
      "retryPolicy": {
        "type": "exponential",
        "count": 3,
        "interval": "PT10S",
        "minimumInterval": "PT10S",
        "maximumInterval": "PT1H"
      }
    },
    "Terminate_On_Read_Failure": {
      "runAfter": {
        "Get_Request_Details": [
          "Failed"
        ]
      },
      "type": "Terminate",
      "inputs": {
        "runStatus": "Cancelled",
        "runError": {
          "code": "RecordNotFound",
          "message": "Failed to retrieve expansion request details. The record may have been deleted between trigger and execution."
        }
      }
    },
    "Get_Request_Type_Label": {
      "runAfter": {
        "Get_Request_Details": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 1), 'Add Connector', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 2), 'Add SharePoint Site', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 3), 'Add Dataverse Table', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 4), 'Add External API', 'Increase Access Level'))))"
    },
    "Get_Zone_Label": {
      "runAfter": {
        "Get_Request_Type_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_zone'], 1), 'Zone 1 - Personal', if(equals(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_zone'], 2), 'Zone 2 - Team', 'Zone 3 - Enterprise'))"
    },
    "Build_Approval_Details": {
      "runAfter": {
        "Get_Zone_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "## Scope Expansion Request\n\n**Agent:** @{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}\n**Zone:** @{outputs('Get_Zone_Label')}\n**Request Type:** @{outputs('Get_Request_Type_Label')}\n\n---\n\n**Resource to Add:** @{outputs('Get_Request_Details')?['body/fsi_resourcename']}\n**Resource URL:** @{coalesce(outputs('Get_Request_Details')?['body/fsi_resourceurl'], 'N/A')}\n\n**Justification:**\n@{outputs('Get_Request_Details')?['body/fsi_justification']}\n\n---\n\n**Requested By:** @{outputs('Get_Request_Details')?['body/fsi_requestedby/fullname']}\n**Requested On:** @{formatDateTime(outputs('Get_Request_Details')?['body/fsi_requestedon'], 'yyyy-MM-dd HH:mm')} UTC\n\n---\n\nPlease review and approve or reject this scope expansion request."
    },
    "Update_Request_Under_Review": {
      "runAfter": {
        "Build_Approval_Details": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "UpdateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_expansionrequests",
          "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
          "item": {
            "fsi_status": 3
          }
        },
        "authentication": "@parameters('$authentication')"
      },
      "retryPolicy": {
        "type": "exponential",
        "count": 3,
        "interval": "PT10S",
        "minimumInterval": "PT10S",
        "maximumInterval": "PT1H"
      }
    },
    "Handle_Status_Update_Failure": {
      "runAfter": {
        "Update_Request_Under_Review": [
          "Failed"
        ]
      },
      "type": "Scope",
      "actions": {
        "Update_Request_Failed_On_Status_Update": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_expansionrequests",
              "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
              "item": {
                "fsi_status": 7,
                "fsi_completedon": "@{utcNow()}"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT1H"
          }
        },
        "Send_Status_Update_Failure_Notification": {
          "runAfter": {
            "Update_Request_Failed_On_Status_Update": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{concat(outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress'], ';', parameters('fsi_SDM_SecurityTeamEmail'))}",
                "Subject": "[Scope Expansion] FAILED: @{outputs('Get_Request_Details')?['body/fsi_name']}",
                "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#d13438;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Scope Expansion Request Failed</div><p>Your scope expansion request could not be processed due to an internal error while updating the request status.</p><table><tr><td><strong>Agent:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</td></tr><tr><td><strong>Request:</strong></td><td>@{outputs('Get_Request_Type_Label')}</td></tr><tr><td><strong>Resource:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_resourcename']}</td></tr></table><p>Please submit a new request or contact the security team for assistance.</p></body></html>",
                "Importance": "High"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT1H"
          }
        }
      }
    },
    "Start_Approval": {
      "runAfter": {
        "Update_Request_Under_Review": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_approvals",
          "operationId": "StartAndWaitForAnApproval",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
        },
        "parameters": {
          "approvalType": "Basic",
          "WebhookApprovalCreationInput/title": "Scope Expansion: @{outputs('Get_Request_Details')?['body/fsi_name']}",
          "WebhookApprovalCreationInput/assignedTo": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
          "WebhookApprovalCreationInput/details": "@{outputs('Build_Approval_Details')}",
          "WebhookApprovalCreationInput/itemLink": "@{concat(parameters('fsi_SDM_DataverseEnvironment'), '/main.aspx?pagetype=entityrecord&etn=fsi_expansionrequest&id=', outputs('Get_Request_Details')?['body/fsi_expansionrequestid'])}",
          "WebhookApprovalCreationInput/itemLinkDescription": "View Request in Dataverse"
        },
        "authentication": "@parameters('$authentication')",
        "limit": {
          "timeout": "P7D"
        }
      }
    },
    "Condition_Check_Approval_Outcome": {
      "runAfter": {
        "Start_Approval": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "equals": [
          "@outputs('Start_Approval')?['body/outcome']",
          "Approve"
        ]
      },
      "actions": {
        "Determine_Scope_Field_To_Update": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 1), 'fsi_allowedconnectors', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 2), 'fsi_allowedsites', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 3), 'fsi_allowedtables', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 4), 'fsi_allowedapis', 'fsi_accesslevel'))))"
        },
        "Condition_Is_Access_Level_Change": {
          "runAfter": {
            "Determine_Scope_Field_To_Update": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@outputs('Get_Request_Details')?['body/fsi_requesttype']",
              5
            ]
          },
          "actions": {
            "Find_Scope_Item_By_Resource": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_scopeitems",
                  "$filter": "_fsi_agentscopeid_value eq '@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_agentscopeid']}' and fsi_resourcename eq '@{replace(outputs('Get_Request_Details')?['body/fsi_resourcename'], '''', '''''')}'",
                  "$select": "fsi_scopeitemid,fsi_accesslevel",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT1H"
              }
            },
            "Condition_Scope_Item_Found": {
              "runAfter": {
                "Find_Scope_Item_By_Resource": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "greater": [
                  "@length(outputs('Find_Scope_Item_By_Resource')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Update_Scope_Item_Access_Level": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_scopeitems",
                      "recordId": "@first(outputs('Find_Scope_Item_By_Resource')?['body/value'])?['fsi_scopeitemid']",
                      "item": {
                        "fsi_accesslevel": "@outputs('Get_Request_Details')?['body/fsi_requestedaccesslevel']"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "minimumInterval": "PT10S",
                    "maximumInterval": "PT1H"
                  }
                },
                "Handle_Access_Level_Update_Failure": {
                  "runAfter": {
                    "Update_Scope_Item_Access_Level": [
                      "Failed"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_expansionrequests",
                      "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
                      "item": {
                        "fsi_status": 7,
                        "fsi_completedon": "@{utcNow()}"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "minimumInterval": "PT10S",
                    "maximumInterval": "PT1H"
                  }
                },
                "Terminate_On_Access_Level_Update_Failure": {
                  "runAfter": {
                    "Handle_Access_Level_Update_Failure": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "AccessLevelUpdateFailed",
                      "message": "Failed to update scope item access level after approval. The expansion request has been marked as failed (status 7)."
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Update_Request_Failed_No_Scope_Item": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "fsi_expansionrequests",
                        "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
                        "item": {
                          "fsi_status": 7,
                          "fsi_completedon": "@{utcNow()}"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT10S",
                      "minimumInterval": "PT10S",
                      "maximumInterval": "PT1H"
                    }
                  },
                  "Terminate_No_Scope_Item": {
                    "runAfter": {
                      "Update_Request_Failed_No_Scope_Item": [
                        "Succeeded",
                        "Failed"
                      ]
                    },
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "ScopeItemNotFound",
                        "message": "No scope item found matching the requested resource. The expansion request has been marked as failed."
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Get_Current_Allowed_List": {
                "runAfter": {},
                "type": "Compose",
                "inputs": "@if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedconnectors'), if(equals(coalesce(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedconnectors'], ''), ''), '[]', outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedconnectors']), if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedsites'), if(equals(coalesce(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedsites'], ''), ''), '[]', outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedsites']), if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedtables'), if(equals(coalesce(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedtables'], ''), ''), '[]', outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedtables']), if(equals(coalesce(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedapis'], ''), ''), '[]', outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_allowedapis']))))"
              },
              "Parse_Current_List": {
                "runAfter": {
                  "Get_Current_Allowed_List": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@outputs('Get_Current_Allowed_List')",
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "Append_New_Resource": {
                "runAfter": {
                  "Parse_Current_List": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": "@union(body('Parse_Current_List'), createArray(coalesce(outputs('Get_Request_Details')?['body/fsi_resourceurl'], outputs('Get_Request_Details')?['body/fsi_resourcename'])))"
              },
              "Update_Agent_Scope_Connectors": {
                "runAfter": {
                  "Append_New_Resource": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "fsi_agentscopes",
                    "recordId": "@outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_agentscopeid']",
                    "item": {
                      "@{outputs('Determine_Scope_Field_To_Update')}": "@{string(outputs('Append_New_Resource'))}"
                    }
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "minimumInterval": "PT10S",
                  "maximumInterval": "PT1H"
                }
              },
              "Handle_Scope_Update_Failure": {
                "runAfter": {
                  "Update_Agent_Scope_Connectors": [
                    "Failed",
                    "Skipped"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "fsi_expansionrequests",
                    "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
                    "item": {
                      "fsi_status": 7,
                      "fsi_completedon": "@{utcNow()}"
                    }
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "minimumInterval": "PT10S",
                  "maximumInterval": "PT1H"
                }
              },
              "Terminate_On_Scope_Update_Failure": {
                "runAfter": {
                  "Handle_Scope_Update_Failure": [
                    "Succeeded"
                  ]
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "ScopeUpdateFailed",
                    "message": "Failed to update agent scope after approval. The expansion request has been marked as failed (status 7)."
                  }
                }
              }
            }
          }
        },
        "Update_Request_Approved": {
          "runAfter": {
            "Condition_Is_Access_Level_Change": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_expansionrequests",
              "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
              "item": {
                "fsi_status": 4,
                "fsi_securityapproval": 2,
                "fsi_completedon": "@{utcNow()}"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT1H"
          }
        },
        "Condition_Has_Related_Violation": {
          "runAfter": {
            "Update_Request_Approved": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@outputs('Get_Request_Details')?['body/fsi_scopeviolationid/fsi_scopeviolationid']",
                null
              ]
            }
          },
          "actions": {
            "Close_Related_Violation": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_scopeviolations",
                  "recordId": "@outputs('Get_Request_Details')?['body/fsi_scopeviolationid/fsi_scopeviolationid']",
                  "item": {
                    "fsi_status": 4,
                    "fsi_resolutiontype": 1,
                    "fsi_resolvedon": "@{utcNow()}"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT1H"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Send_Approval_Notification": {
          "runAfter": {
            "Condition_Has_Related_Violation": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress']}",
                "Subject": "[Scope Expansion] APPROVED: @{outputs('Get_Request_Details')?['body/fsi_name']}",
                "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#107c10;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Scope Expansion Request Approved</div><p>Your scope expansion request has been approved.</p><table><tr><td><strong>Agent:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</td></tr><tr><td><strong>Request:</strong></td><td>@{outputs('Get_Request_Type_Label')}</td></tr><tr><td><strong>Resource:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_resourcename']}</td></tr><tr><td><strong>Approved By:</strong></td><td>@{coalesce(first(outputs('Start_Approval')?['body/responses'])?['responder/displayName'], 'Unknown')}</td></tr><tr><td><strong>Approved On:</strong></td><td>@{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC</td></tr></table><p>The agent scope has been automatically updated. No further action is required.</p></body></html>",
                "Importance": "Normal"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
