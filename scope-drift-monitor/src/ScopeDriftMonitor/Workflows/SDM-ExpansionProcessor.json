{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_expansion_request_created": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "fsi_expansionrequest",
          "subscriptionRequest/scope": 2
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Get_Request_Details": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_expansionrequests",
          "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
          "$expand": "fsi_agentscopeid($select=fsi_name,fsi_agentid,fsi_zone,fsi_allowedconnectors,fsi_allowedsites,fsi_allowedtables,fsi_allowedapis),fsi_requestedby($select=internalemailaddress,fullname),fsi_scopeviolationid($select=fsi_name,fsi_scopeviolationid)"
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      }
    },
    "Get_Request_Type_Label": {
      "runAfter": {
        "Get_Request_Details": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10001), 'Add Connector', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10002), 'Add SharePoint Site', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10003), 'Add Dataverse Table', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10004), 'Add External API', 'Increase Access Level'))))"
    },
    "Get_Zone_Label": {
      "runAfter": {
        "Get_Request_Type_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_zone'], 10001), 'Zone 1 - Personal', if(equals(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_zone'], 10002), 'Zone 2 - Team', if(equals(outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_zone'], 10003), 'Zone 3 - Enterprise', 'Unknown Zone')))"
    },
    "Build_Approval_Details": {
      "runAfter": {
        "Get_Zone_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "## Scope Expansion Request\n\n**Agent:** @{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}\n**Zone:** @{outputs('Get_Zone_Label')}\n**Request Type:** @{outputs('Get_Request_Type_Label')}\n\n---\n\n**Resource to Add:** @{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}\n**Resource URL:** @{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_resourceurl'], 'N/A'), '<', '&lt;'), '>', '&gt;')}\n\n**Justification:**\n@{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_justification'], ''), '<', '&lt;'), '>', '&gt;')}\n\n---\n\n**Requested By:** @{outputs('Get_Request_Details')?['body/fsi_requestedby/fullname']}\n**Requested On:** @{formatDateTime(outputs('Get_Request_Details')?['body/fsi_requestedon'], 'yyyy-MM-dd HH:mm')} UTC\n\n---\n\nPlease review and approve or reject this scope expansion request."
    },
    "Start_Approval": {
      "runAfter": {
        "Update_Request_Under_Review": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_approvals",
          "operationId": "StartAndWaitForAnApproval",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
        },
        "parameters": {
          "approvalType": "Basic",
          "WebhookApprovalCreationInput/title": "Scope Expansion: @{outputs('Get_Request_Details')?['body/fsi_name']}",
          "WebhookApprovalCreationInput/assignedTo": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
          "WebhookApprovalCreationInput/details": "@{outputs('Build_Approval_Details')}",
          "WebhookApprovalCreationInput/itemLink": "@{if(not(empty(parameters('fsi_SDM_DataverseEnvironment'))), concat(parameters('fsi_SDM_DataverseEnvironment'), '/main.aspx?pagetype=entityrecord&etn=fsi_expansionrequest&id=', outputs('Get_Request_Details')?['body/fsi_expansionrequestid']), '')}",
          "WebhookApprovalCreationInput/itemLinkDescription": "View Request in Dataverse"
        },
        "authentication": "@parameters('$authentication')",
        "limit": {
          "timeout": "P7D"
        }
      }
    },
    "Update_Request_Under_Review": {
      "runAfter": {
        "Build_Approval_Details": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "UpdateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_expansionrequests",
          "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
          "item": {
            "fsi_status": 10003
          }
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      }
    },
    "Condition_Check_Approval_Outcome": {
      "runAfter": {
        "Start_Approval": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "equals": [
          "@outputs('Start_Approval')?['body/outcome']",
          "Approve"
        ]
      },
      "actions": {
        "Determine_Scope_Field_To_Update": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10001), 'fsi_allowedconnectors', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10002), 'fsi_allowedsites', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10003), 'fsi_allowedtables', if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10004), 'fsi_allowedapis', 'fsi_accesslevel'))))"
        },
        "Condition_Is_List_Update": {
          "runAfter": {
            "Determine_Scope_Field_To_Update": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@outputs('Get_Request_Details')?['body/fsi_requesttype']",
                10005
              ]
            }
          },
          "actions": {
            "Get_Current_Allowed_List": {
              "runAfter": {
                "Re_Read_Scope_After_Approval": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedconnectors'), coalesce(outputs('Re_Read_Scope_After_Approval')?['body/fsi_allowedconnectors'], '[]'), if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedsites'), coalesce(outputs('Re_Read_Scope_After_Approval')?['body/fsi_allowedsites'], '[]'), if(equals(outputs('Determine_Scope_Field_To_Update'), 'fsi_allowedtables'), coalesce(outputs('Re_Read_Scope_After_Approval')?['body/fsi_allowedtables'], '[]'), coalesce(outputs('Re_Read_Scope_After_Approval')?['body/fsi_allowedapis'], '[]'))))"
            },
            "Re_Read_Scope_After_Approval": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "fsi_cr_dataverse",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_agentscopes",
                  "recordId": "@outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_agentscopeid']",
                  "$select": "fsi_allowedconnectors,fsi_allowedsites,fsi_allowedtables,fsi_allowedapis"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            },
            "Parse_Current_List": {
              "runAfter": {
                "Get_Current_Allowed_List": [
                  "Succeeded"
                ]
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@outputs('Get_Current_Allowed_List')",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "Append_New_Resource": {
              "runAfter": {
                "Parse_Current_List": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@union(body('Parse_Current_List'), createArray(coalesce(outputs('Get_Request_Details')?['body/fsi_resourceurl'], outputs('Get_Request_Details')?['body/fsi_resourcename'])))"
            },
            "Update_Agent_Scope_List": {
              "runAfter": {
                "Append_New_Resource": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "fsi_cr_dataverse",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_agentscopes",
                  "recordId": "@outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_agentscopeid']",
                  "item": {
                    "@{outputs('Determine_Scope_Field_To_Update')}": "@{string(outputs('Append_New_Resource'))}"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Update_Request_Approved": {
          "runAfter": {
            "Condition_Is_List_Update": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_dataverse",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_expansionrequests",
              "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
              "item": {
                "fsi_status": 10004,
                "fsi_securityapproval": 10002,
                "fsi_securityapprovedby@odata.bind": "/systemusers(@{first(outputs('Start_Approval')?['body/responses'])?['responder/id']})",
                "fsi_completedon": "@{utcNow()}"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        },
        "Handle_Scope_Update_Failure": {
          "runAfter": {
            "Condition_Is_List_Update": [
              "Failed"
            ]
          },
          "type": "Scope",
          "actions": {
            "Update_Request_Failed": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "fsi_cr_dataverse",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_expansionrequests",
                  "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
                  "item": {
                    "fsi_status": 10001
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            },
            "Send_Scope_Update_Failure_Notification": {
              "runAfter": {
                "Update_Request_Failed": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "fsi_cr_outlook",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage": {
                    "To": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
                    "Subject": "[Scope Expansion] ERROR: Scope update failed for @{outputs('Get_Request_Details')?['body/fsi_name']}",
                    "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#d13438;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Scope Update Failed</div><p>The expansion request was approved but the agent scope could not be updated in Dataverse. The request has been reset to Pending status.</p><table><tr><td><strong>Agent:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</td></tr><tr><td><strong>Request:</strong></td><td>@{outputs('Get_Request_Type_Label')}</td></tr><tr><td><strong>Resource:</strong></td><td>@{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}</td></tr></table><p>Please investigate and retry the scope update manually.</p></body></html>",
                    "Importance": "High"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          }
        },
        "Condition_Has_Related_Violation": {
          "runAfter": {
            "Update_Request_Approved": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@outputs('Get_Request_Details')?['body/fsi_scopeviolationid/fsi_scopeviolationid']",
                null
              ]
            }
          },
          "actions": {
            "Close_Related_Violation": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "fsi_cr_dataverse",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_scopeviolations",
                  "recordId": "@outputs('Get_Request_Details')?['body/fsi_scopeviolationid/fsi_scopeviolationid']",
                  "item": {
                    "fsi_status": 10004,
                    "fsi_resolutiontype": 10001,
                    "fsi_resolvedon": "@{utcNow()}"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Send_Approval_Notification": {
          "runAfter": {
            "Condition_Has_Related_Violation": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_outlook",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{if(empty(coalesce(outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress'], '')), parameters('fsi_SDM_SecurityTeamEmail'), outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress'])}",
                "Subject": "[Scope Expansion] APPROVED: @{outputs('Get_Request_Details')?['body/fsi_name']}",
                "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#107c10;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Scope Expansion Request Approved</div><p>Your scope expansion request has been approved.</p><table><tr><td><strong>Agent:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</td></tr><tr><td><strong>Request:</strong></td><td>@{outputs('Get_Request_Type_Label')}</td></tr><tr><td><strong>Resource:</strong></td><td>@{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td><strong>Approved By:</strong></td><td>@{first(outputs('Start_Approval')?['body/responses'])?['responder/displayName']}</td></tr><tr><td><strong>Approved On:</strong></td><td>@{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC</td></tr></table><p>@{if(equals(outputs('Get_Request_Details')?['body/fsi_requesttype'], 10005), 'Access level changes require manual configuration by an administrator. Please contact the security team.', 'The agent scope has been automatically updated. No further action is required.')}</p></body></html>",
                "Importance": "Normal"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        },
        "Handle_Request_Approved_Failure": {
          "runAfter": {
            "Update_Request_Approved": [
              "Failed"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_outlook",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
                "Subject": "[Scope Expansion] ERROR: Failed to update approved request @{outputs('Get_Request_Details')?['body/fsi_name']}",
                "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#d13438;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Request Status Update Failed</div><p>The scope expansion was approved and the agent scope was successfully updated, but the request record could not be updated to Approved status. The record remains in Under Review status and requires manual correction.</p><p><strong>Request ID:</strong> @{triggerOutputs()?['body/fsi_expansionrequestid']}</p><p><strong>Agent:</strong> @{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</p><p><strong>Request Type:</strong> @{outputs('Get_Request_Type_Label')}</p></body></html>",
                "Importance": "High"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        }
      },
      "else": {
        "actions": {
          "Update_Request_Denied": {
            "runAfter": {},
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "fsi_cr_dataverse",
                "operationId": "UpdateRecord",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "fsi_expansionrequests",
                "recordId": "@triggerOutputs()?['body/fsi_expansionrequestid']",
                "item": {
                  "fsi_status": 10005,
                  "fsi_securityapproval": 10003,
                  "fsi_securityapprovedby@odata.bind": "/systemusers(@{first(outputs('Start_Approval')?['body/responses'])?['responder/id']})",
                  "fsi_completedon": "@{utcNow()}"
                }
              },
              "authentication": "@parameters('$authentication')",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "maximumInterval": "PT1M"
              }
            }
          },
          "Send_Denial_Notification": {
            "runAfter": {
              "Update_Request_Denied": [
                "Succeeded",
                "Failed"
              ]
            },
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "fsi_cr_outlook",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage": {
                  "To": "@{if(empty(coalesce(outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress'], '')), parameters('fsi_SDM_SecurityTeamEmail'), outputs('Get_Request_Details')?['body/fsi_requestedby/internalemailaddress'])}",
                  "Subject": "[Scope Expansion] DENIED: @{outputs('Get_Request_Details')?['body/fsi_name']}",
                  "Body": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.header{background-color:#d13438;color:white;padding:15px;font-size:18px;font-weight:bold;}</style></head><body><div class=\"header\">Scope Expansion Request Denied</div><p>Your scope expansion request has been denied.</p><table><tr><td><strong>Agent:</strong></td><td>@{outputs('Get_Request_Details')?['body/fsi_agentscopeid/fsi_name']}</td></tr><tr><td><strong>Request:</strong></td><td>@{outputs('Get_Request_Type_Label')}</td></tr><tr><td><strong>Resource:</strong></td><td>@{replace(replace(coalesce(outputs('Get_Request_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td><strong>Denied By:</strong></td><td>@{first(outputs('Start_Approval')?['body/responses'])?['responder/displayName']}</td></tr></table><p><strong>Comments:</strong></p><p>@{replace(replace(coalesce(first(outputs('Start_Approval')?['body/responses'])?['comments'], 'No comments provided.'), '<', '&lt;'), '>', '&gt;')}</p><p>If you believe this decision was made in error, please contact the security team or submit a new request with additional justification.</p></body></html>",
                  "Importance": "Normal"
                }
              },
              "authentication": "@parameters('$authentication')",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "maximumInterval": "PT1M"
              }
            }
          },
          "Handle_Denial_Update_Failure": {
            "runAfter": {
              "Update_Request_Denied": [
                "Failed"
              ]
            },
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "fsi_cr_outlook",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage": {
                  "To": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
                  "Subject": "[Scope Expansion] ERROR: Failed to update denied request @{outputs('Get_Request_Details')?['body/fsi_name']}",
