{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_row_is_added": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "fsi_scopeviolation",
          "subscriptionRequest/scope": 2
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Get_Violation_Details": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_scopeviolations",
          "recordId": "@triggerOutputs()?['body/fsi_scopeviolationid']",
          "$expand": "fsi_agentscopeid($select=fsi_name,fsi_agentid,fsi_zone;$expand=fsi_owner($select=internalemailaddress,fullname))"
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      }
    },
    "Get_Severity_Label": {
      "runAfter": {
        "Get_Violation_Details": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Violation_Details')?['body/fsi_severity'], 10001), 'Critical', if(equals(outputs('Get_Violation_Details')?['body/fsi_severity'], 10002), 'High', if(equals(outputs('Get_Violation_Details')?['body/fsi_severity'], 10003), 'Medium', 'Low')))"
    },
    "Get_Violation_Type_Label": {
      "runAfter": {
        "Get_Severity_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Violation_Details')?['body/fsi_violationtype'], 10001), 'Unauthorized Connector', if(equals(outputs('Get_Violation_Details')?['body/fsi_violationtype'], 10002), 'Unauthorized SharePoint Site', if(equals(outputs('Get_Violation_Details')?['body/fsi_violationtype'], 10003), 'Unauthorized Dataverse Table', if(equals(outputs('Get_Violation_Details')?['body/fsi_violationtype'], 10004), 'Unauthorized External API', if(equals(outputs('Get_Violation_Details')?['body/fsi_violationtype'], 10005), 'Expired Scope Item', 'No Baseline Defined')))))"
    },
    "Get_Zone_Label": {
      "runAfter": {
        "Get_Violation_Type_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(equals(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_zone'], 10001), 'Zone 1 - Personal', if(equals(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_zone'], 10002), 'Zone 2 - Team', if(equals(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_zone'], 10003), 'Zone 3 - Enterprise', 'Unknown Zone')))"
    },
    "Build_Adaptive_Card": {
      "runAfter": {
        "Get_Zone_Label": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.5",
        "body": [
          {
            "type": "Container",
            "style": "attention",
            "items": [
              {
                "type": "TextBlock",
                "text": "Scope Drift Violation Detected",
                "weight": "Bolder",
                "size": "Large",
                "color": "Attention"
              }
            ]
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "Agent:",
                "value": "@{coalesce(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_name'], 'Unknown Agent')}"
              },
              {
                "title": "Violation Type:",
                "value": "@{outputs('Get_Violation_Type_Label')}"
              },
              {
                "title": "Resource:",
                "value": "@{replace(replace(coalesce(outputs('Get_Violation_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}"
              },
              {
                "title": "Severity:",
                "value": "@{outputs('Get_Severity_Label')}"
              },
              {
                "title": "Zone:",
                "value": "@{outputs('Get_Zone_Label')}"
              },
              {
                "title": "Detected:",
                "value": "@{formatDateTime(outputs('Get_Violation_Details')?['body/fsi_detectedon'], 'yyyy-MM-dd HH:mm:ss')} UTC"
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "The agent accessed a resource not included in its declared scope. Please review and take appropriate action.",
            "wrap": true,
            "spacing": "Medium"
          }
        ],
        "actions": [
          {
            "type": "Action.OpenUrl",
            "title": "View Violation",
            "url": "@{concat(parameters('fsi_SDM_DataverseEnvironment'), '/main.aspx?pagetype=entityrecord&etn=fsi_scopeviolation&id=', outputs('Get_Violation_Details')?['body/fsi_scopeviolationid'])}"
          },
          {
            "type": "Action.OpenUrl",
            "title": "View Agent Scope",
            "url": "@{concat(parameters('fsi_SDM_DataverseEnvironment'), '/main.aspx?pagetype=entityrecord&etn=fsi_agentscope&id=', outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_agentscopeid'])}"
          }
        ]
      }
    },
    "Post_Teams_Adaptive_Card": {
      "runAfter": {
        "Build_Adaptive_Card": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_teams",
          "operationId": "PostCardToChannel",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
        },
        "parameters": {
          "poster": "Flow bot",
          "location": "Channel",
          "groupId": "@{parameters('fsi_SDM_TeamsGroupId')}",
          "channelId": "@{parameters('fsi_SDM_TeamsChannelId')}",
          "card": "@outputs('Build_Adaptive_Card')"
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      }
    },
    "Build_Email_Body": {
      "runAfter": {
        "Post_Teams_Adaptive_Card": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "Compose",
      "inputs": "<html><head><style>body{font-family:Segoe UI,Arial,sans-serif;}.alert-header{background-color:#d13438;color:white;padding:15px;font-size:18px;font-weight:bold;}.details-table{width:100%;border-collapse:collapse;margin-top:20px;}.details-table td{padding:10px;border:1px solid #ddd;}.details-table tr:nth-child(odd){background-color:#f9f9f9;}.label{font-weight:bold;width:150px;}.severity-critical{color:#8b0000;font-weight:bold;}.severity-high{color:#d13438;font-weight:bold;}.severity-medium{color:#ff8c00;font-weight:bold;}.severity-low{color:#107c10;font-weight:bold;}</style></head><body><div class=\"alert-header\">Scope Drift Violation Detected</div><table class=\"details-table\"><tr><td class=\"label\">Agent</td><td>@{coalesce(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_name'], 'Unknown Agent')}</td></tr><tr><td class=\"label\">Violation Type</td><td>@{outputs('Get_Violation_Type_Label')}</td></tr><tr><td class=\"label\">Resource</td><td>@{replace(replace(coalesce(outputs('Get_Violation_Details')?['body/fsi_resourcename'], ''), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td class=\"label\">Resource URL</td><td>@{replace(replace(coalesce(outputs('Get_Violation_Details')?['body/fsi_resourceurl'], 'N/A'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td class=\"label\">Severity</td><td class=\"severity-@{toLower(outputs('Get_Severity_Label'))}\">@{outputs('Get_Severity_Label')}</td></tr><tr><td class=\"label\">Zone</td><td>@{outputs('Get_Zone_Label')}</td></tr><tr><td class=\"label\">Detected On</td><td>@{formatDateTime(outputs('Get_Violation_Details')?['body/fsi_detectedon'], 'MMMM dd, yyyy HH:mm:ss')} UTC</td></tr><tr><td class=\"label\">Audit Record ID</td><td>@{coalesce(outputs('Get_Violation_Details')?['body/fsi_auditrecordid'], 'N/A')}</td></tr></table><p style=\"margin-top:20px;\"><strong>Action Required:</strong> Please review this violation and determine the appropriate resolution:</p><ul><li>If this access is legitimate, create a scope expansion request</li><li>If this is a security concern, investigate and remediate the agent</li><li>If this is a false positive, close the violation with appropriate documentation</li></ul><p><a href=\"@{concat(parameters('fsi_SDM_DataverseEnvironment'), '/main.aspx?pagetype=entityrecord&etn=fsi_scopeviolation&id=', outputs('Get_Violation_Details')?['body/fsi_scopeviolationid'])}\">View Violation in Dataverse</a></p></body></html>"
    },
    "Determine_Email_Recipients": {
      "runAfter": {
        "Build_Email_Body": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(empty(coalesce(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_owner/internalemailaddress'], '')), parameters('fsi_SDM_SecurityTeamEmail'), concat(outputs('Get_Violation_Details')?['body/fsi_agentscopeid/fsi_owner/internalemailaddress'], ';', parameters('fsi_SDM_SecurityTeamEmail')))"
    },
    "Send_Email_Notification": {
      "runAfter": {
        "Determine_Email_Recipients": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_outlook",
          "operationId": "SendEmailV2",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "emailMessage": {
            "To": "@{outputs('Determine_Email_Recipients')}",
            "Subject": "[Scope Drift] @{outputs('Get_Severity_Label')} - @{outputs('Get_Violation_Type_Label')}: @{outputs('Get_Violation_Details')?['body/fsi_resourcename']}",
            "Body": "@{outputs('Build_Email_Body')}",
            "Importance": "@{if(or(equals(outputs('Get_Violation_Details')?['body/fsi_severity'], 10001), equals(outputs('Get_Violation_Details')?['body/fsi_severity'], 10002)), 'High', 'Normal')}"
          }
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      }
    },
    "Update_Violation_Status": {
      "runAfter": {
        "Send_Email_Notification": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "UpdateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_scopeviolations",
          "recordId": "@triggerOutputs()?['body/fsi_scopeviolationid']",
          "item": {
            "fsi_status": "@if(and(equals(actions('Post_Teams_Adaptive_Card')?['status'], 'Failed'), equals(actions('Send_Email_Notification')?['status'], 'Failed')), 10001, 10002)"
          }
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Handle_Violation_Details_Failure": {
      "runAfter": {
        "Get_Violation_Details": [
          "Failed"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_outlook",
          "operationId": "SendEmailV2",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "emailMessage": {
            "To": "@{parameters('fsi_SDM_SecurityTeamEmail')}",
            "Subject": "[Scope Drift] ERROR: Failed to retrieve violation details",
            "Body": "<html><body><p>The SDM-AlertDispatcher flow failed to retrieve violation details after retry exhaustion.</p><p><strong>Violation ID:</strong> @{triggerOutputs()?['body/fsi_scopeviolationid']}</p><p>Please investigate manually in Dataverse.</p></body></html>",
            "Importance": "High"
          }
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "outputs": {},
  "description": "SDM-AlertDispatcher: Triggered when a scope violation is created, sends Teams Adaptive Card and email notifications to agent owner and security team"
}
