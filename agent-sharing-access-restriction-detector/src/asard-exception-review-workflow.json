{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "connectionName": "shared_commondataserviceforapps",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "connectionReferenceLogicalName": "fsi_cr_dataverse_asard",
        "tier": "NotSpecified"
      },
      "shared_teams": {
        "connectionName": "shared_teams",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
        "connectionReferenceLogicalName": "fsi_cr_teams_asard",
        "tier": "NotSpecified"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "fsi_ASARD_TeamsChannelId": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "fsi_ASARD_TeamsChannelId",
            "description": "Microsoft Teams channel ID for exception review notifications"
          }
        },
        "fsi_ASARD_AdaptiveCardTemplateUrl": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "fsi_ASARD_AdaptiveCardTemplateUrl",
            "description": "Base URL for adaptive card template hosting (e.g., GitHub raw content or Azure Blob Storage)"
          }
        },
        "fsi_ASARD_PlaybookUrl": {
          "defaultValue": "https://judeper.github.io/FSI-AgentGov/playbooks/asard-exception-management/",
          "type": "String",
          "metadata": {
            "schemaName": "fsi_ASARD_PlaybookUrl",
            "description": "URL to the ASARD exception management playbook for adaptive card links"
          }
        }
      },
      "triggers": {
        "Recurrence_Daily_08AM_UTC": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "8"
              ],
              "minutes": [
                0
              ]
            },
            "timeZone": "UTC"
          },
          "description": "Daily scheduled trigger at 08:00 UTC to review exception expiration dates"
        }
      },
      "actions": {
        "Initialize_Today": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Today",
                "type": "string",
                "value": "@{utcNow()}"
              }
            ]
          },
          "runAfter": {},
          "description": "Capture current UTC date for expiration queries"
        },
        "Initialize_ExpiringThreshold": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ExpiringThreshold",
                "type": "string",
                "value": "@{addDays(utcNow(), 14)}"
              }
            ]
          },
          "runAfter": {
            "Initialize_Today": [
              "Succeeded"
            ]
          },
          "description": "Calculate expiring threshold: 14 days from now"
        },
        "Scope_Main": {
          "type": "Scope",
          "actions": {
            "Query_Expiring_Exceptions": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_agentsharingcompliances",
                      "$select": "fsi_agent_name,fsi_environment_name,fsi_exception_expires_at,fsi_exception_approved_by,fsi_exception_justification",
                      "$filter": "fsi_compliance_status eq 914430002 and fsi_exception_expires_at ge @{variables('Today')} and fsi_exception_expires_at le @{variables('ExpiringThreshold')}",
                      "$orderby": "fsi_exception_expires_at asc"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 100000
                    }
                  },
                  "description": "Query for exceptions expiring within 14 days. Uses runtime pagination policy for automatic @odata.nextLink continuation beyond 5000 records."
                },
                "Condition_Check_Expiring_Exceptions_Exist": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(outputs('Query_Expiring_Exceptions')?['body/value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "Query_Expiring_Exceptions": [
                      "Succeeded"
                    ]
                  },
                  "actions": {
                    "Build_Expiring_List": {
                      "type": "Select",
                      "inputs": {
                        "from": "@outputs('Query_Expiring_Exceptions')?['body/value']",
                        "select": "@{concat('Agent: ', coalesce(item()?['fsi_agent_name'], 'N/A'), ' | Environment: ', coalesce(item()?['fsi_environment_name'], 'N/A'), ' | Expires: ', coalesce(item()?['fsi_exception_expires_at'], 'N/A'), ' | Days Remaining: ', string(div(sub(ticks(item()?['fsi_exception_expires_at']), ticks(utcNow())), 864000000000)), ' | Approved By: ', coalesce(item()?['fsi_exception_approved_by'], 'N/A'), ' | Justification: ', if(greater(length(coalesce(item()?['fsi_exception_justification'], '')), 100), concat(substring(coalesce(item()?['fsi_exception_justification'], ''), 0, 97), '...'), coalesce(item()?['fsi_exception_justification'], 'N/A')))}"
                      },
                      "description": "Transform records to formatted strings with null-safe coalesce() field access"
                    },
                    "Post_Expiring_Notification": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_teams",
                          "operationId": "PostCardToChannelV3",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                        },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "@parameters('fsi_ASARD_TeamsChannelId')",
                          "body/messageBody": "@{outputs('Build_Expiring_Adaptive_Card')}",
                          "body/messageTitle": "⚠️ Agent Sharing Exceptions Expiring Soon"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Build_Expiring_Adaptive_Card": [
                          "Succeeded"
                        ]
                      },
                      "description": "Post adaptive card to Teams governance channel with expiring exceptions list"
                    },
                    "Build_Expiring_Adaptive_Card": {
                      "type": "Compose",
                      "inputs": "@json(replace(replace(replace(replace(replace(string(body('Load_Expiring_Card_Template')), '{{exception_count}}', string(length(outputs('Query_Expiring_Exceptions')?['body/value']))), '{{exception_list}}', join(body('Build_Expiring_List'), '\\n')), '{{review_date}}', formatDateTime(utcNow(), 'yyyy-MM-dd')), '{{timestamp}}', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')), '{{playbook_url}}', parameters('fsi_ASARD_PlaybookUrl')))",
                      "runAfter": {
                        "Load_Expiring_Card_Template": [
                          "Succeeded"
                        ]
                      },
                      "description": "Populate adaptive card template with expiring exception data including playbook URL"
                    },
                    "Load_Expiring_Card_Template": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@{parameters('fsi_ASARD_AdaptiveCardTemplateUrl')}/adaptive-card-asard-exception-expiring.json",
                        "headers": {},
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 3,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {
                        "Build_Expiring_List": [
                          "Succeeded"
                        ]
                      },
                      "description": "Load adaptive card template with exponential retry policy for transient failures."
                    }
                  }
                },
                "Query_Expired_Exceptions": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_agentsharingcompliances",
                      "$select": "fsi_agentsharingcomplianceid,fsi_agent_name,fsi_environment_name,fsi_exception_expires_at,fsi_exception_justification",
                      "$filter": "fsi_compliance_status eq 914430002 and fsi_exception_expires_at lt @{variables('Today')}",
                      "$orderby": "fsi_exception_expires_at desc"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 100000
                    }
                  },
                  "description": "Query for expired exceptions (expires_at < today). Uses runtime pagination policy for automatic @odata.nextLink continuation beyond 5000 records."
                },
                "Condition_Check_Expired_Exceptions_Exist": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(outputs('Query_Expired_Exceptions')?['body/value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "Query_Expired_Exceptions": [
                      "Succeeded"
                    ]
                  },
                  "actions": {
                    "Apply_To_Each_Expired_Exception": {
                      "type": "Foreach",
                      "foreach": "@outputs('Query_Expired_Exceptions')?['body/value']",
                      "actions": {
                        "Scope_Update_Exception": {
                          "type": "Scope",
                          "actions": {
                            "Update_Expired_Exception_To_NonCompliant": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "UpdateRecord",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "fsi_agentsharingcompliances",
                                  "recordId": "@item()?['fsi_agentsharingcomplianceid']",
                                  "item/fsi_compliance_status": 914430001,
                                  "item/fsi_exception_expires_at": null,
                                  "item/fsi_exception_justification": null,
                                  "item/fsi_exception_approved_by": null,
                                  "item/fsi_exception_approved_at": null,
                                  "item/fsi_exception_review_date": null
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "description": "Reset compliance_status to NonCompliant (914430001) and clear all exception fields"
                            }
                          },
                          "runAfter": {},
                          "description": "Scope wrapping Dataverse update to enable error handling per iteration"
                        },
                        "Scope_Handle_Update_Error": {
                          "type": "Scope",
                          "actions": {
                            "Post_Update_Error_Notification": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_teams",
                                  "operationId": "PostCardToChannelV3",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                                },
                                "parameters": {
                                  "poster": "Flow bot",
                                  "location": "@parameters('fsi_ASARD_TeamsChannelId')",
                                  "body/messageBody": "⚠️ Failed to update expired exception record @{item()?['fsi_agentsharingcomplianceid']} for agent @{item()?['fsi_agent_name']}. Review flow run history for details.",
                                  "body/messageTitle": "⚠️ Exception Review — Update Failed"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "description": "Notify governance channel of Dataverse update failure for this record"
                            }
                          },
                          "runAfter": {
                            "Scope_Update_Exception": [
                              "Failed",
                              "TimedOut"
                            ]
                          },
                          "description": "Error handler for Dataverse update failures — posts notification and continues to next record"
                        }
                      },
                      "description": "Iterate over expired exceptions and update each record with error handling per iteration"
                    },
                    "Build_Expired_List": {
                      "type": "Select",
                      "inputs": {
                        "from": "@outputs('Query_Expired_Exceptions')?['body/value']",
                        "select": "@{concat('Agent: ', coalesce(item()?['fsi_agent_name'], 'N/A'), ' | Environment: ', coalesce(item()?['fsi_environment_name'], 'N/A'), ' | Expired: ', formatDateTime(item()?['fsi_exception_expires_at'], 'yyyy-MM-dd'), ' | Previous Justification: ', if(greater(length(coalesce(item()?['fsi_exception_justification'], '')), 100), concat(substring(coalesce(item()?['fsi_exception_justification'], ''), 0, 97), '...'), coalesce(item()?['fsi_exception_justification'], 'N/A')))}"
                      },
                      "runAfter": {
                        "Apply_To_Each_Expired_Exception": [
                          "Succeeded"
                        ]
                      },
                      "description": "Transform expired records to formatted strings with null-safe coalesce() field access"
                    },
                    "Post_Expired_Notification": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_teams",
                          "operationId": "PostCardToChannelV3",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                        },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "@parameters('fsi_ASARD_TeamsChannelId')",
                          "body/messageBody": "@{outputs('Build_Expired_Adaptive_Card')}",
                          "body/messageTitle": "🔴 Agent Sharing Exceptions Expired"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Build_Expired_Adaptive_Card": [
                          "Succeeded"
                        ]
                      },
                      "description": "Post adaptive card to Teams with expired exceptions and auto-remediation notice"
                    },
                    "Build_Expired_Adaptive_Card": {
                      "type": "Compose",
                      "inputs": "@json(replace(replace(replace(replace(replace(string(body('Load_Expired_Card_Template')), '{{exception_count}}', string(length(outputs('Query_Expired_Exceptions')?['body/value']))), '{{exception_list}}', join(body('Build_Expired_List'), '\\n')), '{{reset_date}}', formatDateTime(utcNow(), 'yyyy-MM-dd')), '{{timestamp}}', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss')), '{{playbook_url}}', parameters('fsi_ASARD_PlaybookUrl')))",
                      "runAfter": {
                        "Load_Expired_Card_Template": [
                          "Succeeded"
                        ]
                      },
                      "description": "Populate adaptive card template with expired exception data including playbook URL"
                    },
                    "Load_Expired_Card_Template": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@{parameters('fsi_ASARD_AdaptiveCardTemplateUrl')}/adaptive-card-asard-exception-expired.json",
                        "headers": {},
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 3,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {
                        "Build_Expired_List": [
                          "Succeeded"
                        ]
                      },
                      "description": "Load adaptive card template with exponential retry policy for transient failures."
                    }
                  }
                }
          },
          "runAfter": {
            "Initialize_ExpiringThreshold": [
              "Succeeded"
            ]
          },
          "description": "Main execution scope wrapping parallel exception processing for error handling"
        },
        "Scope_Error_Handler": {
          "type": "Scope",
          "actions": {
            "Post_Flow_Error_Notification": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_teams",
                  "operationId": "PostCardToChannelV3",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "@parameters('fsi_ASARD_TeamsChannelId')",
                  "body/messageBody": "ASARD Exception Review workflow failed. Check flow run history for details.\n\nFlow: ASARD Exception Review Workflow\nTimestamp: @{utcNow()}",
                  "body/messageTitle": "ASARD Exception Review — Flow Error"
                },
                "authentication": "@parameters('$authentication')"
              },
              "description": "Post error notification to Teams governance channel when exception review fails"
            }
          },
          "runAfter": {
            "Scope_Main": [
              "Failed",
              "TimedOut"
            ]
          },
          "description": "Error handler for exception review flow failures — posts notification to governance channel"
        }
      }
    },
    "templateName": "asard-exception-review-workflow"
  },
  "_metadata": {
    "workflowName": "ASARD Exception Review Workflow",
    "workflowVersion": "1.0.0",
    "solution": "Agent Sharing Access Restriction Detector (ASARD)",
    "description": "Daily scheduled workflow to review agent sharing exceptions. Sends Teams notifications for expiring exceptions (within 14 days) and auto-resets expired exceptions to NonCompliant status.",
    "trigger": "Recurrence (daily at 08:00 UTC)",
    "actions": [
      "Query Dataverse for expiring exceptions (expires_at <= today+14)",
      "Send Teams notification with expiring exception list",
      "Query Dataverse for expired exceptions (expires_at < today)",
      "Update expired records: Set compliance_status=914430001 (NonCompliant), clear exception fields",
      "Send Teams notification with expired exception list"
    ],
    "optionSetMappings": {
      "fsi_compliance_status": {
        "914430000": "Compliant",
        "914430001": "NonCompliant",
        "914430002": "Exception",
        "914430003": "Error"
      }
    },
    "deploymentInstructions": [
      "Import flow into target environment via Power Automate portal or ALM pipelines",
      "Configure connection references: Dataverse (shared_commondataserviceforapps), Teams (shared_teams)",
      "Set environment variable fsi_ASARD_TeamsChannelId with governance leads channel ID",
      "Set environment variable fsi_ASARD_AdaptiveCardTemplateUrl with adaptive card template hosting URL (e.g., GitHub raw content or Azure Blob Storage)",
      "Set environment variable fsi_ASARD_PlaybookUrl with exception management playbook URL (default provided)",
      "Enable flow and verify daily schedule (08:00 UTC)",
      "Test manually via 'Run' button in Power Automate portal"
    ],
    "dependencies": [
      "fsi_agentsharingcompliances table with exception columns",
      "adaptive-card-asard-exception-expiring.json template",
      "adaptive-card-asard-exception-expired.json template",
      "Teams channel for governance notifications"
    ]
  }
}
