{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": ["7"],
          "minutes": [0]
        },
        "timeZone": "UTC"
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Initialize_DataverseUrl": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DataverseUrl",
            "type": "string",
            "value": "https://governance.crm.dynamics.com"
          }
        ]
      },
      "description": "Central Dataverse organization URL for validation history storage"
    },
    "Initialize_TenantId": {
      "runAfter": {
        "Initialize_DataverseUrl": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TenantId",
            "type": "string",
            "value": "contoso.onmicrosoft.com"
          }
        ]
      },
      "description": "Azure AD tenant ID"
    },
    "Initialize_ClientId": {
      "runAfter": {
        "Initialize_TenantId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ClientId",
            "type": "string",
            "value": "your-client-id-here"
          }
        ]
      },
      "description": "Azure AD application client ID"
    },
    "Initialize_CertificateThumbprint": {
      "runAfter": {
        "Initialize_ClientId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CertificateThumbprint",
            "type": "string",
            "value": "your-certificate-thumbprint-here"
          }
        ]
      },
      "description": "Certificate thumbprint for service principal authentication"
    },
    "Initialize_SubscriptionId": {
      "runAfter": {
        "Initialize_CertificateThumbprint": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SubscriptionId",
            "type": "string",
            "value": "your-subscription-id-here"
          }
        ]
      },
      "description": "Azure subscription ID containing Automation Account"
    },
    "Initialize_ResourceGroup": {
      "runAfter": {
        "Initialize_SubscriptionId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ResourceGroup",
            "type": "string",
            "value": "rg-audit-validation"
          }
        ]
      },
      "description": "Azure resource group containing Automation Account"
    },
    "Initialize_AutomationAccount": {
      "runAfter": {
        "Initialize_ResourceGroup": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "AutomationAccount",
            "type": "string",
            "value": "aa-audit-validator"
          }
        ]
      },
      "description": "Azure Automation Account name"
    },
    "Initialize_TeamsChannelId": {
      "runAfter": {
        "Initialize_AutomationAccount": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsChannelId",
            "type": "string",
            "value": "your-teams-channel-id-here"
          }
        ]
      },
      "description": "Teams channel ID for alert notifications"
    },
    "Initialize_TeamsTeamId": {
      "runAfter": {
        "Initialize_TeamsChannelId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsTeamId",
            "type": "string",
            "value": "your-teams-team-id-here"
          }
        ]
      },
      "description": "Teams team (group) ID for alert notifications"
    },
    "Initialize_ComplianceDistributionList": {
      "runAfter": {
        "Initialize_TeamsTeamId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ComplianceDistributionList",
            "type": "string",
            "value": "compliance-alerts@example.com"
          }
        ]
      },
      "description": "Email distribution list for compliance alerts"
    },
    "Scope_Try": {
      "actions": {
        "Create_Automation_Job": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "put",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs",
            "queries": {
              "runbookName": "Start-EnvironmentValidationRunbook",
              "wait": false,
              "x-ms-api-version": "2015-10-31"
            },
            "body": {
              "properties": {
                "parameters": {
                  "TenantId": "@{variables('TenantId')}",
                  "DataverseUrl": "@{variables('DataverseUrl')}",
                  "ClientId": "@{variables('ClientId')}",
                  "CertificateThumbprint": "@{variables('CertificateThumbprint')}"
                }
              }
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT1M"
          },
          "description": "Start Azure Automation runbook for environment validation"
        },
        "Wait_For_Job": {
          "runAfter": {
            "Create_Automation_Job": ["Succeeded"]
          },
          "type": "Until",
          "expression": "@or(equals(body('Get_Job_Status')?['properties']?['status'], 'Completed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Failed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Stopped'), equals(body('Get_Job_Status')?['properties']?['status'], 'Suspended'))",
          "limit": {
            "count": 240,
            "timeout": "PT2H"
          },
          "actions": {
            "Get_Job_Status": {
              "runAfter": {
                "Delay": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureautomation']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}",
                "queries": {
                  "x-ms-api-version": "2015-10-31"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT1M"
              },
              "description": "Check runbook job status"
            },
            "Delay": {
              "runAfter": {},
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 30,
                  "unit": "Second"
                }
              },
              "description": "Wait 30 seconds before checking job status"
            }
          },
          "description": "Wait until runbook job completes or fails (max 2 hours)"
        },
        "Check_Job_Failed": {
          "runAfter": {
            "Wait_For_Job": ["Succeeded"]
          },
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Failed"
                ]
              },
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Stopped"
                ]
              },
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Suspended"
                ]
              }
            ]
          },
          "actions": {
            "Send_Job_Failure_Email": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[CRITICAL] Environment Audit Validation Job Failed",
                  "Body": "<p><strong>Azure Automation job failed</strong></p><p>Runbook: Start-EnvironmentValidationRunbook<br>Status: @{body('Get_Job_Status')?['properties']?['status']}<br>Job ID: @{body('Create_Automation_Job')?['properties']?['jobId']}</p><p>Review job output in Azure Portal.</p>",
                  "Importance": "High"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT1M"
              },
              "description": "Send email notification on job failure"
            },
            "Terminate_Failed": {
              "runAfter": {
                "Send_Job_Failure_Email": ["Succeeded"]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "message": "Azure Automation job failed: @{body('Get_Job_Status')?['properties']?['status']}"
                }
              }
            }
          },
          "description": "Handle job failure - send alert and terminate"
        },
        "Get_Job_Output": {
          "runAfter": {
            "Check_Job_Failed": ["Succeeded"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "get",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}/output",
            "queries": {
              "x-ms-api-version": "2015-10-31"
            }
          },
          "description": "Retrieve runbook job output (JSON string)",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT1M"
          }
        },
        "Parse_Results": {
          "runAfter": {
            "Get_Job_Output": ["Succeeded"]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Job_Output')",
            "schema": {
              "type": "object",
              "properties": {
                "RunType": { "type": "string" },
                "RunId": { "type": "string" },
                "Timestamp": { "type": "string" },
                "TotalEnvironments": { "type": "integer" },
                "OverallStatus": { "type": "string" },
                "PerEnvironmentResults": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "EnvironmentId": { "type": "string" },
                      "EnvironmentName": { "type": "string" },
                      "Zone": { "type": "string" },
                      "AuditStatus": { "type": "string" },
                      "RetentionStatus": { "type": "string" },
                      "OverallStatus": { "type": "string" },
                      "Reason": { "type": "string" },
                      "Drift": {
                        "type": "object",
                        "properties": {
                          "DriftDetected": { "type": "boolean" },
                          "BaselineStatus": { "type": "string" },
                          "CurrentStatus": { "type": "string" },
                          "BaselineDate": { "type": "string" }
                        }
                      },
                      "AlertRequired": { "type": "boolean" }
                    }
                  }
                },
                "AlertsRequired": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "NewEnvironments": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "SkippedUnclassified": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "SkippedTrialDev": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "description": "Parse JSON output from runbook"
        },
        "Apply_To_Each_Alert": {
          "runAfter": {
            "Parse_Results": ["Succeeded"]
          },
          "type": "Foreach",
          "foreach": "@body('Parse_Results')?['AlertsRequired']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Check_Severity_For_Teams": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@items('Apply_To_Each_Alert')?['OverallStatus']",
                      "Failed"
                    ]
                  },
                  {
                    "equals": [
                      "@items('Apply_To_Each_Alert')?['OverallStatus']",
                      "Error"
                    ]
                  }
                ]
              },
              "actions": {
                "Post_Teams_Card": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['teams']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v1.0/teams/@{variables('TeamsTeamId')}/channels/@{variables('TeamsChannelId')}/messages",
                    "body": {
                      "rootMessage": {
                        "body": {
                          "contentType": "html",
                          "content": "<attachment id=\"adaptive-card\"></attachment>"
                        },
                        "attachments": [
                          {
                            "contentType": "application/vnd.microsoft.card.adaptive",
                            "content": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace('{\"type\":\"AdaptiveCard\",\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"attention\",\"items\":[{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"[ALERT] Audit Configuration Drift -- Environment\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"color\":\"Attention\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"${overallStatus}\",\"weight\":\"Bolder\",\"horizontalAlignment\":\"Right\",\"color\":\"Attention\"}]}]},{\"type\":\"TextBlock\",\"text\":\"${timestamp}\",\"size\":\"Small\",\"isSubtle\":true,\"spacing\":\"Small\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"${environmentName}\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"wrap\":true,\"spacing\":\"Medium\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Environment ID\",\"value\":\"${environmentId}\"},{\"title\":\"Zone\",\"value\":\"${zone}\"},{\"title\":\"Severity\",\"value\":\"${overallStatus}\"},{\"title\":\"Drift From\",\"value\":\"${baselineStatus} → ${currentStatus}\"},{\"title\":\"Audit Status\",\"value\":\"${auditStatus}\"},{\"title\":\"Retention Status\",\"value\":\"${retentionStatus}\"}],\"spacing\":\"Medium\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Reason\",\"weight\":\"Bolder\",\"spacing\":\"Medium\"},{\"type\":\"TextBlock\",\"text\":\"${reason}\",\"wrap\":true,\"spacing\":\"Small\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Remediation\",\"weight\":\"Bolder\",\"spacing\":\"Medium\"},{\"type\":\"TextBlock\",\"text\":\"${remediationHint}\",\"wrap\":true,\"spacing\":\"Small\",\"isSubtle\":true}]}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"View Environment\",\"url\":\"https://admin.powerplatform.microsoft.com/environments/${environmentId}\"},{\"type\":\"Action.OpenUrl\",\"title\":\"View Validation History\",\"url\":\"${validationHistoryUrl}\"}]}', '${overallStatus}', items('Apply_To_Each_Alert')?['OverallStatus']), '${timestamp}', body('Parse_Results')?['Timestamp']), '${environmentName}', items('Apply_To_Each_Alert')?['EnvironmentName']), '${environmentId}', items('Apply_To_Each_Alert')?['EnvironmentId']), '${zone}', items('Apply_To_Each_Alert')?['Zone']), '${baselineStatus}', items('Apply_To_Each_Alert')?['Drift']?['BaselineStatus']), '${currentStatus}', items('Apply_To_Each_Alert')?['Drift']?['CurrentStatus']), '${auditStatus}', items('Apply_To_Each_Alert')?['AuditStatus']), '${retentionStatus}', items('Apply_To_Each_Alert')?['RetentionStatus']), '${reason}', items('Apply_To_Each_Alert')?['Reason']), '${remediationHint}', 'Review environment settings in Power Platform Admin Center. Verify audit configuration and retention policies.'), '${validationHistoryUrl}', concat(variables('DataverseUrl'), '/main.aspx'))"
                          }
                        ]
                      }
                    }
                  },
                  "description": "Post adaptive card to Teams for Failed/Error severity"
                }
              },
              "description": "Only post Teams card for Failed or Error status"
            },
            "Send_Alert_Email": {
              "runAfter": {
                "Check_Severity_For_Teams": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[ALERT] Environment Audit Configuration Drift - @{items('Apply_To_Each_Alert')?['EnvironmentName']} - @{items('Apply_To_Each_Alert')?['OverallStatus']}",
                  "Body": "<h3>Audit Configuration Drift Detected</h3><table><tr><td><strong>Environment:</strong></td><td>@{items('Apply_To_Each_Alert')?['EnvironmentName']}</td></tr><tr><td><strong>Environment ID:</strong></td><td>@{items('Apply_To_Each_Alert')?['EnvironmentId']}</td></tr><tr><td><strong>Zone:</strong></td><td>@{items('Apply_To_Each_Alert')?['Zone']}</td></tr><tr><td><strong>Status:</strong></td><td>@{items('Apply_To_Each_Alert')?['OverallStatus']}</td></tr><tr><td><strong>Baseline Status:</strong></td><td>@{items('Apply_To_Each_Alert')?['Drift']?['BaselineStatus']}</td></tr><tr><td><strong>Current Status:</strong></td><td>@{items('Apply_To_Each_Alert')?['Drift']?['CurrentStatus']}</td></tr><tr><td><strong>Baseline Date:</strong></td><td>@{items('Apply_To_Each_Alert')?['Drift']?['BaselineDate']}</td></tr><tr><td><strong>Reason:</strong></td><td>@{items('Apply_To_Each_Alert')?['Reason']}</td></tr></table><h4>Validator Results</h4><ul><li><strong>Audit Status:</strong> @{items('Apply_To_Each_Alert')?['AuditStatus']}</li><li><strong>Retention Status:</strong> @{items('Apply_To_Each_Alert')?['RetentionStatus']}</li></ul><p><a href=\"https://admin.powerplatform.microsoft.com/environments/@{items('Apply_To_Each_Alert')?['EnvironmentId']}\">View Environment</a> | <a href=\"@{variables('DataverseUrl')}/main.aspx\">View Validation History</a></p>",
                  "Importance": "@if(or(equals(items('Apply_To_Each_Alert')?['OverallStatus'], 'Failed'), equals(items('Apply_To_Each_Alert')?['OverallStatus'], 'Error')), 'High', 'Normal')"
                }
              },
              "description": "Send email alert to compliance distribution list",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT1M"
              }
            }
          },
          "description": "Loop through environments requiring alerts"
        }
      },
      "runAfter": {
        "Initialize_ComplianceDistributionList": ["Succeeded"]
      },
      "type": "Scope",
      "description": "Main validation execution scope with error handling"
    },
    "Scope_Catch": {
      "actions": {
        "Send_Error_Email": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@variables('ComplianceDistributionList')",
              "Subject": "[CRITICAL] Environment Audit Validation Flow Error",
              "Body": "<p><strong>Flow execution encountered an error</strong></p><p>Flow Name: ACV - Environment Audit Validation (Daily)<br>Timestamp: @{utcNow()}</p><p>Review flow run history for details.</p>",
              "Importance": "High"
            }
          },
          "description": "Send error notification on flow failure",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT1M"
          }
        }
      },
      "runAfter": {
        "Scope_Try": ["Failed", "Skipped", "TimedOut"]
      },
      "type": "Scope",
      "description": "Error handling scope - send notification on failure"
    }
  },
  "outputs": {}
}
