// ============================================================
// Function: vw_dim_regulation_control
// Purpose: Build regulation-to-control mapping from governance-mapping.md for Power BI semantic model
//
// Parameters:
//   None - Returns static regulation-to-control lookup table
//
// Output Schema:
//   RegulationId (string) - Regulation identifier (e.g., FINRA-3110, SEC-17a4)
//   RegulationName (string) - Full regulation name
//   RegulationBody (string) - Regulatory body (FINRA, SEC, Federal Reserve, etc.)
//   ControlId (string) - Control identifier (e.g., 1.1, 2.3)
//   ControlName (string) - Control name
//   EvidenceType (string) - Primary, Supporting, or Partial
//
// Supports:
//   PBI-01 - Power BI Semantic Model Design
//   PBI-03 - KQL Pre-Aggregation Functions
//   Control 3.1 (Supporting) - Agent Inventory and Metadata Management
//
// IMPORTANT: Static Reference Data
//   This function generates a static lookup table based on governance-mapping.md.
//   Update this function when governance mapping changes.
//
//   For production environments with frequent mapping changes, consider:
//     - Loading from CSV in blob storage for easier updates
//     - Creating Azure Data Explorer table with .ingest command
//     - Using external_table() for file-based reference data
//
// Deployment:
//   .create-or-alter function vw_dim_regulation_control() { ... }
//
// Expected Row Count:
//   ~50-100 regulation-to-control mappings
//
// Refresh Frequency:
//   Static data - only refresh when governance mapping document is updated.
//
// Integration Pattern:
//   Power BI M query:
//     let
//         Source = AzureDataExplorer.Contents("workspace-url", "database-name"),
//         Query = "vw_dim_regulation_control()"
//     in
//         Source{[Name=Query]}[Data]
//
// ============================================================

let vw_dim_regulation_control = () {
    datatable(
        RegulationId: string,
        RegulationName: string,
        RegulationBody: string,
        ControlId: string,
        ControlName: string,
        EvidenceType: string
    ) [
        // FINRA 3110 - Supervisory Procedures
        "FINRA-3110", "FINRA 3110", "FINRA", "1.1", "Authentication & Authorization", "Supporting",
        "FINRA-3110", "FINRA 3110", "FINRA", "1.7", "Comprehensive Audit Logging", "Primary",
        "FINRA-3110", "FINRA 3110", "FINRA", "2.3", "Agent Supervision", "Primary",
        "FINRA-3110", "FINRA 3110", "FINRA", "2.6", "Model Risk Management", "Supporting",
        "FINRA-3110", "FINRA 3110", "FINRA", "3.2", "Usage Analytics and Activity Monitoring", "Primary",

        // FINRA 4511 - Books and Records
        "FINRA-4511", "FINRA 4511", "FINRA", "1.7", "Comprehensive Audit Logging", "Primary",
        "FINRA-4511", "FINRA 4511", "FINRA", "1.3", "SharePoint Content Governance", "Supporting",

        // SEC 17a-3 - Records to be Made
        "SEC-17a3", "SEC 17a-3", "SEC", "1.7", "Comprehensive Audit Logging", "Primary",
        "SEC-17a3", "SEC 17a-3", "SEC", "3.1", "Agent Inventory and Metadata Management", "Supporting",

        // SEC 17a-4 - Records to be Preserved
        "SEC-17a4", "SEC 17a-4", "SEC", "1.7", "Comprehensive Audit Logging", "Primary",
        "SEC-17a4", "SEC 17a-4", "SEC", "1.3", "SharePoint Content Governance", "Supporting",

        // SOX 302 - Corporate Responsibility
        "SOX-302", "SOX 302", "SOX", "2.8", "Access Control and Segregation of Duties", "Primary",
        "SOX-302", "SOX 302", "SOX", "1.7", "Comprehensive Audit Logging", "Supporting",

        // SOX 404 - Management Assessment
        "SOX-404", "SOX 404", "SOX", "2.8", "Access Control and Segregation of Duties", "Primary",
        "SOX-404", "SOX 404", "SOX", "2.9", "Agent Performance Monitoring", "Supporting",
        "SOX-404", "SOX 404", "SOX", "3.2", "Usage Analytics and Activity Monitoring", "Supporting",

        // SR 11-7 - Model Risk Management
        "SR-11-7", "SR 11-7", "Federal Reserve", "2.5", "Model Risk Management", "Primary",
        "SR-11-7", "SR 11-7", "Federal Reserve", "2.6", "Model Risk Management", "Primary",
        "SR-11-7", "SR 11-7", "Federal Reserve", "2.9", "Agent Performance Monitoring", "Supporting",
        "SR-11-7", "SR 11-7", "Federal Reserve", "1.7", "Comprehensive Audit Logging", "Supporting",

        // OCC 2011-12 - Sound Practices for Model Risk Management
        "OCC-2011-12", "OCC 2011-12", "OCC", "2.5", "Model Risk Management", "Primary",
        "OCC-2011-12", "OCC 2011-12", "OCC", "2.6", "Model Risk Management", "Primary",

        // GLBA 501(b) - Safeguards Rule
        "GLBA-501b", "GLBA 501(b)", "FTC", "1.3", "SharePoint Content Governance", "Primary",
        "GLBA-501b", "GLBA 501(b)", "FTC", "1.6", "DSPM for AI", "Supporting",
        "GLBA-501b", "GLBA 501(b)", "FTC", "1.4", "Advanced Connector Policies", "Supporting",

        // CFTC 1.31 - Books and Records
        "CFTC-1.31", "CFTC 1.31", "CFTC", "1.7", "Comprehensive Audit Logging", "Primary",
        "CFTC-1.31", "CFTC 1.31", "CFTC", "3.1", "Agent Inventory and Metadata Management", "Supporting",

        // Phase 1 Artifact Coverage
        "APP-INSIGHTS", "Application Insights", "Technical", "1.7", "Comprehensive Audit Logging", "Primary",
        "APP-INSIGHTS", "Application Insights", "Technical", "3.2", "Usage Analytics and Activity Monitoring", "Primary",
        "APP-INSIGHTS", "Application Insights", "Technical", "2.9", "Agent Performance Monitoring", "Supporting",

        "LOG-ANALYTICS", "Log Analytics", "Technical", "1.7", "Comprehensive Audit Logging", "Primary",
        "LOG-ANALYTICS", "Log Analytics", "Technical", "3.2", "Usage Analytics and Activity Monitoring", "Primary",

        "ADLS-GEN2", "ADLS Gen2", "Technical", "1.7", "Comprehensive Audit Logging", "Primary",

        "RBAC-SEP", "RBAC Separation", "Technical", "1.6", "DSPM for AI", "Primary",
        "RBAC-SEP", "RBAC Separation", "Technical", "1.4", "Advanced Connector Policies", "Supporting",
        "RBAC-SEP", "RBAC Separation", "Technical", "2.8", "Access Control and Segregation of Duties", "Supporting",

        "PII-SANIT", "PII Sanitization", "Technical", "1.3", "SharePoint Content Governance", "Primary",
        "PII-SANIT", "PII Sanitization", "Technical", "1.6", "DSPM for AI", "Supporting"
    ]
};
vw_dim_regulation_control()
