{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM template for configuring Diagnostic Settings to export Application Insights logs to Azure Blob Storage (StorageV2) for long-term SEC 17a-4 retention.",
    "version": "0.1.0",
    "lastUpdated": "February 2026"
  },
  "parameters": {
    "appInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Application Insights resource to configure diagnostic settings for"
      }
    },
    "storageAccountId": {
      "type": "string",
      "metadata": {
        "description": "Full resource ID of the Azure Blob Storage (StorageV2) account for log export (e.g., /subscriptions/{sub}/resourceGroups/{rg}/providers/Microsoft.Storage/storageAccounts/{name})"
      }
    },
    "settingName": {
      "type": "string",
      "defaultValue": "export-to-storage",
      "metadata": {
        "description": "Name for the diagnostic settings configuration"
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 2555,
      "minValue": 0,
      "maxValue": 365000,
      "metadata": {
        "description": "DEPRECATED: Azure no longer enforces retention via diagnostic settings (Sep 2023). Use storage account lifecycle management policies to enforce SEC 17a-4(a) 7-year retention. This parameter is retained for documentation purposes only."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components/providers/diagnosticSettings",
      "apiVersion": "2021-05-01",
      "name": "[concat(parameters('appInsightsName'), '/Microsoft.Insights/', parameters('settingName'))]",
      "properties": {
        "storageAccountId": "[parameters('storageAccountId')]",
        "logs": [
          {
            "category": "AppTraces",
            "categoryGroup": null,
            "enabled": true
          },
          {
            "category": "AppEvents",
            "categoryGroup": null,
            "enabled": true
          },
          {
            "category": "AppRequests",
            "categoryGroup": null,
            "enabled": true
          },
          {
            "category": "AppExceptions",
            "categoryGroup": null,
            "enabled": true
          }
        ]
      }
    }
  ],
  "outputs": {
    "diagnosticSettingsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/components/providers/diagnosticSettings', parameters('appInsightsName'), 'Microsoft.Insights', parameters('settingName'))]",
      "metadata": {
        "description": "Resource ID of the created diagnostic settings"
      }
    }
  }
}
