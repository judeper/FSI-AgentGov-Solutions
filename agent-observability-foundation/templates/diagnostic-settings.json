{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM template for configuring Diagnostic Settings to export Application Insights logs to StorageV2 storage (hierarchical namespace disabled) for long-term SEC 17a-4 retention.",
    "version": "0.1.0",
    "lastUpdated": "February 2026"
  },
  "parameters": {
    "appInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Application Insights resource to configure diagnostic settings for"
      }
    },
    "storageAccountId": {
      "type": "string",
      "metadata": {
        "description": "Full resource ID of the StorageV2 storage account for log export (hierarchical namespace must be disabled). Example: /subscriptions/{sub}/resourceGroups/{rg}/providers/Microsoft.Storage/storageAccounts/{name}"
      }
    },
    "settingName": {
      "type": "string",
      "defaultValue": "export-to-storage",
      "metadata": {
        "description": "Name for the diagnostic settings configuration"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[parameters('settingName')]",
      "scope": "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
      "properties": {
        "storageAccountId": "[parameters('storageAccountId')]",
        "logs": [
          {
            "category": "AppTraces",
            "categoryGroup": null,
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          },
          {
            "category": "AppEvents",
            "categoryGroup": null,
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          },
          {
            "category": "AppRequests",
            "categoryGroup": null,
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          },
          {
            "category": "AppExceptions",
            "categoryGroup": null,
            "enabled": true,
            "retentionPolicy": {
              "enabled": false,
              "days": 0
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "diagnosticSettingsId": {
      "type": "string",
      "value": "[extensionResourceId(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), 'Microsoft.Insights/diagnosticSettings', parameters('settingName'))]",
      "metadata": {
        "description": "Resource ID of the created diagnostic settings"
      }
    }
  }
}
