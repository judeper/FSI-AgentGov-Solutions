// agent-usage-analytics.kql
// Purpose: Agent session and message volume trends over 30-day period for operational visibility
//
// Parameters:
//   {TimeRange} - Time window (default: 30d) - workbook parameter syntax
//
// Output Schema:
//   Timestamp (datetime) - Day of the aggregation period
//   AgentId (string) - Agent identifier (recipientId from customDimensions)
//   SessionCount (long) - Distinct conversation sessions
//   MessageCount (long) - Total messages (sent + received)
//   CompletionRate (real) - Ratio of sessions with at least one BotMessageSend
//
// Supports:
//   Control 3.2 (Primary) - Usage Analytics and Activity Monitoring
//   Control 2.9 (Supporting) - Agent Performance Monitoring and Optimization
//
// Regulatory Alignment:
//   FINRA 3110 - Supervision metrics for agent activity
//   SOX 404 - Operational monitoring evidence
//
// Sample Output:
// | Timestamp | AgentId | SessionCount | MessageCount | CompletionRate |
// | 2026-02-04 | agent-prod-001 | 342 | 1205 | 0.87 |
// | 2026-02-03 | agent-prod-001 | 318 | 1089 | 0.91 |
// | 2026-02-02 | agent-prod-002 | 156 | 498 | 0.85 |
//
// Notes:
//   - Excludes design mode conversations (test runs in Copilot Studio)
//   - CompletionRate measures sessions where agent provided at least one response
//   - For Log Analytics testing, replace {TimeRange:30d} with literal 30d

let TimeRange = {TimeRange:30d};

customEvents
| where timestamp > ago(TimeRange)
| where name in ("BotMessageReceived", "BotMessageSend")
| where tostring(customDimensions['DesignMode']) == "False"
| extend AgentId = tostring(customDimensions["recipientId"])
| summarize
    SessionCount = dcount(session_Id),
    MessageCount = count(),
    SessionsWithResponse = dcountif(session_Id, name == "BotMessageSend")
    by bin(timestamp, 1d), AgentId
| extend CompletionRate = todouble(SessionsWithResponse) / SessionCount
| project Timestamp = timestamp, AgentId, SessionCount, MessageCount, CompletionRate
| order by Timestamp desc, SessionCount desc
