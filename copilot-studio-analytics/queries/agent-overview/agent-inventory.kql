// agent-inventory.kql
// Purpose: Total agents with conversational vs autonomous split and engagement rates
//
// Parameters:
//   {TimeRange} - Time window (default: 30d) - workbook parameter syntax
//   {Zone} - Zone filter (default: "all") - workbook parameter syntax
//   {AgentType} - Agent type filter (default: "All") - workbook parameter syntax
//
// Output Schema:
//   AgentId (string) - Agent identifier (recipientId from EventProperties)
//   AgentType (string) - Conversational or Autonomous (agentMode from EventProperties)
//   TotalSessions (long) - Total session count for the agent
//   EngagedSessions (long) - Sessions where isEngaged == true
//   EngagementRate (real) - Percentage of engaged sessions
//
// Supports:
//   Control 3.2 (Primary) - Usage Analytics and Activity Monitoring
//
// Regulatory Alignment:
//   FINRA 3110 - Agent inventory for supervision scope
//   SOX 404 - Operational asset inventory evidence
//
// Sample Output:
// | AgentId | AgentType | TotalSessions | EngagedSessions | EngagementRate |
// | agent-prod-001 | Conversational | 1245 | 987 | 79.3 |
// | agent-prod-002 | Autonomous | 890 | 756 | 84.9 |
// | agent-prod-003 | Conversational | 432 | 298 | 69.0 |
//
// Notes:
//   - Queries CopilotSessionOutcome events (synced from Copilot Studio analytics)
//   - EngagementRate helps identify underperforming agents needing investigation
//   - For Log Analytics testing, replace {TimeRange:30d} with literal 30d

let TimeRange = {TimeRange:30d};

let CSAEvents =
    union isfuzzy=true
        (customEvents
        | project EventTime = timestamp, EventName = name, EventProperties = customDimensions),
        (AppEvents
        | project EventTime = TimeGenerated, EventName = Name, EventProperties = Properties)
    | where EventName == "CopilotSessionOutcome"
    | extend SessionId = tostring(EventProperties["sessionId"])
    | extend SessionTime = coalesce(
        todatetime(EventProperties["sessionClosedOn"]),
        todatetime(EventProperties["sessionCreatedOn"]),
        EventTime)
    | where SessionTime > ago(TimeRange)
    | extend DedupKey = iff(isempty(SessionId), strcat(tostring(EventTime), "|", tostring(EventProperties["recipientId"]), "|", EventName), SessionId)
    | summarize arg_max(EventTime, *) by DedupKey;

CSAEvents
| where "{Zone}" == "all" or tostring(EventProperties['Zone']) == "{Zone}"
| where "{AgentType}" == "All" or tostring(EventProperties['agentMode']) == "{AgentType}"
| extend AgentId = tostring(EventProperties["recipientId"])
| extend AgentType = tostring(EventProperties["agentMode"])
| extend IsEngaged = tobool(EventProperties["isEngaged"])
| summarize
    TotalSessions = count(),
    EngagedSessions = countif(IsEngaged == true)
    by AgentId, AgentType
| extend EngagementRate = round(todouble(EngagedSessions) / TotalSessions * 100, 1)
| order by TotalSessions desc
