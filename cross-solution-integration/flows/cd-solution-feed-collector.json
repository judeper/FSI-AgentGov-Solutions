{
  "properties": {
    "displayName": "CD-SolutionFeedCollector",
    "description": "Daily automated feed from Tier 2 governance solutions (ACV, AAM, CAA — abbreviated template; SSC, CMM, FUS follow same pattern) into Compliance Dashboard assessments. Queries each solution's validation history, translates results, and upserts fsi_controlassessment records.",
    "state": "Suspended",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "actions": {
        "Initialize_RunId": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RunId",
                "type": "string",
                "value": "@{guid()}"
              }
            ]
          },
          "runAfter": {}
        },
        "Sync_ACV": {
          "type": "Scope",
          "actions": {
            "Query_ACV_Latest": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_auditvalidationhistories",
                  "$filter": "fsi_validationtype eq 'Orchestrator'",
                  "$orderby": "fsi_timestamp desc",
                  "$top": 1
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "maximumInterval": "PT1M"
              },
              "runAfter": {}
            },
            "ACV_Has_Records": {
              "type": "If",
              "expression": {
                "greater": ["@length(body('Query_ACV_Latest')?['value'])", 0]
              },
              "actions": {
                "Resolve_ACV_ControlMaster": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_controlmasters",
                      "$filter": "fsi_controlid eq '1.7'",
                      "$top": 1
                    }
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "maximumInterval": "PT1M"
                  },
                  "runAfter": {}
                },
                "ACV_ControlMaster_Found": {
                  "type": "If",
                  "expression": {
                    "greater": ["@length(body('Resolve_ACV_ControlMaster')?['value'])", 0]
                  },
                  "actions": {
                    "Map_ACV_Status": {
                      "type": "Compose",
                      "inputs": {
                        "solution": "ACV",
                        "controlId": "1.7",
                        "severity": "@first(body('Query_ACV_Latest')?['value'])?['fsi_severity']",
                        "status": "@if(equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 1), 1, if(or(equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 2), equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 3)), 2, 3))",
                        "score": "@if(equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 1), 100, if(or(equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 2), equals(first(body('Query_ACV_Latest')?['value'])?['fsi_severity'], 3)), 50, 0))",
                        "runId": "@first(body('Query_ACV_Latest')?['value'])?['fsi_runid']",
                        "timestamp": "@first(body('Query_ACV_Latest')?['value'])?['fsi_timestamp']"
                      },
                      "runAfter": {}
                    },
                    "Check_Existing_ACV_Assessment": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "fsi_controlassessments",
                          "$filter": "_fsi_controlmasterid_value eq '@{first(body('Resolve_ACV_ControlMaster')?['value'])?['fsi_controlmasterid']}' and Microsoft.Dynamics.CRM.On(PropertyName='fsi_assessmentdate',PropertyValue='@{utcNow(\"yyyy-MM-dd\")}')",
                          "$top": 1
                        }
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT10S",
                        "maximumInterval": "PT1M"
                      },
                      "runAfter": {
                        "Map_ACV_Status": ["Succeeded"]
                      }
                    },
                    "ACV_Assessment_Exists": {
                      "type": "If",
                      "expression": {
                        "greater": ["@length(body('Check_Existing_ACV_Assessment')?['value'])", 0]
                      },
                      "actions": {
                        "Update_ACV_Assessment": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "UpdateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "fsi_controlassessments",
                              "recordId": "@first(body('Check_Existing_ACV_Assessment')?['value'])?['fsi_controlassessmentid']",
                              "item": {
                                "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Resolve_ACV_ControlMaster')?['value'])?['fsi_controlmasterid']})",
                                "fsi_status": "@outputs('Map_ACV_Status')?['status']",
                                "fsi_score": "@outputs('Map_ACV_Status')?['score']",
                                "fsi_assessmentdate": "@utcNow()",
                                "fsi_notes": "Automated: ACV v1.0.0. Run: @{outputs('Map_ACV_Status')?['runId']}. Severity: @{outputs('Map_ACV_Status')?['severity']}",
                                "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                              }
                            }
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 3,
                            "interval": "PT10S",
                            "maximumInterval": "PT1M"
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_ACV_Assessment": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "CreateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "fsi_controlassessments",
                                "item": {
                                  "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Resolve_ACV_ControlMaster')?['value'])?['fsi_controlmasterid']})",
                                  "fsi_status": "@outputs('Map_ACV_Status')?['status']",
                                  "fsi_score": "@outputs('Map_ACV_Status')?['score']",
                                  "fsi_assessmentdate": "@utcNow()",
                                  "fsi_notes": "Automated: ACV v1.0.0. Run: @{outputs('Map_ACV_Status')?['runId']}. Severity: @{outputs('Map_ACV_Status')?['severity']}",
                                  "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                                }
                              }
                            },
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 3,
                              "interval": "PT10S",
                              "maximumInterval": "PT1M"
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "Check_Existing_ACV_Assessment": ["Succeeded"]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Resolve_ACV_ControlMaster": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Query_ACV_Latest": ["Succeeded"]
              }
            }
          },
          "runAfter": {
            "Initialize_RunId": ["Succeeded"]
          }
        },
        "Sync_AAM": {
          "type": "Scope",
          "actions": {
            "Query_AAM_Latest": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_accessvalidationhistories",
                  "$orderby": "fsi_timestamp desc",
                  "$top": 1
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "maximumInterval": "PT1M"
              },
              "runAfter": {}
            },
            "AAM_Has_Records": {
              "type": "If",
              "expression": {
                "greater": ["@length(body('Query_AAM_Latest')?['value'])", 0]
              },
              "actions": {
                "Resolve_AAM_ControlMaster": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_controlmasters",
                      "$filter": "fsi_controlid eq '3.8'",
                      "$top": 1
                    }
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "maximumInterval": "PT1M"
                  },
                  "runAfter": {}
                },
                "AAM_ControlMaster_Found": {
                  "type": "If",
                  "expression": {
                    "greater": ["@length(body('Resolve_AAM_ControlMaster')?['value'])", 0]
                  },
                  "actions": {
                    "Map_AAM_Status": {
                      "type": "Compose",
                      "inputs": {
                        "solution": "AAM",
                        "controlId": "3.8",
                        "status": "@if(equals(toLower(first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']), 'compliant'), 1, if(equals(toLower(first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']), 'warning'), 2, 3))",
                        "score": "@if(equals(toLower(first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']), 'compliant'), 100, if(equals(toLower(first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']), 'warning'), 50, 0))",
                        "runId": "@first(body('Query_AAM_Latest')?['value'])?['fsi_runid']",
                        "timestamp": "@first(body('Query_AAM_Latest')?['value'])?['fsi_timestamp']"
                      },
                      "runAfter": {}
                    },
                    "Check_Existing_AAM_Assessment": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "fsi_controlassessments",
                          "$filter": "_fsi_controlmasterid_value eq '@{first(body('Resolve_AAM_ControlMaster')?['value'])?['fsi_controlmasterid']}' and Microsoft.Dynamics.CRM.On(PropertyName='fsi_assessmentdate',PropertyValue='@{utcNow(\"yyyy-MM-dd\")}')",
                          "$top": 1
                        }
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT10S",
                        "maximumInterval": "PT1M"
                      },
                      "runAfter": {
                        "Map_AAM_Status": ["Succeeded"]
                      }
                    },
                    "AAM_Assessment_Exists": {
                      "type": "If",
                      "expression": {
                        "greater": ["@length(body('Check_Existing_AAM_Assessment')?['value'])", 0]
                      },
                      "actions": {
                        "Update_AAM_Assessment": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "UpdateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "fsi_controlassessments",
                              "recordId": "@first(body('Check_Existing_AAM_Assessment')?['value'])?['fsi_controlassessmentid']",
                              "item": {
                                "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Resolve_AAM_ControlMaster')?['value'])?['fsi_controlmasterid']})",
                                "fsi_status": "@outputs('Map_AAM_Status')?['status']",
                                "fsi_score": "@outputs('Map_AAM_Status')?['score']",
                                "fsi_assessmentdate": "@utcNow()",
                                "fsi_notes": "Automated: AAM v1.0.0. Run: @{outputs('Map_AAM_Status')?['runId']}. Status: @{first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']}",
                                "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                              }
                            }
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 3,
                            "interval": "PT10S",
                            "maximumInterval": "PT1M"
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_AAM_Assessment": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "CreateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "fsi_controlassessments",
                                "item": {
                                  "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Resolve_AAM_ControlMaster')?['value'])?['fsi_controlmasterid']})",
                                  "fsi_status": "@outputs('Map_AAM_Status')?['status']",
                                  "fsi_score": "@outputs('Map_AAM_Status')?['score']",
                                  "fsi_assessmentdate": "@utcNow()",
                                  "fsi_notes": "Automated: AAM v1.0.0. Run: @{outputs('Map_AAM_Status')?['runId']}. Status: @{first(body('Query_AAM_Latest')?['value'])?['fsi_overall_status']}",
                                  "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                                }
                              }
                            },
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 3,
                              "interval": "PT10S",
                              "maximumInterval": "PT1M"
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "Check_Existing_AAM_Assessment": ["Succeeded"]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Resolve_AAM_ControlMaster": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Query_AAM_Latest": ["Succeeded"]
              }
            }
          },
          "runAfter": {
            "Sync_ACV": ["Succeeded", "Failed"]
          }
        },
        "Sync_CAA": {
          "type": "Scope",
          "actions": {
            "Query_CAA_Latest": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "fsi_capolicyvalidationhistories",
                  "$orderby": "fsi_timestamp desc",
                  "$top": 1
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "maximumInterval": "PT1M"
              },
              "runAfter": {}
            },
            "CAA_Has_Records": {
              "type": "If",
              "expression": {
                "greater": ["@length(body('Query_CAA_Latest')?['value'])", 0]
              },
              "actions": {
                "Resolve_CAA_ControlMasters": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fsi_controlmasters",
                      "$filter": "fsi_controlid eq '1.11' or fsi_controlid eq '1.23' or fsi_controlid eq '1.18'"
                    }
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "maximumInterval": "PT1M"
                  },
                  "runAfter": {}
                },
                "CAA_ControlMasters_Found": {
                  "type": "If",
                  "expression": {
                    "greater": ["@length(body('Resolve_CAA_ControlMasters')?['value'])", 0]
                  },
                  "actions": {
                    "Filter_CAA_Control_1_11": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Resolve_CAA_ControlMasters')?['value']",
                        "where": "@equals(item()?['fsi_controlid'], '1.11')"
                      },
                      "runAfter": {}
                    },
                    "Filter_CAA_Control_1_23": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Resolve_CAA_ControlMasters')?['value']",
                        "where": "@equals(item()?['fsi_controlid'], '1.23')"
                      },
                      "runAfter": {}
                    },
                    "Filter_CAA_Control_1_18": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Resolve_CAA_ControlMasters')?['value']",
                        "where": "@equals(item()?['fsi_controlid'], '1.18')"
                      },
                      "runAfter": {}
                    },
                    "Map_CAA_Status": {
                      "type": "Compose",
                      "inputs": {
                        "solution": "CAA",
                        "controlIds": ["1.11", "1.23", "1.18"],
                        "severity": "@first(body('Query_CAA_Latest')?['value'])?['fsi_severity']",
                        "status": "@if(equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 1), 1, if(or(equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 2), equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 3)), 2, 3))",
                        "score": "@if(equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 1), 100, if(or(equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 2), equals(first(body('Query_CAA_Latest')?['value'])?['fsi_severity'], 3)), 50, 0))",
                        "runId": "@first(body('Query_CAA_Latest')?['value'])?['fsi_runid']",
                        "timestamp": "@first(body('Query_CAA_Latest')?['value'])?['fsi_timestamp']"
                      },
                      "runAfter": {}
                    },
                    "Check_Existing_CAA_1_11": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "fsi_controlassessments",
                          "$filter": "_fsi_controlmasterid_value eq '@{first(body('Filter_CAA_Control_1_11'))?['fsi_controlmasterid']}' and Microsoft.Dynamics.CRM.On(PropertyName='fsi_assessmentdate',PropertyValue='@{utcNow(\"yyyy-MM-dd\")}')",
                          "$top": 1
                        }
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT10S",
                        "maximumInterval": "PT1M"
                      },
                      "runAfter": {
                        "Map_CAA_Status": ["Succeeded"],
                        "Filter_CAA_Control_1_11": ["Succeeded"]
                      }
                    },
                    "CAA_1_11_Exists": {
                      "type": "If",
                      "expression": {
                        "greater": ["@length(body('Check_Existing_CAA_1_11')?['value'])", 0]
                      },
                      "actions": {
                        "Update_CAA_Assessment_1_11": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "UpdateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "fsi_controlassessments",
                              "recordId": "@first(body('Check_Existing_CAA_1_11')?['value'])?['fsi_controlassessmentid']",
                              "item": {
                                "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Filter_CAA_Control_1_11'))?['fsi_controlmasterid']})",
                                "fsi_status": "@outputs('Map_CAA_Status')?['status']",
                                "fsi_score": "@outputs('Map_CAA_Status')?['score']",
                                "fsi_assessmentdate": "@utcNow()",
                                "fsi_notes": "Automated: CAA v1.1.0. Run: @{outputs('Map_CAA_Status')?['runId']}. Severity: @{outputs('Map_CAA_Status')?['severity']}. Control 1.11 (primary, dual-feed with SSC).",
                                "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                              }
                            }
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 3,
                            "interval": "PT10S",
                            "maximumInterval": "PT1M"
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_CAA_Assessment_1_11": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "CreateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "fsi_controlassessments",
                                "item": {
                                  "fsi_controlmasterid@odata.bind": "/fsi_controlmasters(@{first(body('Filter_CAA_Control_1_11'))?['fsi_controlmasterid']})",
                                  "fsi_status": "@outputs('Map_CAA_Status')?['status']",
                                  "fsi_score": "@outputs('Map_CAA_Status')?['score']",
                                  "fsi_assessmentdate": "@utcNow()",
                                  "fsi_notes": "Automated: CAA v1.1.0. Run: @{outputs('Map_CAA_Status')?['runId']}. Severity: @{outputs('Map_CAA_Status')?['severity']}. Control 1.11 (primary, dual-feed with SSC).",
                                  "fsi_nextreviewdate": "@addDays(utcNow(), 1)"
                                }
                              }
                            },
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 3,
                              "interval": "PT10S",
                              "maximumInterval": "PT1M"
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "Check_Existing_CAA_1_11": ["Succeeded"]
                      }
                    },
                    "Check_Existing_CAA_1_23": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "fsi_controlassessments",
                          "$filter": "_fsi_controlmasterid_value eq '@{first(body('Filter_CAA_Control_1_23'))?['fsi_controlmasterid']}' and Microsoft.Dynamics.CRM.On(PropertyName='fsi_assessmentdate',PropertyValue='@{utcNow(\"yyyy-MM-dd\")}')",
                          "$top": 1
                        }
                      },
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT10S",
                        "maximumInterval": "PT1M"
                      },
                      "runAfter": {
