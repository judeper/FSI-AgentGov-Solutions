{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": ["6"],
          "minutes": [0]
        },
        "timeZone": "UTC"
      },
      "type": "Recurrence",
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Initialize_DataverseUrl": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DataverseUrl",
            "type": "string",
            "value": "your-dataverse-url-here"
          }
        ]
      },
      "description": "Central Dataverse organization URL for validation history and baselines. TODO: migrate to fsi_CMM_DataverseUrl environment variable"
    },
    "Initialize_TenantId": {
      "runAfter": {
        "Initialize_DataverseUrl": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TenantId",
            "type": "string",
            "value": "contoso.onmicrosoft.com"
          }
        ]
      },
      "description": "Microsoft Entra ID tenant ID. TODO: migrate to fsi_CMM_TenantId environment variable"
    },
    "Initialize_ClientId": {
      "runAfter": {
        "Initialize_TenantId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ClientId",
            "type": "string",
            "value": "your-client-id-here"
          }
        ]
      },
      "description": "Microsoft Entra ID application client ID for certificate-based authentication. TODO: migrate to fsi_CMM_ClientId environment variable"
    },
    "Initialize_CertificateThumbprint": {
      "runAfter": {
        "Initialize_ClientId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CertificateThumbprint",
            "type": "string",
            "value": "your-certificate-thumbprint-here"
          }
        ]
      },
      "description": "Certificate thumbprint for service principal authentication. TODO: migrate to fsi_CMM_CertificateThumbprint environment variable"
    },
    "Initialize_SubscriptionId": {
      "runAfter": {
        "Initialize_CertificateThumbprint": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SubscriptionId",
            "type": "string",
            "value": "your-subscription-id-here"
          }
        ]
      },
      "description": "Azure subscription ID containing Automation Account. TODO: migrate to fsi_CMM_SubscriptionId environment variable"
    },
    "Initialize_ResourceGroup": {
      "runAfter": {
        "Initialize_SubscriptionId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ResourceGroup",
            "type": "string",
            "value": "rg-content-moderation-monitor"
          }
        ]
      },
      "description": "Azure resource group containing Automation Account. TODO: migrate to fsi_CMM_ResourceGroup environment variable"
    },
    "Initialize_AutomationAccount": {
      "runAfter": {
        "Initialize_ResourceGroup": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "AutomationAccount",
            "type": "string",
            "value": "aa-content-moderation-monitor"
          }
        ]
      },
      "description": "Azure Automation Account name. TODO: migrate to fsi_CMM_AutomationAccount environment variable"
    },
    "Initialize_TeamsGroupId": {
      "runAfter": {
        "Initialize_AutomationAccount": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsGroupId",
            "type": "string",
            "value": "your-teams-group-id-here"
          }
        ]
      },
      "description": "Teams group (team) ID for alert notifications. TODO: migrate to fsi_CMM_TeamsGroupId environment variable"
    },
    "Initialize_TeamsChannelId": {
      "runAfter": {
        "Initialize_TeamsGroupId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsChannelId",
            "type": "string",
            "value": "your-teams-channel-id-here"
          }
        ]
      },
      "description": "Teams channel ID for alert notifications. TODO: migrate to fsi_CMM_TeamsChannelId environment variable"
    },
    "Initialize_ComplianceDistributionList": {
      "runAfter": {
        "Initialize_TeamsChannelId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ComplianceDistributionList",
            "type": "string",
            "value": "compliance-alerts@contoso.com"
          }
        ]
      },
      "description": "Email distribution list for compliance alerts. TODO: migrate to fsi_CMM_ComplianceDistributionList environment variable"
    },
    "Initialize_DocumentationUrl": {
      "runAfter": {
        "Initialize_ComplianceDistributionList": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DocumentationUrl",
            "type": "string",
            "value": "https://your-org.github.io/FSI-AgentGov/controls/pillar-1-security/1.27-ai-agent-content-moderation-enforcement/"
          }
        ]
      },
      "description": "Documentation URL for adaptive card links. Update per organization deployment."
    },
    "Scope_Try": {
      "actions": {
        "Create_Automation_Job": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "put",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs",
            "queries": {
              "runbookName": "Start-ModerationValidationRunbook",
              "wait": false,
              "x-ms-api-version": "2023-11-01"
            },
            "body": {
              "properties": {
                "parameters": {
                  "TenantId": "@{variables('TenantId')}",
                  "ClientId": "@{variables('ClientId')}",
                  "CertificateThumbprint": "@{variables('CertificateThumbprint')}",
                  "DataverseUrl": "@{variables('DataverseUrl')}"
                }
              }
            }
          },
          "description": "Start Azure Automation runbook for content moderation compliance validation",
          "runtimeConfiguration": {
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT30S"
            }
          }
        },
        "Wait_For_Job": {
          "runAfter": {
            "Create_Automation_Job": ["Succeeded"]
          },
          "type": "Until",
          "expression": "@or(equals(body('Get_Job_Status')?['properties']?['status'], 'Completed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Failed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Stopped'), equals(body('Get_Job_Status')?['properties']?['status'], 'Suspended'), equals(body('Get_Job_Status')?['properties']?['status'], 'Blocked'))",
          "limit": {
            "count": 240,
            "timeout": "PT2H"
          },
          "actions": {
            "Delay": {
              "runAfter": {},
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 30,
                  "unit": "Second"
                }
              },
              "description": "Wait 30 seconds before checking job status"
            },
            "Get_Job_Status": {
              "runAfter": {
                "Delay": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureautomation']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}",
                "queries": {
                  "x-ms-api-version": "2023-11-01"
                }
              },
              "description": "Check runbook job status",
              "runtimeConfiguration": {
                "retryPolicy": {
                  "type": "fixed",
                  "count": 3,
                  "interval": "PT30S"
                }
              }
            }
          },
          "description": "Wait until runbook job completes or fails (max 2 hours)"
        },
        "Check_Job_Failed": {
          "runAfter": {
            "Wait_For_Job": ["Succeeded"]
          },
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Failed"
                ]
              },
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Stopped"
                ]
              },
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Suspended"
                ]
              },
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Blocked"
                ]
              }
            ]
          },
          "actions": {
            "Send_Job_Failure_Email": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[CRITICAL] CMM Automation Job Failed",
                  "Body": "<p><strong>Azure Automation job failed</strong></p><p>Flow Name: CMM - Content Moderation Validation (Daily)<br>Timestamp: @{utcNow()}<br>Job ID: @{coalesce(body('Create_Automation_Job')?['properties']?['jobId'], 'N/A')}<br>Job Status: @{body('Get_Job_Status')?['properties']?['status']}</p><p>Review Azure Automation job logs for details.</p>",
                  "Importance": "High"
                }
              },
              "description": "Send failure notification before terminating so Scope_Catch is not the only error path",
              "runtimeConfiguration": {
                "retryPolicy": {
                  "type": "fixed",
                  "count": 3,
                  "interval": "PT30S"
                }
              }
            },
            "Terminate_Failed": {
              "runAfter": {
                "Send_Job_Failure_Email": ["Succeeded", "Failed"]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "message": "Azure Automation job failed: @{body('Get_Job_Status')?['properties']?['status']}"
                }
              }
            }
          },
          "description": "Handle job failure - send alert email and terminate"
        },
        "Get_Job_Output": {
          "runAfter": {
            "Check_Job_Failed": ["Succeeded"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "get",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}/output",
            "queries": {
              "x-ms-api-version": "2023-11-01"
            }
          },
          "description": "Retrieve runbook job output (JSON string)",
          "runtimeConfiguration": {
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT30S"
            }
          }
        },
        "Parse_Results": {
          "runAfter": {
            "Get_Job_Output": ["Succeeded"]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Job_Output')",
            "schema": {
              "type": "object",
              "properties": {
                "RunType": { "type": "string" },
                "Timestamp": { "type": "string" },
                "TotalAgents": { "type": "integer" },
                "TotalEnvironments": { "type": "integer" },
                "OverallStatus": { "type": "string" },
                "Reason": { "type": "string" },
                "ZoneSummary": {
                  "type": "object",
                  "properties": {
                    "Zone1": {
                      "type": "object",
                      "properties": {
                        "Total": { "type": "integer" },
                        "Compliant": { "type": "integer" },
                        "Violations": { "type": "integer" }
                      }
                    },
                    "Zone2": {
                      "type": "object",
                      "properties": {
                        "Total": { "type": "integer" },
                        "Compliant": { "type": "integer" },
                        "Violations": { "type": "integer" }
                      }
                    },
                    "Zone3": {
                      "type": "object",
                      "properties": {
                        "Total": { "type": "integer" },
                        "Compliant": { "type": "integer" },
                        "Violations": { "type": "integer" }
                      }
                    },
                    "Unknown": {
                      "type": "object",
                      "properties": {
                        "Total": { "type": "integer" },
                        "Compliant": { "type": "integer" },
                        "Violations": { "type": "integer" }
                      }
                    }
                  }
                },
                "Violations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "AgentId": { "type": "string" },
                      "AgentName": { "type": "string" },
                      "EnvironmentId": { "type": "string" },
                      "EnvironmentName": { "type": "string" },
                      "Zone": { "type": "string" },
                      "ExpectedModerationLevel": { "type": "string" },
                      "ActualModerationLevel": { "type": "string" },
                      "Severity": { "type": "string" },
                      "RegulatoryContext": { "type": "string" }
                    }
                  }
                },
                "Drift": {
                  "type": "object",
                  "properties": {
                    "HasDrift": { "type": "boolean" },
                    "IsFirstRun": { "type": "boolean" },
                    "DriftedAgents": { "type": "integer" },
                    "Details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "AgentId": { "type": "string" },
                          "AgentName": { "type": "string" },
                          "EnvironmentId": { "type": "string" },
                          "EnvironmentName": { "type": "string" },
                          "Zone": { "type": "string" },
                          "HasDrift": { "type": "boolean" },
                          "IsFirstRun": { "type": "boolean" },
                          "Direction": { "type": "string" },
                          "BaselineLevel": { "type": "string" },
                          "CurrentLevel": { "type": "string" }
                        }
                      }
                    }
                  }
                },
                "AlertRequired": { "type": "boolean" },
                "AlertSeverity": { "type": "string" }
              }
            }
          },
          "description": "Parse JSON output from runbook into typed properties. Schema matches CMM runbook output with TotalAgents, per-agent violations, and agent-level drift object."
        },
        "Check_Alert_Required": {
          "runAfter": {
            "Parse_Results": ["Succeeded"]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Parse_Results')?['AlertRequired']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Check_Severity_For_Teams": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@body('Parse_Results')?['AlertSeverity']",
                      "Critical"
                    ]
                  },
                  {
                    "equals": [
                      "@body('Parse_Results')?['OverallStatus']",
                      "Error"
                    ]
                  }
                ]
              },
              "actions": {
                "Post_Teams_Card": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['teams']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v1.0/teams/@{variables('TeamsGroupId')}/channels/@{variables('TeamsChannelId')}/messages",
                    "body": {
                      "rootMessage": {
                        "body": {
                          "contentType": "html",
                          "content": "<attachment id=\"adaptive-card\"></attachment>"
                        },
                        "attachments": [
                          {
                            "contentType": "application/vnd.microsoft.card.adaptive",
                            "content": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace('{\"type\":\"AdaptiveCard\",\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"attention\",\"items\":[{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"[ALERT] Content Moderation Governance Monitor\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"color\":\"Attention\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"${AlertSeverity}\",\"weight\":\"Bolder\",\"horizontalAlignment\":\"Right\",\"color\":\"Attention\"}]}]},{\"type\":\"TextBlock\",\"text\":\"${Timestamp}\",\"size\":\"Small\",\"isSubtle\":true,\"spacing\":\"Small\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Run Summary\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"spacing\":\"Medium\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Status\",\"value\":\"${OverallStatus}\"},{\"title\":\"Total Agents\",\"value\":\"${TotalAgents}\"},{\"title\":\"Total Environments\",\"value\":\"${TotalEnvironments}\"},{\"title\":\"Severity\",\"value\":\"${AlertSeverity}\"},{\"title\":\"Reason\",\"value\":\"${Reason}\"}],\"spacing\":\"Medium\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Zone Summary\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"spacing\":\"Medium\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Zone 1\",\"value\":\"${Z1Compliant}/${Z1Total} compliant\"},{\"title\":\"Zone 2\",\"value\":\"${Z2Compliant}/${Z2Total} compliant\"},{\"title\":\"Zone 3\",\"value\":\"${Z3Compliant}/${Z3Total} compliant\"},{\"title\":\"Unknown\",\"value\":\"${UnkCompliant}/${UnkTotal} compliant\"}],\"spacing\":\"Medium\"}]}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"View in Power Platform Admin\",\"url\":\"https://admin.powerplatform.microsoft.com/environments\"},{\"type\":\"Action.OpenUrl\",\"title\":\"View Documentation\",\"url\":\"${DocumentationUrl}\"}]}', '${DocumentationUrl}', variables('DocumentationUrl')), '${AlertSeverity}', body('Parse_Results')?['AlertSeverity']), '${Timestamp}', body('Parse_Results')?['Timestamp']), '${OverallStatus}', body('Parse_Results')?['OverallStatus']), '${TotalAgents}', string(body('Parse_Results')?['TotalAgents'])), '${TotalEnvironments}', string(body('Parse_Results')?['TotalEnvironments'])), '${Reason}', replace(replace(body('Parse_Results')?['Reason'], '\\', '\\\\'), '\"', '\\\"')), '${Z1Total}', string(body('Parse_Results')?['ZoneSummary']?['Zone1']?['Total'])), '${Z1Compliant}', string(body('Parse_Results')?['ZoneSummary']?['Zone1']?['Compliant'])), '${Z2Total}', string(body('Parse_Results')?['ZoneSummary']?['Zone2']?['Total'])), '${Z2Compliant}', string(body('Parse_Results')?['ZoneSummary']?['Zone2']?['Compliant'])), '${Z3Total}', string(body('Parse_Results')?['ZoneSummary']?['Zone3']?['Total'])), '${Z3Compliant}', string(body('Parse_Results')?['ZoneSummary']?['Zone3']?['Compliant'])), '${UnkTotal}', string(body('Parse_Results')?['ZoneSummary']?['Unknown']?['Total'])), '${UnkCompliant}', string(body('Parse_Results')?['ZoneSummary']?['Unknown']?['Compliant']))"
                          }
                        ]
                      }
                    }
                  },
                  "description": "Post adaptive card to Teams for Critical/Failed/Error severity. Connection: fsi_cr_teams_moderationmonitor",
                  "runtimeConfiguration": {
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 3,
                      "interval": "PT30S"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "description": "Only post Teams card for Critical/Failed/Error status"
            },
            "Send_Alert_Email": {
              "runAfter": {
                "Check_Severity_For_Teams": ["Succeeded", "Failed"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[ALERT] Content Moderation Governance - @{body('Parse_Results')?['OverallStatus']} - @{body('Parse_Results')?['AlertSeverity']}",
                  "Body": "<h3>Content Moderation Governance Monitor Alert</h3><table><tr><td><strong>Status:</strong></td><td>@{body('Parse_Results')?['OverallStatus']}</td></tr><tr><td><strong>Severity:</strong></td><td>@{body('Parse_Results')?['AlertSeverity']}</td></tr><tr><td><strong>Total Agents:</strong></td><td>@{body('Parse_Results')?['TotalAgents']}</td></tr><tr><td><strong>Total Environments:</strong></td><td>@{body('Parse_Results')?['TotalEnvironments']}</td></tr><tr><td><strong>Violations:</strong></td><td>@{length(body('Parse_Results')?['Violations'])}</td></tr><tr><td><strong>Reason:</strong></td><td>@{body('Parse_Results')?['Reason']}</td></tr><tr><td><strong>Timestamp:</strong></td><td>@{body('Parse_Results')?['Timestamp']}</td></tr></table><h4>Zone Summary</h4><ul><li><strong>Zone 1:</strong> @{body('Parse_Results')?['ZoneSummary']?['Zone1']?['Compliant']}/@{body('Parse_Results')?['ZoneSummary']?['Zone1']?['Total']} agents compliant</li><li><strong>Zone 2:</strong> @{body('Parse_Results')?['ZoneSummary']?['Zone2']?['Compliant']}/@{body('Parse_Results')?['ZoneSummary']?['Zone2']?['Total']} agents compliant</li><li><strong>Zone 3:</strong> @{body('Parse_Results')?['ZoneSummary']?['Zone3']?['Compliant']}/@{body('Parse_Results')?['ZoneSummary']?['Zone3']?['Total']} agents compliant</li><li><strong>Unknown:</strong> @{body('Parse_Results')?['ZoneSummary']?['Unknown']?['Compliant']}/@{body('Parse_Results')?['ZoneSummary']?['Unknown']?['Total']} agents compliant</li></ul><h4>Drift Detection</h4><p>Drifted Agents: @{body('Parse_Results')?['Drift']?['DriftedAgents']}</p><p><a href=\"https://admin.powerplatform.microsoft.com/environments\">View in Power Platform Admin Center</a></p>",
                  "Importance": "@if(or(equals(body('Parse_Results')?['AlertSeverity'], 'Critical'), equals(body('Parse_Results')?['OverallStatus'], 'Error')), 'High', 'Normal')"
                }
              },
              "description": "Send email alert to compliance distribution list for all alert-required results. Connection: fsi_cr_office365_moderationmonitor",
              "runtimeConfiguration": {
                "retryPolicy": {
                  "type": "fixed",
                  "count": 3,
                  "interval": "PT30S"
                }
              }
            },
            "Log_Teams_Failure": {
              "runAfter": {
                "Check_Severity_For_Teams": ["Failed"]
              },
              "type": "Compose",
              "inputs": {
                "message": "Teams card post failed for Check_Severity_For_Teams. The email alert will still be sent.",
                "timestamp": "@utcNow()",
                "severity": "@body('Parse_Results')?['AlertSeverity']"
              },
              "description": "Log Teams notification failure so it is visible in flow run history"
            }
          },
          "else": {
            "actions": {}
          },
          "description": "Route alerts based on AlertRequired flag. Critical/Failed -> Teams + email; High/Warning -> email only; Passed -> no alert"
        }
      },
      "runAfter": {
        "Initialize_DocumentationUrl": ["Succeeded"]
      },
      "type": "Scope",
      "description": "Main validation execution scope with error handling"
    },
    "Scope_Catch": {
      "actions": {
        "Send_Critical_Error_Email": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@coalesce(variables('ComplianceDistributionList'), 'compliance-alerts@contoso.com')",
              "Subject": "[CRITICAL] CMM Flow Execution Failed",
              "Body": "<p><strong>Flow execution encountered an error</strong></p><p>Flow Name: CMM - Content Moderation Validation (Daily)<br>Timestamp: @{utcNow()}<br>Job ID: @{coalesce(body('Create_Automation_Job')?['properties']?['jobId'], 'N/A')}<br>Job Status: @{coalesce(body('Get_Job_Status')?['properties']?['status'], 'N/A')}</p><p>Review flow run history in Power Automate for details.</p>",
              "Importance": "High"
            }
          },
          "description": "Send CRITICAL error notification when the flow itself fails",
          "runtimeConfiguration": {
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT30S"
            }
          }
        }
      },
      "runAfter": {
        "Scope_Try": ["Failed", "Skipped", "TimedOut"]
      },
      "type": "Scope",
      "description": "Error handling scope - sends CRITICAL email when flow execution fails"
    }
  },
  "outputs": {}
}
