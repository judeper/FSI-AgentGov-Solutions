{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": ["6"],
          "minutes": [0]
        },
        "timeZone": "UTC"
      },
      "type": "Recurrence",
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Initialize_DataverseUrl": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DataverseUrl",
            "type": "string",
            "value": "https://governance.crm.dynamics.com"
          }
        ]
      },
      "description": "Central Dataverse organization URL for validation history storage"
    },
    "Initialize_TenantId": {
      "runAfter": {
        "Initialize_DataverseUrl": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TenantId",
            "type": "string",
            "value": "contoso.onmicrosoft.com"
          }
        ]
      },
      "description": "Azure AD tenant ID"
    },
    "Initialize_ClientId": {
      "runAfter": {
        "Initialize_TenantId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ClientId",
            "type": "string",
            "value": "your-client-id-here"
          }
        ]
      },
      "description": "Azure AD application client ID"
    },
    "Initialize_CertificateThumbprint": {
      "runAfter": {
        "Initialize_ClientId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CertificateThumbprint",
            "type": "string",
            "value": "your-certificate-thumbprint-here"
          }
        ]
      },
      "description": "Certificate thumbprint for service principal authentication"
    },
    "Initialize_SubscriptionId": {
      "runAfter": {
        "Initialize_CertificateThumbprint": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SubscriptionId",
            "type": "string",
            "value": "your-subscription-id-here"
          }
        ]
      },
      "description": "Azure subscription ID containing Automation Account"
    },
    "Initialize_ResourceGroup": {
      "runAfter": {
        "Initialize_SubscriptionId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ResourceGroup",
            "type": "string",
            "value": "rg-session-validation"
          }
        ]
      },
      "description": "Azure resource group containing Automation Account"
    },
    "Initialize_AutomationAccount": {
      "runAfter": {
        "Initialize_ResourceGroup": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "AutomationAccount",
            "type": "string",
            "value": "aa-session-validator"
          }
        ]
      },
      "description": "Azure Automation Account name"
    },
    "Initialize_TeamsTeamId": {
      "runAfter": {
        "Initialize_AutomationAccount": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsTeamId",
            "type": "string",
            "value": "your-teams-team-id-here"
          }
        ]
      },
      "description": "Teams team (group) ID for alert notifications"
    },
    "Initialize_TeamsChannelId": {
      "runAfter": {
        "Initialize_TeamsTeamId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TeamsChannelId",
            "type": "string",
            "value": "your-teams-channel-id-here"
          }
        ]
      },
      "description": "Teams channel ID for alert notifications"
    },
    "Initialize_ComplianceDistributionList": {
      "runAfter": {
        "Initialize_TeamsChannelId": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ComplianceDistributionList",
            "type": "string",
            "value": "compliance-alerts@contoso.com"
          }
        ]
      },
      "description": "Email distribution list for compliance alerts"
    },
    "Initialize_Zone": {
      "runAfter": {
        "Initialize_ComplianceDistributionList": ["Succeeded"]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Zone",
            "type": "string",
            "value": "Zone3"
          }
        ]
      },
      "description": "Governance zone to validate (Zone1, Zone2, or Zone3)"
    },
    "Scope_Try": {
      "actions": {
        "Create_Automation_Job": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "put",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs",
            "queries": {
              "runbookName": "Start-SessionValidationRunbook",
              "wait": false,
              "x-ms-api-version": "2015-10-31"
            },
            "body": {
              "properties": {
                "parameters": {
                  "Zone": "@{variables('Zone')}",
                  "DataverseUrl": "@{variables('DataverseUrl')}",
                  "TenantId": "@{variables('TenantId')}",
                  "ClientId": "@{variables('ClientId')}",
                  "CertificateThumbprint": "@{variables('CertificateThumbprint')}",
                  "ConfigPath": "tenant-config.json"
                }
              }
            }
          },
          "description": "Start Azure Automation runbook for session security validation. No retryPolicy: PUT job creation is not idempotent — retries could create duplicate jobs. Use scope-level error handling instead."
        },
        "Wait_For_Job": {
          "runAfter": {
            "Create_Automation_Job": ["Succeeded"]
          },
          "type": "Until",
          "expression": "@or(equals(body('Get_Job_Status')?['properties']?['status'], 'Completed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Failed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Stopped'), equals(body('Get_Job_Status')?['properties']?['status'], 'Suspended'))",
          "limit": {
            "count": 240,
            "timeout": "PT2H"
          },
          "actions": {
            "Get_Job_Status": {
              "runAfter": {
                "Delay": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureautomation']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}",
                "queries": {
                  "x-ms-api-version": "2015-10-31"
                }
              },
              "description": "Check runbook job status",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT5M"
              }
            },
            "Delay": {
              "runAfter": {},
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 30,
                  "unit": "Second"
                }
              },
              "description": "Wait 30 seconds before checking job status"
            }
          },
          "description": "Wait until runbook job completes or fails (max 2 hours)"
        },
        "Check_Job_Failed": {
          "runAfter": {
            "Wait_For_Job": ["Succeeded"]
          },
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@body('Get_Job_Status')?['properties']?['status']",
                "Completed"
              ]
            }
          },
          "actions": {
            "Send_Job_Failure_Email": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[CRITICAL] Session Security Validation Job Failed",
                  "Body": "<p><strong>Azure Automation job failed</strong></p><p>Runbook: Start-SessionValidationRunbook<br>Zone: @{variables('Zone')}<br>Status: @{body('Get_Job_Status')?['properties']?['status']}<br>Job ID: @{body('Create_Automation_Job')?['properties']?['jobId']}</p><p>Review job output in Azure Portal.</p>",
                  "Importance": "High"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT30M"
              },
              "description": "Send email notification on job failure"
            },
            "Write_Failure_Validation_History": {
              "runAfter": {
                "Send_Job_Failure_Email": ["Succeeded", "Failed"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['shared_commondataserviceforapps']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(variables('DataverseUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('fsi_validationhistories'))}/items",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S",
                  "minimumInterval": "PT10S",
                  "maximumInterval": "PT1H"
                },
                "body": {
                  "fsi_name": "@{variables('Zone')}-@{utcNow('o')}",
                  "fsi_runid": "@{guid()}",
                  "fsi_zone": "@{if(equals(variables('Zone'), 'Zone1'), 100000001, if(equals(variables('Zone'), 'Zone2'), 100000002, 100000003))}",
                  "fsi_severity": 5,
                  "fsi_validationtype": 6,
                  "fsi_rawvalue": "@{concat('{\"jobStatus\":\"', body('Get_Job_Status')?['properties']?['status'], '\",\"jobId\":\"', body('Create_Automation_Job')?['properties']?['jobId'], '\"}')}",
                  "fsi_reason": "Azure Automation job failed with status: @{body('Get_Job_Status')?['properties']?['status']}",
                  "fsi_timestamp": "@{utcNow('o')}",
                  "fsi_checkcount": 0,
                  "fsi_baselineid": "",
                  "fsi_remediationhint": "Review Azure Automation job output in Azure Portal"
                }
              },
              "description": "Write failure record to Dataverse immutable audit trail before terminating"
            },
            "Notify_Failure_Write_Error": {
              "runAfter": {
                "Write_Failure_Validation_History": ["Failed"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[CRITICAL] Failure Validation History Write Failed - @{variables('Zone')}",
                  "Body": "<p><strong>Dataverse audit trail write failed (job-failure path)</strong></p><p>The Write_Failure_Validation_History action could not persist the job failure record to fsi_validationhistories.</p><p>Zone: @{variables('Zone')}<br>Timestamp: @{utcNow('o')}</p><p>Manual investigation required to ensure audit trail completeness.</p>",
                  "Importance": "High"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT30M"
              },
              "description": "Notify compliance team when failure validation history Dataverse write fails"
            },
            "Terminate_Failed": {
              "runAfter": {
                "Notify_Failure_Write_Error": ["Succeeded", "Failed", "Skipped"]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "message": "Azure Automation job failed: @{body('Get_Job_Status')?['properties']?['status']}"
                }
              }
            }
          },
          "description": "Handle job failure - send alert and terminate"
        },
        "Get_Job_Output": {
          "runAfter": {
            "Check_Job_Failed": ["Succeeded"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['azureautomation']['connectionId']"
              }
            },
            "method": "get",
            "path": "/subscriptions/@{encodeURIComponent(variables('SubscriptionId'))}/resourceGroups/@{encodeURIComponent(variables('ResourceGroup'))}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(variables('AutomationAccount'))}/jobs/@{encodeURIComponent(body('Create_Automation_Job')?['properties']?['jobId'])}/output",
            "queries": {
              "x-ms-api-version": "2015-10-31"
            }
          },
          "description": "Retrieve runbook job output (JSON string)",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT5M"
          }
        },
        "Parse_Results": {
          "runAfter": {
            "Get_Job_Output": ["Succeeded"]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Job_Output')",
            "schema": {
              "type": "object",
              "properties": {
                "RunType": { "type": "string" },
                "Timestamp": { "type": "string" },
                "Zone": { "type": "string" },
                "OverallStatus": { "type": "string" },
                "Reason": { "type": "string" },
                "Validators": {
                  "type": "object",
                  "properties": {
                    "SessionControls": {
                      "type": "object",
                      "properties": {
                        "Status": { "type": "string" },
                        "Reason": { "type": "string" }
                      }
                    },
                    "AuthenticationStrength": {
                      "type": "object",
                      "properties": {
                        "Status": { "type": "string" },
                        "Reason": { "type": "string" }
                      }
                    },
                    "PimRoleSettings": {
                      "type": "object",
                      "properties": {
                        "Status": { "type": "string" },
                        "Reason": { "type": "string" }
                      }
                    },
                    "BreakGlassExclusions": {
                      "type": "object",
                      "properties": {
                        "Status": { "type": "string" },
                        "Reason": { "type": "string" }
                      }
                    }
                  }
                },
                "Drift": {
                  "type": "object",
                  "properties": {
                    "DriftDetected": { "type": "boolean" },
                    "CurrentStatus": { "type": "string" },
                    "BaselineStatus": { "type": "string" },
                    "BaselineDate": { "type": "string" },
                    "IsFirstRun": { "type": "boolean" }
                  }
                },
                "AlertRequired": { "type": "boolean" },
                "AlertSeverity": { "type": "string" }
              }
            }
          },
          "description": "Parse JSON output from runbook"
        },
        "Write_Validation_History": {
          "runAfter": {
            "Parse_Results": ["Succeeded"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_commondataserviceforapps']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(variables('DataverseUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('fsi_validationhistories'))}/items",
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1H"
            },
            "body": {
              "fsi_name": "@{body('Parse_Results')?['Zone']}-@{body('Parse_Results')?['Timestamp']}",
              "fsi_runid": "@{guid()}",
              "fsi_zone": "@{if(equals(body('Parse_Results')?['Zone'], 'Zone1'), 100000001, if(equals(body('Parse_Results')?['Zone'], 'Zone2'), 100000002, 100000003))}",
              "fsi_severity": "@{if(equals(body('Parse_Results')?['OverallStatus'], 'Passed'), 1, if(equals(body('Parse_Results')?['OverallStatus'], 'Warning'), 2, if(equals(body('Parse_Results')?['OverallStatus'], 'GracePeriod'), 3, if(equals(body('Parse_Results')?['OverallStatus'], 'Failed'), 4, 5))))}",
              "fsi_validationtype": 6,
              "fsi_rawvalue": "@{string(body('Parse_Results'))}",
              "fsi_reason": "@{body('Parse_Results')?['Reason']}",
              "fsi_timestamp": "@{body('Parse_Results')?['Timestamp']}",
              "fsi_checkcount": "@{if(equals(body('Parse_Results')?['Validators']?['PimRoleSettings']?['Status'], 'Skipped'), 3, 4)}",
              "fsi_baselineid": "@{if(equals(body('Parse_Results')?['Drift']?['IsFirstRun'], true), '', body('Parse_Results')?['Drift']?['BaselineDate'])}",
              "fsi_remediationhint": "@{if(equals(body('Parse_Results')?['AlertRequired'], true), body('Parse_Results')?['Reason'], '')}"
            }
          },
          "description": "Write validation results to Dataverse immutable audit trail via Dataverse connector (DLP-governed)"
        },
        "Check_Alert_Required": {
          "runAfter": {
            "Write_Validation_History": ["Succeeded", "Failed"]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Parse_Results')?['AlertRequired']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Check_Severity_For_Teams": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@body('Parse_Results')?['OverallStatus']",
                      "Failed"
                    ]
                  },
                  {
                    "equals": [
                      "@body('Parse_Results')?['OverallStatus']",
                      "Error"
                    ]
                  }
                ]
              },
              "actions": {
                "Post_Teams_Card": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['teams']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v1.0/teams/@{variables('TeamsTeamId')}/channels/@{variables('TeamsChannelId')}/messages",
                    "body": {
                      "rootMessage": {
                        "body": {
                          "contentType": "html",
                          "content": "<attachment id=\"adaptive-card\"></attachment>"
                        },
                        "attachments": [
                          {
                            "contentType": "application/vnd.microsoft.card.adaptive",
                            "content": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace('{\"type\":\"AdaptiveCard\",\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"attention\",\"items\":[{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"[ALERT] Session Security Drift\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"color\":\"Attention\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"${overallStatus}\",\"weight\":\"Bolder\",\"horizontalAlignment\":\"Right\",\"color\":\"Attention\"}]}]},{\"type\":\"TextBlock\",\"text\":\"${timestamp}\",\"size\":\"Small\",\"isSubtle\":true,\"spacing\":\"Small\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Drift Detected\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"wrap\":true,\"spacing\":\"Medium\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Severity\",\"value\":\"${overallStatus}\"},{\"title\":\"Zone\",\"value\":\"${zone}\"},{\"title\":\"Drift From\",\"value\":\"${baselineStatus} → ${currentStatus}\"},{\"title\":\"Baseline Date\",\"value\":\"${baselineDate}\"}],\"spacing\":\"Medium\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Reason\",\"weight\":\"Bolder\",\"spacing\":\"Medium\"},{\"type\":\"TextBlock\",\"text\":\"${reason}\",\"wrap\":true,\"spacing\":\"Small\"}]},{\"type\":\"Container\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Validator Status\",\"weight\":\"Bolder\",\"spacing\":\"Medium\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Session Controls\",\"value\":\"${sessionControlsStatus}\"},{\"title\":\"Auth Strength\",\"value\":\"${authStrengthStatus}\"},{\"title\":\"PIM Settings\",\"value\":\"${pimStatus}\"},{\"title\":\"Break-Glass\",\"value\":\"${breakGlassStatus}\"}],\"spacing\":\"Small\"}]}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"View in Power Platform\",\"url\":\"https://make.powerapps.com\"},{\"type\":\"Action.OpenUrl\",\"title\":\"View Validation History\",\"url\":\"${validationHistoryUrl}\"}]}', '${overallStatus}', replace(string(body('Parse_Results')?['OverallStatus']), '\"', '\\\"')), '${timestamp}', replace(string(body('Parse_Results')?['Timestamp']), '\"', '\\\"')), '${zone}', replace(string(body('Parse_Results')?['Zone']), '\"', '\\\"')), '${baselineStatus}', if(equals(body('Parse_Results')?['Drift']?['BaselineStatus'], null), 'N/A (first run)', replace(string(body('Parse_Results')?['Drift']?['BaselineStatus']), '\"', '\\\"'))), '${currentStatus}', replace(string(body('Parse_Results')?['Drift']?['CurrentStatus']), '\"', '\\\"')), '${baselineDate}', if(equals(body('Parse_Results')?['Drift']?['BaselineDate'], null), 'N/A (first run)', replace(string(body('Parse_Results')?['Drift']?['BaselineDate']), '\"', '\\\"'))), '${reason}', replace(replace(string(body('Parse_Results')?['Reason']), '\\', '\\\\'), '\"', '\\\"')), '${sessionControlsStatus}', replace(string(body('Parse_Results')?['Validators']?['SessionControls']?['Status']), '\"', '\\\"')), '${authStrengthStatus}', replace(string(body('Parse_Results')?['Validators']?['AuthenticationStrength']?['Status']), '\"', '\\\"')), '${pimStatus}', replace(string(body('Parse_Results')?['Validators']?['PimRoleSettings']?['Status']), '\"', '\\\"')), '${breakGlassStatus}', replace(string(body('Parse_Results')?['Validators']?['BreakGlassExclusions']?['Status']), '\"', '\\\"')), '${validationHistoryUrl}', concat(variables('DataverseUrl'), '/main.aspx?etn=fsi_validationhistory&pagetype=entitylist'))"
                          }
                        ]
                      }
                    }
                  },
                  "description": "Post adaptive card to Teams for Failed/Error severity",
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT10S",
                    "minimumInterval": "PT10S",
                    "maximumInterval": "PT30M"
                  }
                }
              },
              "description": "Only post Teams card for Failed or Error status"
            },
            "Send_Alert_Email": {
              "runAfter": {
                "Check_Severity_For_Teams": ["Succeeded", "Failed", "Skipped"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@variables('ComplianceDistributionList')",
                  "Subject": "[ALERT] Session Security Drift - @{body('Parse_Results')?['Zone']} - @{body('Parse_Results')?['OverallStatus']}",
                  "Body": "<h3>Session Security Drift Detected</h3><table><tr><td><strong>Zone:</strong></td><td>@{body('Parse_Results')?['Zone']}</td></tr><tr><td><strong>Status:</strong></td><td>@{body('Parse_Results')?['OverallStatus']}</td></tr><tr><td><strong>Baseline Status:</strong></td><td>@{body('Parse_Results')?['Drift']?['BaselineStatus']}</td></tr><tr><td><strong>Current Status:</strong></td><td>@{body('Parse_Results')?['Drift']?['CurrentStatus']}</td></tr><tr><td><strong>Baseline Date:</strong></td><td>@{body('Parse_Results')?['Drift']?['BaselineDate']}</td></tr><tr><td><strong>Reason:</strong></td><td>@{body('Parse_Results')?['Reason']}</td></tr></table><h4>Validator Results</h4><ul><li><strong>Session Controls:</strong> @{body('Parse_Results')?['Validators']?['SessionControls']?['Status']}</li><li><strong>Auth Strength:</strong> @{body('Parse_Results')?['Validators']?['AuthenticationStrength']?['Status']}</li><li><strong>PIM Settings:</strong> @{body('Parse_Results')?['Validators']?['PimRoleSettings']?['Status']}</li><li><strong>Break-Glass:</strong> @{body('Parse_Results')?['Validators']?['BreakGlassExclusions']?['Status']}</li></ul><p><a href=\"@{variables('DataverseUrl')}/main.aspx\">View Validation History</a></p>",
                  "Importance": "@if(or(equals(body('Parse_Results')?['OverallStatus'], 'Failed'), equals(body('Parse_Results')?['OverallStatus'], 'Error')), 'High', 'Normal')"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT10S",
                "minimumInterval": "PT10S",
                "maximumInterval": "PT30M"
              },
              "description": "Send email alert to compliance distribution list"
            }
          },
          "description": "Send alerts if drift detected"
        },
        "Notify_Audit_Write_Failure": {
          "runAfter": {
            "Write_Validation_History": ["Failed"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@variables('ComplianceDistributionList')",
              "Subject": "[CRITICAL] Validation History Write Failed - @{body('Parse_Results')?['Zone']}",
              "Body": "<p><strong>Dataverse audit trail write failed</strong></p><p>The validation completed but the result could not be persisted to fsi_validationhistories after 4 retry attempts.</p><p>Zone: @{body('Parse_Results')?['Zone']}<br>Status: @{body('Parse_Results')?['OverallStatus']}<br>Timestamp: @{utcNow('o')}</p><p>Manual investigation required to ensure audit trail completeness.</p>",
              "Importance": "High"
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT30M"
          },
          "description": "Notify compliance team when validation history Dataverse write fails"
        }
      },
      "runAfter": {
        "Initialize_Zone": ["Succeeded"]
      },
      "type": "Scope",
      "description": "Main validation execution scope with error handling"
    },
    "Scope_Catch": {
      "actions": {
        "Write_Error_Validation_History": {
          "runAfter": {},
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_commondataserviceforapps']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(variables('DataverseUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('fsi_validationhistories'))}/items",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT30M"
            },
            "body": {
              "fsi_name": "@{variables('Zone')}-@{utcNow('o')}-FlowError",
              "fsi_runid": "@{guid()}",
              "fsi_zone": "@{if(equals(variables('Zone'), 'Zone1'), 100000001, if(equals(variables('Zone'), 'Zone2'), 100000002, 100000003))}",
              "fsi_severity": 5,
              "fsi_validationtype": 6,
              "fsi_rawvalue": "@{take(string(result('Scope_Try')), 99000)}",
              "fsi_reason": "Flow execution error in Scope_Try. Review flow run history for details.",
              "fsi_timestamp": "@{utcNow('o')}",
              "fsi_checkcount": 0,
              "fsi_remediationhint": "Flow-level error occurred. Check connector configuration, expression evaluation, and timeout settings."
            }
          },
          "description": "Write flow-level error record to Dataverse audit trail to prevent gaps in validation history"
        },
        "Notify_Error_Write_Failure": {
          "runAfter": {
            "Write_Error_Validation_History": ["Failed"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@variables('ComplianceDistributionList')",
              "Subject": "[CRITICAL] Error Validation History Write Failed - @{variables('Zone')}",
              "Body": "<p><strong>Dataverse audit trail write failed (error-handling path)</strong></p><p>The Write_Error_Validation_History action in Scope_Catch could not persist the flow error record to fsi_validationhistories.</p><p>Zone: @{variables('Zone')}<br>Timestamp: @{utcNow('o')}</p><p>Manual investigation required to ensure audit trail completeness.</p>",
              "Importance": "High"
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT30M"
          },
          "description": "Notify compliance team when error validation history Dataverse write fails"
        },
        "Send_Error_Email": {
          "runAfter": {
            "Write_Error_Validation_History": ["Succeeded", "Failed"]
          },
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@variables('ComplianceDistributionList')",
              "Subject": "[CRITICAL] Session Security Validation Flow Error",
              "Body": "<p><strong>Flow execution encountered an error</strong></p><p>Flow Name: SSC - Session Validation (Daily)<br>Zone: @{variables('Zone')}<br>Timestamp: @{utcNow('o')}</p><p>Review flow run history for details.</p>",
              "Importance": "High"
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S",
            "minimumInterval": "PT10S",
            "maximumInterval": "PT30M"
          },
          "description": "Send error notification on flow failure"
        }
      },
      "runAfter": {
        "Scope_Try": ["Failed", "Skipped", "TimedOut"]
      },
      "type": "Scope",
      "description": "Error handling scope - send notification on failure"
    }
  },
  "outputs": {}
}
