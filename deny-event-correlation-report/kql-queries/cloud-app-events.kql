// ============================================================================
// Defender CloudAppEvents - KQL Query for Microsoft Defender
// FSI Agent Governance Framework
// ============================================================================
//
// Purpose: Query Defender CloudAppEvents for Copilot prompt injection (XPIA),
//          jailbreak, and other prompt-shield threat detections.
// Data Source: CloudAppEvents table in Microsoft Defender Advanced Hunting
//
// Prerequisites:
//   - Microsoft Defender for Cloud Apps license
//   - Advanced Hunting access in Microsoft 365 Defender portal
//
// SCHEMA NOTES (verify against your tenant before relying on results):
//   - Public ActionType for Copilot prompt activity is `CopilotInteraction`.
//     The `CopilotMessageCreated` literal in earlier docs is not part of the
//     public schema and is omitted.
//   - Threat enrichment lives in `RawEventData.ThreatCategory` (string).
//     Known values include: PromptInjection, Jailbreak, XPIA. Boolean fields
//     `XPIADetected`/`JailbreakDetected` are NOT part of the public schema
//     and are not used in these queries.
// ============================================================================

// -----------------------------------------------------------------------------
// Query 1: Prompt-shield detections (Last 24 Hours)
// -----------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| where ActionType == "CopilotInteraction"
| extend parsedFields = parse_json(RawEventData)
| extend ThreatCategory = tostring(parsedFields.ThreatCategory)
| where ThreatCategory in ("PromptInjection", "Jailbreak", "XPIA")
| extend
    UserId = tostring(parsedFields.UserId),
    AgentId = tostring(parsedFields.AgentId),
    AgentName = tostring(parsedFields.AgentName),
    AppHost = tostring(parsedFields.AppHost)
| project
    Timestamp,
    UserId,
    AgentId,
    AgentName,
    AppHost,
    ActionType,
    ThreatCategory
| order by Timestamp desc

// -----------------------------------------------------------------------------
// Query 2: Threat summary by Agent (Last 7 Days)
// -----------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType == "CopilotInteraction"
| extend parsedFields = parse_json(RawEventData)
| extend ThreatCategory = tostring(parsedFields.ThreatCategory)
| where ThreatCategory in ("PromptInjection", "Jailbreak", "XPIA")
| extend
    AgentId = tostring(parsedFields.AgentId),
    AgentName = tostring(parsedFields.AgentName),
    UserId = tostring(parsedFields.UserId)
| summarize
    TotalEvents = count(),
    PromptInjectionCount = countif(ThreatCategory == "PromptInjection"),
    JailbreakCount = countif(ThreatCategory == "Jailbreak"),
    XPIACount = countif(ThreatCategory == "XPIA"),
    UniqueUsers = dcount(UserId)
    by AgentId, AgentName, bin(Timestamp, 1d)
| order by TotalEvents desc

// -----------------------------------------------------------------------------
// Query 3: Hourly Trend (Last 24 Hours)
// -----------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(24h)
| where ActionType == "CopilotInteraction"
| extend parsedFields = parse_json(RawEventData)
| extend ThreatCategory = tostring(parsedFields.ThreatCategory)
| where ThreatCategory in ("PromptInjection", "Jailbreak", "XPIA")
| summarize EventCount = count() by ThreatCategory, bin(Timestamp, 1h)
| order by Timestamp asc