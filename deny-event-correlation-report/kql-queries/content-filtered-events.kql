// ============================================================================
// RAI Content Filtered Events - KQL Query for Application Insights
// FSI Agent Governance Framework
// ============================================================================
//
// Purpose: Query Copilot Studio ContentFiltered events from RAI telemetry
// Data Sources:
//   - Application Insights classic Logs: customEvents / timestamp / name / customDimensions
//   - Workspace-based Azure Monitor Logs: AppEvents / TimeGenerated / Name / Properties
//
// Prerequisites:
//   - Azure Application Insights resource
//   - Copilot Studio agents configured with App Insights connection string
//
// SOURCE NORMALIZATION:
//   Microsoft Learn currently documents `customEvents` for Copilot Studio's
//   Application Insights Logs experience and `AppEvents` for workspace-based
//   Azure Monitor Logs. Include the source block below before each query, then
//   use the normalized column names: EventTime, EventName, Dimensions.
// ============================================================================

let ContentFilteredEvents =
    union isfuzzy=true
        (customEvents
         | project EventTime = timestamp, EventName = name, Dimensions = todynamic(customDimensions)),
        (AppEvents
         | project EventTime = TimeGenerated, EventName = Name, Dimensions = todynamic(Properties))
    | where EventName == "MicrosoftCopilotStudio"
    | extend eventType = tostring(Dimensions["EventType"])
    | where eventType == "ContentFiltered"
    | extend
        agentId = tostring(Dimensions["BotId"]),
        agentName = tostring(Dimensions["BotName"]),
        sessionId = tostring(Dimensions["ConversationId"]),
        turnId = tostring(Dimensions["TurnId"]),
        filterReason = tostring(Dimensions["FilterReason"]),
        filterCategory = tostring(Dimensions["FilterCategory"]),
        filterSeverity = tostring(Dimensions["FilterSeverity"]),
        userId = tostring(Dimensions["UserId"]);

// -----------------------------------------------------------------------------
// Query 1: All ContentFiltered Events (Last 24 Hours)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(24h)
| project
    timestamp = EventTime,
    agentId,
    agentName,
    sessionId,
    turnId,
    userId,
    filterReason,
    filterCategory,
    filterSeverity
| order by timestamp desc

// -----------------------------------------------------------------------------
// Query 2: Summary by Filter Category (Last 7 Days)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(7d)
| summarize
    FilterCount = count(),
    HighSeverityCount = countif(filterSeverity == "High"),
    UniqueAgents = dcount(agentId),
    UniqueSessions = dcount(sessionId)
    by filterCategory
| order by FilterCount desc

// -----------------------------------------------------------------------------
// Query 3: High Severity Events (Last 24 Hours) - For Alerting
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(24h)
| where filterSeverity == "High"
| project
    timestamp = EventTime,
    agentId,
    agentName,
    filterReason,
    filterCategory
| order by timestamp desc

// -----------------------------------------------------------------------------
// Query 4: Filter Events by Agent (Last 7 Days)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(7d)
| summarize
    TotalFilters = count(),
    HighSeverity = countif(filterSeverity == "High"),
    MediumSeverity = countif(filterSeverity == "Medium"),
    LowSeverity = countif(filterSeverity == "Low"),
    UniqueSessions = dcount(sessionId)
    by agentId, agentName
| order by TotalFilters desc

// -----------------------------------------------------------------------------
// Query 5: Hourly Trend (Last 24 Hours)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(24h)
| summarize FilterCount = count() by bin(EventTime, 1h)
| order by EventTime desc
| render timechart

// -----------------------------------------------------------------------------
// Query 6: Filter Category Distribution Over Time (Last 30 Days)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(30d)
| summarize FilterCount = count() by filterCategory, bin(EventTime, 1d)
| order by EventTime desc
| render areachart

// -----------------------------------------------------------------------------
// Query 7: Session Analysis - Repeat Filters
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(7d)
| extend severityRank = case(
    filterSeverity == "High", 3,
    filterSeverity == "Medium", 2,
    filterSeverity == "Low", 1,
    0)
| summarize
    FilterCount = count(),
    FilterCategories = make_set(filterCategory),
    MaxSeverityRank = max(severityRank)
    by sessionId, agentId
| extend MaxSeverity = case(
    MaxSeverityRank == 3, "High",
    MaxSeverityRank == 2, "Medium",
    MaxSeverityRank == 1, "Low",
    "Unknown")
| where FilterCount >= 3  // Sessions with multiple filters
| order by FilterCount desc
| take 50

// -----------------------------------------------------------------------------
// Query 8: 15-Minute Alert Query (Zone 3 SLA)
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(15m)
| where filterSeverity == "High"
| summarize AlertCount = count()
| where AlertCount > 0

// -----------------------------------------------------------------------------
// Query 9: Export for Correlation (Last 24 Hours)
// Use this query for PowerShell extraction via REST API or Log Analytics export
// -----------------------------------------------------------------------------
ContentFilteredEvents
| where EventTime > ago(24h)
| project
    timestamp = EventTime,
    agentId,
    agentName,
    sessionId,
    turnId,
    filterReason,
    filterCategory,
    filterSeverity,
    userId
