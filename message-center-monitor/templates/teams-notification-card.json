{
  "_comment": "SHARED adaptive card template — rendered by BOTH the Phase 1 PowerShell sync (Send-McmTeamsWebhook in scripts/governance/_Common.ps1) and the Phase 3 Power Automate flow (Action.OpenUrl URL template substitution). Do NOT rename, restructure, or remove tokens without coordinating both paths — see docs/poc-quickstart.md (PS path) and docs/flow-configuration.md (flow path). Token contract: {severity}, {title}, {category}, {services}, {startDateTime}, {actionRequiredByDateTime}, {id} are supplied per-message; {environment}, {appId}, {publisherPrefix}, {recordId} are tenant- or response-bound (PS sync extracts {recordId} from the Dataverse upsert OData-EntityId response header; the flow binds it from the Dataverse upsert action output). Curly braces ({}) are the token delimiter — bracket placeholders ([]) are NOT substituted by either path.",
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Message Center Alert",
                  "weight": "Bolder",
                  "size": "Medium",
                  "color": "Attention"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "{severity}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "color": "Attention"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "{title}",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true,
          "spacing": "Medium"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Category",
              "value": "{category}"
            },
            {
              "title": "Services",
              "value": "{services}"
            },
            {
              "title": "Published",
              "value": "{startDateTime}"
            },
            {
              "title": "Action Required By",
              "value": "{actionRequiredByDateTime}"
            },
            {
              "title": "Message ID",
              "value": "{id}"
            }
          ],
          "spacing": "Medium"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "This post may impact your AI agent deployments. Please review and assess.",
          "wrap": true,
          "spacing": "Medium",
          "isSubtle": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "View in Admin Center",
      "url": "https://admin.microsoft.com/Adminportal/Home#/MessageCenter/:/messages/{id}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "View Documentation",
      "url": "https://learn.microsoft.com/en-us/microsoft-365/admin/manage/message-center"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Assess Record",
      "url": "https://{environment}.crm.dynamics.com/main.aspx?appid={appId}&pagetype=entityrecord&etn={publisherPrefix}_messagecenterlog&id={recordId}"
    }
  ]
}
