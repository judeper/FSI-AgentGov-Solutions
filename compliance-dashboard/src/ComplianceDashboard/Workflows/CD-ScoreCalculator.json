{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "fsi_CD_NotificationEmail": {
      "defaultValue": "",
      "type": "String",
      "metadata": {
        "schemaName": "fsi_CD_NotificationEmail",
        "description": "Email address for compliance notifications"
      }
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-01-01T06:00:00Z",
        "timeZone": "UTC"
      },
      "type": "Recurrence",
      "operationOptions": "SingleInstance"
    }
  },
  "actions": {
    "Initialize_TotalWeightedScore": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TotalWeightedScore",
            "type": "float",
            "value": 0.0
          }
        ]
      }
    },
    "Initialize_TotalWeight": {
      "runAfter": {
        "Initialize_TotalWeightedScore": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TotalWeight",
            "type": "float",
            "value": 0.0
          }
        ]
      }
    },
    "Initialize_PillarScores": {
      "runAfter": {
        "Initialize_TotalWeight": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "PillarScores",
            "type": "object",
            "value": {
              "1": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "2": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "3": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "4": {
                "weightedSum": 0.0,
                "weight": 0.0
              }
            }
          }
        ]
      }
    },
    "Initialize_ZoneScores": {
      "runAfter": {
        "Initialize_PillarScores": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ZoneScores",
            "type": "object",
            "value": {
              "1": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "2": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "3": {
                "weightedSum": 0.0,
                "weight": 0.0
              }
            }
          }
        ]
      }
    },
    "Initialize_StatusCounts": {
      "runAfter": {
        "Initialize_ZoneScores": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "StatusCounts",
            "type": "object",
            "value": {
              "compliant": 0,
              "partial": 0,
              "noncompliant": 0
            }
          }
        ]
      }
    },
    "Initialize_ProcessedControls": {
      "runAfter": {
        "Initialize_StatusCounts": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ProcessedControls",
            "type": "object",
            "value": {}
          }
        ]
      }
    },
    "Initialize_ItemErrorCount": {
      "runAfter": {
        "Initialize_ProcessedControls": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ItemErrorCount",
            "type": "integer",
            "value": 0
          }
        ]
      }
    },
    "List_Control_Assessments": {
      "runAfter": {
        "Initialize_ItemErrorCount": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_controlassessments",
          "$select": "fsi_controlassessmentid,fsi_assessmentdate,fsi_status,fsi_zone,fsi_score",
          "$expand": "fsi_controlmasterid($select=fsi_controlid,fsi_pillar,fsi_weight)",
          "$filter": "fsi_assessmentdate ge @{formatDateTime(addDays(utcNow(), -365), 'yyyy-MM-dd')}",
          "$orderby": "fsi_assessmentdate desc"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        },
        "retryPolicy": {
          "count": 3,
          "type": "exponential",
          "interval": "PT10S",
          "maximumInterval": "PT1H"
        }
      }
    },
    "Apply_to_each_Assessment": {
      "foreach": "@outputs('List_Control_Assessments')?['body/value']",
      "actions": {
        "Scope_Process_Assessment": {
          "runAfter": {},
          "type": "Scope",
          "actions": {
        "Condition_Not_Already_Processed": {
          "actions": {
            "Condition_Status_Not_NA": {
          "actions": {
            "Get_Control_Weight": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@coalesce(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_weight'], 0)"
            },
            "Get_Zone_Multiplier": {
              "runAfter": {
                "Get_Control_Weight": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(equals(items('Apply_to_each_Assessment')?['fsi_zone'], 3), 2.0, if(equals(items('Apply_to_each_Assessment')?['fsi_zone'], 2), 1.5, 1.0))"
            },
            "Calculate_Weighted_Score": {
              "runAfter": {
                "Get_Zone_Multiplier": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@mul(mul(items('Apply_to_each_Assessment')?['fsi_score'], outputs('Get_Control_Weight')), outputs('Get_Zone_Multiplier'))"
            },
            "Increment_TotalWeightedScore": {
              "runAfter": {
                "Calculate_Weighted_Score": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "TotalWeightedScore",
                "value": "@outputs('Calculate_Weighted_Score')"
              }
            },
            "Increment_TotalWeight": {
              "runAfter": {
                "Increment_TotalWeightedScore": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "TotalWeight",
                "value": "@mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))"
              }
            },
            "Update_Status_Counts": {
              "runAfter": {
                "Increment_TotalWeight": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "StatusCounts",
                "value": "@if(equals(items('Apply_to_each_Assessment')?['fsi_status'], 1), setProperty(variables('StatusCounts'), 'compliant', add(variables('StatusCounts')?['compliant'], 1)), if(equals(items('Apply_to_each_Assessment')?['fsi_status'], 2), setProperty(variables('StatusCounts'), 'partial', add(variables('StatusCounts')?['partial'], 1)), setProperty(variables('StatusCounts'), 'noncompliant', add(variables('StatusCounts')?['noncompliant'], 1))))"
              }
            },
            "Get_Pillar_Key": {
              "runAfter": {
                "Update_Status_Counts": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@string(coalesce(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_pillar'], 0))"
            },
            "Update_PillarScores": {
              "runAfter": {
                "Get_Pillar_Key": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "PillarScores",
                "value": "@setProperty(variables('PillarScores'), outputs('Get_Pillar_Key'), json(concat('{\"weightedSum\":', string(add(variables('PillarScores')?[outputs('Get_Pillar_Key')]?['weightedSum'], outputs('Calculate_Weighted_Score'))), ',\"weight\":', string(add(variables('PillarScores')?[outputs('Get_Pillar_Key')]?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier')))), '}')))"
              }
            },
            "Get_Zone_Key": {
              "runAfter": {
                "Update_PillarScores": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@string(items('Apply_to_each_Assessment')?['fsi_zone'])"
            },
            "Update_ZoneScores": {
              "runAfter": {
                "Get_Zone_Key": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "ZoneScores",
                "value": "@setProperty(variables('ZoneScores'), outputs('Get_Zone_Key'), json(concat('{\"weightedSum\":', string(add(variables('ZoneScores')?[outputs('Get_Zone_Key')]?['weightedSum'], outputs('Calculate_Weighted_Score'))), ',\"weight\":', string(add(variables('ZoneScores')?[outputs('Get_Zone_Key')]?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier')))), '}')))"
              }
            }
          },
          "runAfter": {},
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@items('Apply_to_each_Assessment')?['fsi_status']",
                    4
                  ]
                }
              }
            ]
          },
          "type": "If"
            },
            "Mark_Control_Processed": {
              "runAfter": {
                "Condition_Status_Not_NA": [
                  "Succeeded",
                  "Skipped"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "ProcessedControls",
                "value": "@setProperty(variables('ProcessedControls'), concat(coalesce(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_controlmasterid'], 'null'), '_', string(coalesce(items('Apply_to_each_Assessment')?['fsi_zone'], 0))), true)"
              }
            }
          },
          "runAfter": {},
          "expression": {
            "equals": [
              "@coalesce(variables('ProcessedControls')?[concat(coalesce(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_controlmasterid'], 'null'), '_', string(coalesce(items('Apply_to_each_Assessment')?['fsi_zone'], 0)))], false)",
              false
            ]
          },
          "type": "If"
        }
          }
        },
        "Increment_ItemErrorCount": {
          "runAfter": {
            "Scope_Process_Assessment": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "IncrementVariable",
          "inputs": {
            "name": "ItemErrorCount",
            "value": 1
          },
          "description": "Track per-item processing errors for post-loop notification"
        }
      },
      "runAfter": {
        "List_Control_Assessments": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      }
    },
    "Condition_Item_Processing_Errors": {
      "runAfter": {
        "Apply_to_each_Assessment": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "greater": [
              "@variables('ItemErrorCount')",
              0
            ]
          },
          {
            "not": {
              "equals": [
                "@parameters('fsi_CD_NotificationEmail')",
                ""
              ]
            }
          }
        ]
      },
      "type": "If",
      "actions": {
        "Send_Item_Error_Notification": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_outlook",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{parameters('fsi_CD_NotificationEmail')}",
                "Subject": "WARNING: Score Calculator - @{variables('ItemErrorCount')} assessments failed processing",
                "Body": "<p><strong style='color:orange;'>Per-item processing errors detected.</strong></p><p><strong>Failed Items:</strong> @{variables('ItemErrorCount')}</p><p>One or more control assessments could not be processed (possible causes: deleted control master records, null navigation properties, or transient Dataverse errors). The overall compliance score may be incomplete. Review flow run history for details.</p><p><strong>Timestamp:</strong> @{utcNow()}</p>",
                "Importance": "High"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "retryPolicy": {
              "count": 3,
              "type": "exponential",
              "interval": "PT10S",
              "maximumInterval": "PT1H"
            }
          }
        }
      },
      "description": "Notify when individual assessments failed processing during the loop"
    },
    "Calculate_Overall_Score": {
      "runAfter": {
        "Condition_Item_Processing_Errors": [
          "Succeeded",
          "Skipped"
        ]
      },
      "type": "Compose",
      "inputs": "@if(greater(variables('TotalWeight'), 0), div(variables('TotalWeightedScore'), variables('TotalWeight')), 0)"
    },
    "Get_Open_Exception_Count": {
      "runAfter": {
        "Calculate_Overall_Score": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_complianceexceptions",
          "$select": "fsi_complianceexceptionid",
          "$filter": "fsi_exceptionstatus eq 1 or fsi_exceptionstatus eq 2 or fsi_exceptionstatus eq 3"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        },
        "retryPolicy": {
          "count": 3,
          "type": "exponential",
          "interval": "PT10S",
          "maximumInterval": "PT1H"
        }
      }
    },
    "Check_Existing_Score_Today": {
      "runAfter": {
        "Get_Open_Exception_Count": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "fsi_cr_dataverse",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_compliancescores",
          "$filter": "fsi_scoredate eq @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
          "$select": "fsi_compliancescoreid",
          "$top": 1
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "retryPolicy": {
          "count": 3,
          "type": "exponential",
          "interval": "PT10S",
          "maximumInterval": "PT1H"
        }
      }
    },
    "Condition_Score_Record_Exists": {
      "runAfter": {
        "Check_Existing_Score_Today": [
          "Succeeded"
        ]
      },
      "expression": {
        "greater": [
          "@length(outputs('Check_Existing_Score_Today')?['body/value'])",
          0
        ]
      },
      "type": "If",
      "actions": {
        "Update_Existing_Score_Record": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_dataverse",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_compliancescores",
              "recordId": "@first(outputs('Check_Existing_Score_Today')?['body/value'])?['fsi_compliancescoreid']",
              "item": {
                "fsi_name": "Compliance Score @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                "fsi_overallscore": "@outputs('Calculate_Overall_Score')",
                "fsi_pillar1score": "@if(greater(variables('PillarScores')?['1']?['weight'], 0), div(variables('PillarScores')?['1']?['weightedSum'], variables('PillarScores')?['1']?['weight']), 0)",
                "fsi_pillar2score": "@if(greater(variables('PillarScores')?['2']?['weight'], 0), div(variables('PillarScores')?['2']?['weightedSum'], variables('PillarScores')?['2']?['weight']), 0)",
                "fsi_pillar3score": "@if(greater(variables('PillarScores')?['3']?['weight'], 0), div(variables('PillarScores')?['3']?['weightedSum'], variables('PillarScores')?['3']?['weight']), 0)",
                "fsi_pillar4score": "@if(greater(variables('PillarScores')?['4']?['weight'], 0), div(variables('PillarScores')?['4']?['weightedSum'], variables('PillarScores')?['4']?['weight']), 0)",
                "fsi_zone1score": "@if(greater(variables('ZoneScores')?['1']?['weight'], 0), div(variables('ZoneScores')?['1']?['weightedSum'], variables('ZoneScores')?['1']?['weight']), 0)",
                "fsi_zone2score": "@if(greater(variables('ZoneScores')?['2']?['weight'], 0), div(variables('ZoneScores')?['2']?['weightedSum'], variables('ZoneScores')?['2']?['weight']), 0)",
                "fsi_zone3score": "@if(greater(variables('ZoneScores')?['3']?['weight'], 0), div(variables('ZoneScores')?['3']?['weightedSum'], variables('ZoneScores')?['3']?['weight']), 0)",
                "fsi_compliantcount": "@variables('StatusCounts')?['compliant']",
                "fsi_partialcount": "@variables('StatusCounts')?['partial']",
                "fsi_noncompliantcount": "@variables('StatusCounts')?['noncompliant']",
                "fsi_exceptioncount": "@length(outputs('Get_Open_Exception_Count')?['body/value'])"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "retryPolicy": {
              "count": 3,
              "type": "exponential",
              "interval": "PT10S",
              "maximumInterval": "PT1H"
            }
          }
        }
      },
      "else": {
        "actions": {
          "Create_Compliance_Score_Record": {
            "runAfter": {},
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "fsi_cr_dataverse",
                "operationId": "CreateRecord",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "fsi_compliancescores",
                "item": {
                  "fsi_name": "Compliance Score @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                  "fsi_scoredate": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
                  "fsi_overallscore": "@outputs('Calculate_Overall_Score')",
                  "fsi_pillar1score": "@if(greater(variables('PillarScores')?['1']?['weight'], 0), div(variables('PillarScores')?['1']?['weightedSum'], variables('PillarScores')?['1']?['weight']), 0)",
                  "fsi_pillar2score": "@if(greater(variables('PillarScores')?['2']?['weight'], 0), div(variables('PillarScores')?['2']?['weightedSum'], variables('PillarScores')?['2']?['weight']), 0)",
                  "fsi_pillar3score": "@if(greater(variables('PillarScores')?['3']?['weight'], 0), div(variables('PillarScores')?['3']?['weightedSum'], variables('PillarScores')?['3']?['weight']), 0)",
                  "fsi_pillar4score": "@if(greater(variables('PillarScores')?['4']?['weight'], 0), div(variables('PillarScores')?['4']?['weightedSum'], variables('PillarScores')?['4']?['weight']), 0)",
                  "fsi_zone1score": "@if(greater(variables('ZoneScores')?['1']?['weight'], 0), div(variables('ZoneScores')?['1']?['weightedSum'], variables('ZoneScores')?['1']?['weight']), 0)",
                  "fsi_zone2score": "@if(greater(variables('ZoneScores')?['2']?['weight'], 0), div(variables('ZoneScores')?['2']?['weightedSum'], variables('ZoneScores')?['2']?['weight']), 0)",
                  "fsi_zone3score": "@if(greater(variables('ZoneScores')?['3']?['weight'], 0), div(variables('ZoneScores')?['3']?['weightedSum'], variables('ZoneScores')?['3']?['weight']), 0)",
                  "fsi_compliantcount": "@variables('StatusCounts')?['compliant']",
                  "fsi_partialcount": "@variables('StatusCounts')?['partial']",
                  "fsi_noncompliantcount": "@variables('StatusCounts')?['noncompliant']",
                  "fsi_exceptioncount": "@length(outputs('Get_Open_Exception_Count')?['body/value'])"
                }
              },
              "authentication": "@parameters('$authentication')"
            },
            "runtimeConfiguration": {
              "retryPolicy": {
                "count": 3,
                "type": "exponential",
                "interval": "PT10S",
                "maximumInterval": "PT1H"
              }
            }
          }
        }
      }
    },
    "Condition_Notify_Failure": {
      "runAfter": {
        "Condition_Score_Record_Exists": [
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "expression": {
        "not": {
          "equals": [
            "@parameters('fsi_CD_NotificationEmail')",
            ""
          ]
        }
      },
      "type": "If",
      "actions": {
        "Send_Failure_Notification": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "fsi_cr_outlook",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{parameters('fsi_CD_NotificationEmail')}",
                "Subject": "FAILED: Compliance Score Calculation - @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                "Body": "<p><strong style='color:red;'>Compliance score calculation failed.</strong></p><p>The CD-ScoreCalculator flow encountered an error during execution. Please review the flow run history in Power Automate for details.</p><p><strong>Timestamp:</strong> @{utcNow()}</p>",
                "Importance": "High"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "retryPolicy": {
              "count": 3,
              "type": "exponential",
              "interval": "PT10S",
              "maximumInterval": "PT1H"
            }
          }
        }
      },
      "description": "Only send failure notification if notification email is configured"
    }
  },
  "outputs": {},
  "description": "CD-ScoreCalculator: Calculates daily compliance scores from control assessments"
}
