{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-01-01T06:00:00Z",
        "timeZone": "UTC"
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Initialize_TotalWeightedScore": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TotalWeightedScore",
            "type": "float",
            "value": 0.0
          }
        ]
      }
    },
    "Initialize_TotalWeight": {
      "runAfter": {
        "Initialize_TotalWeightedScore": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TotalWeight",
            "type": "float",
            "value": 0.0
          }
        ]
      }
    },
    "Initialize_PillarScores": {
      "runAfter": {
        "Initialize_TotalWeight": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "PillarScores",
            "type": "object",
            "value": {
              "1": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "2": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "3": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "4": {
                "weightedSum": 0.0,
                "weight": 0.0
              }
            }
          }
        ]
      }
    },
    "Initialize_ZoneScores": {
      "runAfter": {
        "Initialize_PillarScores": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ZoneScores",
            "type": "object",
            "value": {
              "1": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "2": {
                "weightedSum": 0.0,
                "weight": 0.0
              },
              "3": {
                "weightedSum": 0.0,
                "weight": 0.0
              }
            }
          }
        ]
      }
    },
    "Initialize_StatusCounts": {
      "runAfter": {
        "Initialize_ZoneScores": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "StatusCounts",
            "type": "object",
            "value": {
              "compliant": 0,
              "partial": 0,
              "noncompliant": 0
            }
          }
        ]
      }
    },
    "Initialize_CD_NotificationEmail": {
      "runAfter": {
        "Initialize_StatusCounts": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CD_NotificationEmail",
            "type": "string",
            "value": "@parameters('fsi_CD_NotificationEmail')"
          }
        ]
      }
    },
    "Initialize_SeenControls": {
      "runAfter": {
        "Initialize_CD_NotificationEmail": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SeenControls",
            "type": "string",
            "value": ""
          }
        ]
      },
      "description": "Pipe-delimited list of control IDs already processed for deduplication (e.g., |ctrl1|ctrl2|)"
    },
    "Scope_Main": {
      "runAfter": {
        "Initialize_SeenControls": [
          "Succeeded"
        ]
      },
      "type": "Scope",
      "actions": {
        "List_Control_Assessments": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_controlassessments",
              "$select": "fsi_controlassessmentid,fsi_assessmentdate,fsi_status,fsi_zone,fsi_score",
              "$expand": "fsi_controlmasterid($select=fsi_controlid,fsi_pillar,fsi_weight)",
              "$filter": "fsi_assessmentdate ge @{formatDateTime(addDays(utcNow(), -90), 'yyyy-MM-dd')}",
              "$orderby": "fsi_assessmentdate desc"
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          },
          "description": "Pagination set to 100,000 (Power Automate maximum). TRUNCATION GUARD: If length(outputs('List_Control_Assessments')?['body/value']) equals 100,000, results are truncated — enable Dataverse archival or narrow the date-range filter."
        },
        "Apply_to_each_Assessment": {
      "foreach": "@outputs('List_Control_Assessments')?['body/value']",
      "actions": {
        "Get_Control_Key": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@concat(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_controlid'], '-', string(items('Apply_to_each_Assessment')?['fsi_zone']))",
          "description": "Unique key for control-zone deduplication"
        },
        "Condition_Not_Already_Seen": {
          "actions": {
            "Mark_Control_Seen": {
              "runAfter": {},
              "type": "SetVariable",
              "inputs": {
                "name": "SeenControls",
                "value": "@if(equals(variables('SeenControls'), ''), concat('|', outputs('Get_Control_Key'), '|'), concat(variables('SeenControls'), outputs('Get_Control_Key'), '|'))"
              }
            },
            "Condition_Status_Not_NA": {
              "actions": {
                "Get_Control_Weight": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_weight']"
                },
                "Get_Zone_Multiplier": {
                  "runAfter": {
                    "Get_Control_Weight": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(equals(items('Apply_to_each_Assessment')?['fsi_zone'], 3), 2.0, if(equals(items('Apply_to_each_Assessment')?['fsi_zone'], 2), 1.5, 1.0))"
                },
                "Calculate_Weighted_Score": {
                  "runAfter": {
                    "Get_Zone_Multiplier": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@mul(mul(items('Apply_to_each_Assessment')?['fsi_score'], outputs('Get_Control_Weight')), outputs('Get_Zone_Multiplier'))"
                },
                "Increment_TotalWeightedScore": {
                  "runAfter": {
                    "Calculate_Weighted_Score": [
                      "Succeeded"
                    ]
                  },
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "TotalWeightedScore",
                    "value": "@outputs('Calculate_Weighted_Score')"
                  }
                },
                "Increment_TotalWeight": {
                  "runAfter": {
                    "Increment_TotalWeightedScore": [
                      "Succeeded"
                    ]
                  },
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "TotalWeight",
                    "value": "@mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))"
                  }
                },
                "Update_Status_Counts": {
                  "runAfter": {
                    "Increment_TotalWeight": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "StatusCounts",
                    "value": {
                      "compliant": "@if(equals(items('Apply_to_each_Assessment')?['fsi_status'], 1), add(variables('StatusCounts')?['compliant'], 1), variables('StatusCounts')?['compliant'])",
                      "partial": "@if(equals(items('Apply_to_each_Assessment')?['fsi_status'], 2), add(variables('StatusCounts')?['partial'], 1), variables('StatusCounts')?['partial'])",
                      "noncompliant": "@if(equals(items('Apply_to_each_Assessment')?['fsi_status'], 3), add(variables('StatusCounts')?['noncompliant'], 1), variables('StatusCounts')?['noncompliant'])"
                    }
                  }
                },
                "Get_Pillar_Key": {
                  "runAfter": {
                    "Update_Status_Counts": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@string(items('Apply_to_each_Assessment')?['fsi_controlmasterid']?['fsi_pillar'])"
                },
                "Get_Zone_Key": {
                  "runAfter": {
                    "Get_Pillar_Key": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@string(items('Apply_to_each_Assessment')?['fsi_zone'])"
                },
                "Update_PillarScores": {
                  "runAfter": {
                    "Get_Zone_Key": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "PillarScores",
                    "value": {
                      "1": {
                        "weightedSum": "@if(equals(outputs('Get_Pillar_Key'), '1'), add(variables('PillarScores')?['1']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('PillarScores')?['1']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Pillar_Key'), '1'), add(variables('PillarScores')?['1']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('PillarScores')?['1']?['weight'])"
                      },
                      "2": {
                        "weightedSum": "@if(equals(outputs('Get_Pillar_Key'), '2'), add(variables('PillarScores')?['2']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('PillarScores')?['2']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Pillar_Key'), '2'), add(variables('PillarScores')?['2']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('PillarScores')?['2']?['weight'])"
                      },
                      "3": {
                        "weightedSum": "@if(equals(outputs('Get_Pillar_Key'), '3'), add(variables('PillarScores')?['3']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('PillarScores')?['3']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Pillar_Key'), '3'), add(variables('PillarScores')?['3']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('PillarScores')?['3']?['weight'])"
                      },
                      "4": {
                        "weightedSum": "@if(equals(outputs('Get_Pillar_Key'), '4'), add(variables('PillarScores')?['4']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('PillarScores')?['4']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Pillar_Key'), '4'), add(variables('PillarScores')?['4']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('PillarScores')?['4']?['weight'])"
                      }
                    }
                  }
                },
                "Update_ZoneScores": {
                  "runAfter": {
                    "Update_PillarScores": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "ZoneScores",
                    "value": {
                      "1": {
                        "weightedSum": "@if(equals(outputs('Get_Zone_Key'), '1'), add(variables('ZoneScores')?['1']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('ZoneScores')?['1']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Zone_Key'), '1'), add(variables('ZoneScores')?['1']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('ZoneScores')?['1']?['weight'])"
                      },
                      "2": {
                        "weightedSum": "@if(equals(outputs('Get_Zone_Key'), '2'), add(variables('ZoneScores')?['2']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('ZoneScores')?['2']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Zone_Key'), '2'), add(variables('ZoneScores')?['2']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('ZoneScores')?['2']?['weight'])"
                      },
                      "3": {
                        "weightedSum": "@if(equals(outputs('Get_Zone_Key'), '3'), add(variables('ZoneScores')?['3']?['weightedSum'], outputs('Calculate_Weighted_Score')), variables('ZoneScores')?['3']?['weightedSum'])",
                        "weight": "@if(equals(outputs('Get_Zone_Key'), '3'), add(variables('ZoneScores')?['3']?['weight'], mul(outputs('Get_Control_Weight'), outputs('Get_Zone_Multiplier'))), variables('ZoneScores')?['3']?['weight'])"
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "Mark_Control_Seen": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@items('Apply_to_each_Assessment')?['fsi_status']",
                        4
                      ]
                    }
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Get_Control_Key": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "not": {
                  "contains": [
                    "@variables('SeenControls')",
                    "@concat('|', outputs('Get_Control_Key'), '|')"
                  ]
                }
              }
            ]
          },
          "type": "If",
          "description": "Skip duplicate assessments — only process latest per control-zone (results ordered by date desc)"
        }
      },
      "runAfter": {
        "List_Control_Assessments": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      }
    },
    "Calculate_Overall_Score": {
      "runAfter": {
        "Apply_to_each_Assessment": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(greater(variables('TotalWeight'), 0), div(variables('TotalWeightedScore'), variables('TotalWeight')), 0)"
    },
    "Get_Open_Exception_Count": {
      "runAfter": {
        "Calculate_Overall_Score": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_complianceexceptions",
          "$select": "fsi_complianceexceptionid",
          "$filter": "fsi_exceptionstatus eq 1 or fsi_exceptionstatus eq 2 or fsi_exceptionstatus eq 3"
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 100000
        }
      },
      "description": "Pagination set to 100,000 (Power Automate maximum). TRUNCATION GUARD: If length(outputs('Get_Open_Exception_Count')?['body/value']) equals 100,000, results are truncated — enable Dataverse archival or add date-range filters to reduce result set."
    },
    "Check_Existing_Score_Today": {
      "runAfter": {
        "Get_Open_Exception_Count": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_compliancescores",
          "$select": "fsi_compliancescoreid",
          "$filter": "fsi_scoredate eq @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
          "$top": 1
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      },
      "description": "Duplicate guard: check if a score record already exists for today"
    },
    "Condition_No_Existing_Score": {
      "runAfter": {
        "Check_Existing_Score_Today": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@length(outputs('Check_Existing_Score_Today')?['body/value'])",
              0
            ]
          }
        ]
      },
      "type": "If",
      "description": "Only create a new score record if none exists for today — prevents duplicates on manual re-trigger or retry",
      "actions": {
        "Create_Compliance_Score_Record": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_compliancescores",
              "item": {
                "fsi_name": "Compliance Score @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                "fsi_scoredate": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
                "fsi_overallscore": "@outputs('Calculate_Overall_Score')",
                "fsi_pillar1score": "@if(greater(variables('PillarScores')?['1']?['weight'], 0), div(variables('PillarScores')?['1']?['weightedSum'], variables('PillarScores')?['1']?['weight']), 0)",
                "fsi_pillar2score": "@if(greater(variables('PillarScores')?['2']?['weight'], 0), div(variables('PillarScores')?['2']?['weightedSum'], variables('PillarScores')?['2']?['weight']), 0)",
                "fsi_pillar3score": "@if(greater(variables('PillarScores')?['3']?['weight'], 0), div(variables('PillarScores')?['3']?['weightedSum'], variables('PillarScores')?['3']?['weight']), 0)",
                "fsi_pillar4score": "@if(greater(variables('PillarScores')?['4']?['weight'], 0), div(variables('PillarScores')?['4']?['weightedSum'], variables('PillarScores')?['4']?['weight']), 0)",
                "fsi_zone1score": "@if(greater(variables('ZoneScores')?['1']?['weight'], 0), div(variables('ZoneScores')?['1']?['weightedSum'], variables('ZoneScores')?['1']?['weight']), 0)",
                "fsi_zone2score": "@if(greater(variables('ZoneScores')?['2']?['weight'], 0), div(variables('ZoneScores')?['2']?['weightedSum'], variables('ZoneScores')?['2']?['weight']), 0)",
                "fsi_zone3score": "@if(greater(variables('ZoneScores')?['3']?['weight'], 0), div(variables('ZoneScores')?['3']?['weightedSum'], variables('ZoneScores')?['3']?['weight']), 0)",
                "fsi_compliantcount": "@variables('StatusCounts')?['compliant']",
                "fsi_partialcount": "@variables('StatusCounts')?['partial']",
                "fsi_noncompliantcount": "@variables('StatusCounts')?['noncompliant']",
                "fsi_exceptioncount": "@min(length(outputs('Get_Open_Exception_Count')?['body/value']), 999)"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
      }
      }
    },
    "Condition_Send_Success_Notification": {
      "runAfter": {
        "Scope_Main": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@variables('CD_NotificationEmail')",
                ""
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@variables('CD_NotificationEmail')",
                "@null"
              ]
            }
          }
        ]
      },
      "type": "If",
      "description": "Only send success notification if notification email is configured, non-empty, and non-null",
      "actions": {
        "Send_Success_Notification": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{variables('CD_NotificationEmail')}",
                "Subject": "Compliance Score Calculated - @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                "Body": "<p>Daily compliance score calculation completed successfully.</p><p><strong>Overall Score:</strong> @{outputs('Calculate_Overall_Score')}</p><p><strong>Status Breakdown:</strong></p><ul><li>Compliant: @{variables('StatusCounts')?['compliant']}</li><li>Partial: @{variables('StatusCounts')?['partial']}</li><li>Non-Compliant: @{variables('StatusCounts')?['noncompliant']}</li></ul><p><strong>Open Exceptions:</strong> @{length(outputs('Get_Open_Exception_Count')?['body/value'])}</p>",
                "Importance": "Normal"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "Scope_Error_Handler": {
      "runAfter": {
        "Scope_Main": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "Scope",
      "actions": {
        "Check_Email_Configured_SC": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@variables('CD_NotificationEmail')",
                    ""
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@variables('CD_NotificationEmail')",
                    "@null"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Send_Error_Notification": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage": {
                    "To": "@{variables('CD_NotificationEmail')}",
                    "Subject": "ALERT: CD-ScoreCalculator Flow Failed - @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')}",
                    "Body": "<p><strong style='color:red;'>Flow Execution Failed</strong></p><p>The CD-ScoreCalculator flow encountered an error during execution. Please check the flow run history in Power Automate for details.</p><p><strong>Timestamp:</strong> @{utcNow()}</p>",
                    "Importance": "High"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "description": "Only send error notification if CD_NotificationEmail is configured"
        }
      }
    }
  },
  "outputs": {},
  "description": "CD-ScoreCalculator: Calculates daily compliance scores from control assessments"
}
