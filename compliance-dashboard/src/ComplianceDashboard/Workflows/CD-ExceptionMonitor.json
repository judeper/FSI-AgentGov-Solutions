{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Hour",
        "interval": 1
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Initialize_SLA_Days": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SLADays",
            "type": "object",
            "value": {
              "1": 7,
              "2": 14,
              "3": 30,
              "4": 90
            }
          }
        ]
      },
      "description": "SLA days by severity: Critical=7, High=14, Medium=30, Low=90"
    },
    "Initialize_Breached_Exceptions": {
      "runAfter": {
        "Initialize_SLA_Days": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "BreachedExceptions",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Initialize_CD_NotificationEmail": {
      "runAfter": {
        "Initialize_Breached_Exceptions": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CD_NotificationEmail",
            "type": "string",
            "value": "@parameters('fsi_CD_NotificationEmail')"
          }
        ]
      }
    },
    "Initialize_CD_TeamsWebhook": {
      "runAfter": {
        "Initialize_CD_NotificationEmail": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "CD_TeamsWebhook",
            "type": "string",
            "value": "@parameters('fsi_CD_TeamsWebhook')"
          }
        ]
      },
      "description": "Reserved for future webhook integration. Not currently referenced by any action; Post_Teams_Alert uses the Teams connector directly."
    },
    "Scope_Main": {
      "runAfter": {
        "Initialize_CD_TeamsWebhook": [
          "Succeeded"
        ]
      },
      "type": "Scope",
      "actions": {
    "List_Open_Exceptions": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "fsi_complianceexceptions",
          "$select": "fsi_complianceexceptionid,fsi_name,fsi_severity,fsi_exceptionstatus,fsi_slastatus,fsi_targetdate,createdon",
          "$expand": "fsi_owner($select=internalemailaddress,fullname),fsi_controlassessmentid($select=fsi_name)",
          "$filter": "fsi_exceptionstatus eq 1 or fsi_exceptionstatus eq 2 or fsi_exceptionstatus eq 3"
        },
        "authentication": "@parameters('$authentication')",
        "retryPolicy": {
          "type": "exponential",
          "count": 3,
          "interval": "PT10S",
          "maximumInterval": "PT1M"
        }
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "Apply_to_each_Exception": {
      "foreach": "@outputs('List_Open_Exceptions')?['body/value']",
      "actions": {
        "Calculate_Days_Open": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@div(sub(ticks(utcNow()), ticks(items('Apply_to_each_Exception')?['createdon'])), 864000000000)"
        },
        "Get_SLA_Days": {
          "runAfter": {
            "Calculate_Days_Open": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(items('Apply_to_each_Exception')?['fsi_severity'], 1), variables('SLADays')?['1'], if(equals(items('Apply_to_each_Exception')?['fsi_severity'], 2), variables('SLADays')?['2'], if(equals(items('Apply_to_each_Exception')?['fsi_severity'], 3), variables('SLADays')?['3'], variables('SLADays')?['4'])))"
        },
        "Calculate_SLA_Threshold": {
          "runAfter": {
            "Get_SLA_Days": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@mul(outputs('Get_SLA_Days'), 0.8)",
          "description": "80% threshold for At Risk status"
        },
        "Determine_New_SLA_Status": {
          "runAfter": {
            "Calculate_SLA_Threshold": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(outputs('Calculate_Days_Open'), outputs('Get_SLA_Days')), 3, if(greater(outputs('Calculate_Days_Open'), outputs('Calculate_SLA_Threshold')), 2, 1))",
          "description": "1=On Track, 2=At Risk, 3=Breached"
        },
        "Get_Previous_SLA_Status": {
          "runAfter": {
            "Determine_New_SLA_Status": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(items('Apply_to_each_Exception')?['fsi_slastatus'], 1)"
        },
        "Update_Exception_Record": {
          "runAfter": {
            "Condition_Status_Changed_to_At_Risk": [
              "Succeeded",
              "Skipped"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_complianceexceptions",
              "recordId": "@items('Apply_to_each_Exception')?['fsi_complianceexceptionid']",
              "item": {
                "fsi_daysopen": "@int(outputs('Calculate_Days_Open'))",
                "fsi_slastatus": "@outputs('Determine_New_SLA_Status')"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        },
        "Condition_Status_Changed_to_Breached": {
          "actions": {
            "Append_to_Breached_List": {
              "runAfter": {},
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "BreachedExceptions",
                "value": {
                  "name": "@items('Apply_to_each_Exception')?['fsi_name']",
                  "control": "@items('Apply_to_each_Exception')?['fsi_controlassessmentid']?['fsi_name']",
                  "owner": "@items('Apply_to_each_Exception')?['fsi_owner']?['fullname']",
                  "ownerEmail": "@items('Apply_to_each_Exception')?['fsi_owner']?['internalemailaddress']",
                  "daysOpen": "@outputs('Calculate_Days_Open')",
                  "sla": "@outputs('Get_SLA_Days')",
                  "targetDate": "@items('Apply_to_each_Exception')?['fsi_targetdate']"
                }
              }
            },
            "Send_Breach_Email": {
              "runAfter": {
                "Append_to_Breached_List": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage": {
                    "To": "@{coalesce(items('Apply_to_each_Exception')?['fsi_owner']?['internalemailaddress'], variables('CD_NotificationEmail'))}",
                    "Cc": "@{variables('CD_NotificationEmail')}",
                    "Subject": "URGENT: SLA Breached - @{items('Apply_to_each_Exception')?['fsi_name']}",
                    "Body": "<p><strong style='color:red;'>SLA BREACHED</strong></p><p><strong>Exception:</strong> @{items('Apply_to_each_Exception')?['fsi_name']}</p><p><strong>Control:</strong> @{items('Apply_to_each_Exception')?['fsi_controlassessmentid']?['fsi_name']}</p><p><strong>Days Open:</strong> @{int(outputs('Calculate_Days_Open'))} (SLA: @{outputs('Get_SLA_Days')} days)</p><p><strong>Days Overdue:</strong> @{sub(int(outputs('Calculate_Days_Open')), outputs('Get_SLA_Days'))}</p><p><strong>Target Remediation Date:</strong> @{items('Apply_to_each_Exception')?['fsi_targetdate']}</p><p>Immediate action is required. Please update the remediation plan and status.</p>",
                    "Importance": "High"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            },
            "Post_Teams_Alert": {
              "runAfter": {
                "Send_Breach_Email": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_teams",
                  "operationId": "PostMessageToConversation",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@{variables('CD_NotificationEmail')}",
                  "body/messageBody": "<p><strong style='color:red;'>🚨 SLA BREACHED</strong></p><p><strong>Exception:</strong> @{items('Apply_to_each_Exception')?['fsi_name']}</p><p><strong>Control:</strong> @{items('Apply_to_each_Exception')?['fsi_controlassessmentid']?['fsi_name']}</p><p><strong>Owner:</strong> @{items('Apply_to_each_Exception')?['fsi_owner']?['fullname']}</p><p><strong>Days Open:</strong> @{int(outputs('Calculate_Days_Open'))} (SLA: @{outputs('Get_SLA_Days')} days)</p><p><strong>Days Overdue:</strong> @{sub(int(outputs('Calculate_Days_Open')), outputs('Get_SLA_Days'))}</p>",
                  "body/isAlert": true
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "runAfter": {
            "Get_Previous_SLA_Status": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Determine_New_SLA_Status')",
                  3
                ]
              },
              {
                "not": {
                  "equals": [
                    "@outputs('Get_Previous_SLA_Status')",
                    3
                  ]
                }
              }
            ]
          },
          "type": "If",
          "description": "Send notification only if status just changed to Breached"
        },
        "Condition_Status_Changed_to_At_Risk": {
          "actions": {
            "Send_Warning_Email": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage": {
                    "To": "@{coalesce(items('Apply_to_each_Exception')?['fsi_owner']?['internalemailaddress'], variables('CD_NotificationEmail'))}",
                    "Subject": "WARNING: Exception At Risk - @{items('Apply_to_each_Exception')?['fsi_name']}",
                    "Body": "<p><strong style='color:orange;'>SLA AT RISK</strong></p><p><strong>Exception:</strong> @{items('Apply_to_each_Exception')?['fsi_name']}</p><p><strong>Control:</strong> @{items('Apply_to_each_Exception')?['fsi_controlassessmentid']?['fsi_name']}</p><p><strong>Days Open:</strong> @{int(outputs('Calculate_Days_Open'))} (SLA: @{outputs('Get_SLA_Days')} days)</p><p><strong>Days Remaining:</strong> @{sub(outputs('Get_SLA_Days'), int(outputs('Calculate_Days_Open')))}</p><p><strong>Target Remediation Date:</strong> @{items('Apply_to_each_Exception')?['fsi_targetdate']}</p><p>This exception is approaching SLA breach. Please prioritize remediation efforts.</p>",
                    "Importance": "Normal"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "runAfter": {
            "Condition_Status_Changed_to_Breached": [
              "Succeeded",
              "Skipped"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Determine_New_SLA_Status')",
                  2
                ]
              },
              {
                "equals": [
                  "@outputs('Get_Previous_SLA_Status')",
                  1
                ]
              }
            ]
          },
          "type": "If",
          "description": "Send warning only if status just changed from On Track to At Risk"
        }
      },
      "runAfter": {
        "List_Open_Exceptions": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      }
    },
    "Condition_Send_Daily_Summary": {
      "actions": {
        "List_All_Breached_Exceptions": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fsi_complianceexceptions",
              "$select": "fsi_name,fsi_daysopen,fsi_slastatus,fsi_severity,fsi_targetdate",
              "$expand": "fsi_owner($select=fullname),fsi_controlassessmentid($select=fsi_name)",
              "$filter": "(fsi_exceptionstatus eq 1 or fsi_exceptionstatus eq 2 or fsi_exceptionstatus eq 3) and fsi_slastatus eq 3"
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        },
        "Send_Daily_Summary_Email": {
          "runAfter": {
            "List_All_Breached_Exceptions": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage": {
                "To": "@{variables('CD_NotificationEmail')}",
                "Subject": "Daily Exception Summary - @{length(outputs('List_All_Breached_Exceptions')?['body/value'])} Breached",
                "Body": "<h2>Daily Exception Summary</h2><p><strong>Total Breached Exceptions:</strong> @{length(outputs('List_All_Breached_Exceptions')?['body/value'])}</p><p><strong>Newly Breached This Cycle:</strong> @{length(variables('BreachedExceptions'))}</p><p>Please review and expedite remediation for all breached exceptions.</p>",
                "Importance": "High"
              }
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "maximumInterval": "PT1M"
            }
          }
        }
      },
      "runAfter": {
        "Apply_to_each_Exception": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@formatDateTime(utcNow(), 'HH')",
              "09"
            ]
          },
          {
            "not": {
              "equals": [
                "@variables('CD_NotificationEmail')",
                ""
              ]
            }
          }
        ]
      },
      "type": "If",
      "description": "Send daily summary at 9 AM UTC with all breached exceptions"
    }
    }
    },
    "Scope_Error_Handler": {
      "runAfter": {
        "Scope_Main": [
          "Failed",
          "TimedOut"
        ]
      },
      "type": "Scope",
      "actions": {
        "Check_Email_Configured_EM": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@variables('CD_NotificationEmail')",
                    ""
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@variables('CD_NotificationEmail')",
                    "@null"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Send_Error_Notification": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage": {
                    "To": "@{variables('CD_NotificationEmail')}",
                    "Subject": "ALERT: CD-ExceptionMonitor Flow Failed - @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')}",
                    "Body": "<p><strong style='color:red;'>Flow Execution Failed</strong></p><p>The CD-ExceptionMonitor flow encountered an error during execution. Please check the flow run history in Power Automate for details.</p><p><strong>Timestamp:</strong> @{utcNow()}</p>",
                    "Importance": "High"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT10S",
                  "maximumInterval": "PT1M"
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "description": "Only send error notification if CD_NotificationEmail is configured"
        }
      }
    }
  },
  "outputs": {},
  "description": "CD-ExceptionMonitor: Updates exception SLA status and sends alerts for at-risk items"
}
