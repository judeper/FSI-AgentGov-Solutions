{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "style": "attention",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "[ALERT] Audit Configuration Drift -- Tenant",
                  "weight": "Bolder",
                  "size": "Medium",
                  "color": "Attention"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${overallStatus}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "color": "Attention"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${timestamp}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Drift Detected",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true,
          "spacing": "Medium"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Severity",
              "value": "${overallStatus}"
            },
            {
              "title": "Zone",
              "value": "${zone}"
            },
            {
              "title": "Drift From",
              "value": "${baselineStatus} → ${currentStatus}"
            },
            {
              "title": "Baseline Date",
              "value": "${baselineDate}"
            }
          ],
          "spacing": "Medium"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Reason",
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "${reason}",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Validator Status",
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Unified Audit Log",
              "value": "${unifiedAuditLogStatus}"
            },
            {
              "title": "Mailbox Audit",
              "value": "${mailboxAuditStatus}"
            },
            {
              "title": "Purview Retention",
              "value": "${purviewRetentionStatus}"
            }
          ],
          "spacing": "Small"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "View in Power Platform",
      "url": "https://make.powerapps.com"
    },
    {
      "type": "Action.OpenUrl",
      "title": "View Validation History",
      "url": "${validationHistoryUrl}"
    }
  ]
}
