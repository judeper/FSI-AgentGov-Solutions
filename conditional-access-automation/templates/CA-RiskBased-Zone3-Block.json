{
  "displayName": "CA-RiskBased-Zone3-Block",
  "state": "enabledForReportingButNotEnforced",
  "_comment": "Optional add-on template — blocks access for any sign-in risk against Zone-3 AI applications. Requires Microsoft Entra ID P2 (risk evaluation is a P2 feature). Deploy AFTER the base CA-CopilotStudio-Zone3 / CA-AgentBuilder-Zone3 / CA-RequireCompliantDevice-Zone3 templates so the MFA + compliant-device base controls remain enforced.",
  "conditions": {
    "signInRiskLevels": ["low", "medium", "high"],
    "userRiskLevels": ["medium", "high"],
    "applications": {
      "includeApplications": [
        "<copilot-studio-app-id>",
        "<agent-builder-app-id>",
        "<m365-copilot-app-id>"
      ]
    },
    "users": {
      "includeUsers": ["All"],
      "excludeUsers": [
        "<break-glass-1>",
        "<break-glass-2>"
      ],
      "excludeGroups": [
        "<service-account-group-id>"
      ]
    },
    "clientAppTypes": ["all"]
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": ["block"]
  },
  "_metadata": {
    "schemaVersion": "v1.0",
    "lastValidated": "2026-02-10",
    "targetControl": "1.11"
  }
}
