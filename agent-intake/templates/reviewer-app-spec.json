  "dashboards": [
    {
      "name": "Reviewer Operations",
      "automation": "manual",
      "cards": [
        {
          "title": "Requests by tier",
          "table": "fsi_intakerequest",
          "visual": "chart",
          "chartType": "stackedColumn",
          "aggregate": "count",
          "groupBy": "fsi_risktier"
        },
        {
          "title": "Requests by path",
          "table": "fsi_intakerequest",
          "visual": "chart",
          "chartType": "donut",
          "aggregate": "count",
          "groupBy": "fsi_pathused"
        },
        {
          "title": "MRM queue",
          "table": "fsi_intakerequest",
          "visual": "view",
          "view": "MRM queue"
        }
      ]
    },
    {
      "name": "Reviewer SLA",
      "automation": "manual",
      "cards": [
        {
          "title": "Average decision latency by role",
          "table": "fsi_intakereview",
          "visual": "chart",
          "chartType": "bar",
          "aggregate": "averageDurationHours",
          "groupBy": "fsi_reviewerrole",
          "startColumn": "fsi_startedon",
          "endColumn": "fsi_completedon"
        },
        {
          "title": "SLA breaches",
          "table": "fsi_intakereview",
          "visual": "view",
          "filter": "fsi_dueon lt Now() and fsi_reviewoutcome = Pending"
        },
        {
          "title": "Approved with conditions",
          "table": "fsi_intakereview",
          "visual": "view",
          "view": "Approved with conditions"
        },
        {
          "title": "Denied",
          "table": "fsi_intakereview",
          "visual": "view",
          "view": "Denied"
        }
      ]
    }
  ],
  "forms": [
    {
      "name": "Reviewer triage workspace",
      "automation": "manual",
      "pattern": "pairedForms",
      "description": "Open the read-only request context form on fsi_intakerequest and pin the editable reviewer decision form on fsi_intakereview in a side pane. This satisfies the one-screen triage goal without requiring a new Dataverse lookup.",
      "requestContext": {
        "table": "fsi_intakerequest",
        "sections": [
          {
            "name": "Header",
            "fields": [
              "fsi_requestid",
              "fsi_agentdisplayname",
              "fsi_status",
              "fsi_pathused",
              "fsi_risktier",
              "fsi_zone"
            ]
          },
          {
            "name": "Maker context",
            "fields": [
              "fsi_makerdisplayname",
              "fsi_makerupn",
              "fsi_intendedaudience",
              "fsi_businessoutcome",
              "fsi_businessjustification"
            ]
          },
          {
            "name": "Routing context",
            "fields": [
              "fsi_quorumrequired",
              "fsi_parallelreviewersjson",
              "fsi_mrmrequired",
              "fsi_mrmhandoffstatus",
              "fsi_targetenvironmentname"
            ]
          }
        ]
      },
      "reviewDecision": {
        "table": "fsi_intakereview",
        "sections": [
          {
            "name": "Assignment",
            "fields": [
              "fsi_requestid",
              "fsi_reviewerrole",
              "fsi_reviewerupn",
              "fsi_reviewtype",
              "fsi_dueon",
              "fsi_quorumweight"
            ]
          },
          {
            "name": "Decision",
            "fields": [
              "fsi_reviewoutcome",
              "fsi_conditionstext",
              "fsi_reviewnotes",
              "fsi_startedon",
              "fsi_completedon"
            ]
          }
        ]
      }
    },
    {
      "name": "Audit decision log",
      "automation": "manual",
      "table": "fsi_intakedecisionlog",
      "description": "Read-only audit form for retained decision-pack evidence.",
      "sections": [
        {
          "name": "Decision summary",
          "fields": [
            "fsi_requestid",
            "fsi_decisionoutcome",
            "fsi_risktier",
            "fsi_zone",
            "fsi_pathused",
            "fsi_decidedon"
          ]
        },
        {
          "name": "Evidence",
          "fields": [
            "fsi_policyversionapplied",
            "fsi_decisionpackhash",
            "fsi_retentionlabelapplied",
            "fsi_retentionlabelappliedon"
          ]
        }
      ]
    }
  ],
