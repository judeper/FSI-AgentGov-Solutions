  "businessRules": [
    {
      "name": "Reviewer conditions required",
      "table": "fsi_intakereview",
      "automation": "manual",
      "implementedByScript": false,
      "condition": "fsi_reviewoutcome == Approved with conditions",
      "effect": "Require fsi_conditionstext before the decision can be saved."
    },
    {
      "name": "Reviewer decision lock after audit event",
      "table": "fsi_intakereview",
      "automation": "manual-server-guard",
      "implementedByScript": false,
      "condition": "Related fsi_intakeauditevent contains EventType = ReviewerDecided or PathPhase = ReviewerDecided",
      "effect": "Prevent further edits to fsi_reviewoutcome, fsi_conditionstext, and fsi_reviewnotes after the decision has been recorded."
    }
  ],
  "teamsNotification": {
    "flowName": "fsi-intake-reviewer-card",
    "cardTemplatePath": "agent-intake/templates/reviewer-notification-card.json",
    "actions": [
      "Approve",
      "Approve with conditions",
      "Deny",
      "Open in reviewer app"
    ]
  },
  "manualSteps": [
    {
      "area": "App designer pages",
      "message": "Add Dataverse table pages for fsi_intakerequest, fsi_intakereview, and the audit surfaces in the model-driven app designer. PAC CLI creates the app shell but does not yet compose table pages or sitemap groups for this design."
    },
    {
      "area": "Paired-form workspace",
      "message": "Use a request context main form and a reviewer decision side-pane form because the preview schema uses fsi_requestid soft foreign keys rather than Dataverse lookups."
    },
    {
      "area": "Dashboards",
      "message": "Create the Reviewer Operations and Reviewer SLA dashboards in the maker portal, using the chart and view definitions above."
    },
    {
      "area": "Business rules",
      "message": "Build the conditions-required business rule in Dataverse and implement the post-audit decision lock in the reviewer decision writer or a plug-in because Dataverse business rules cannot query fsi_intakeauditevent."
    },
    {
      "area": "Queue routing",
      "message": "If your routing flow does not reassign fsi_intakereview ownership to the reviewer user, replace the My open reviews system view with a custom page or personal view that filters on fsi_reviewerupn."
    }
  ]
}
