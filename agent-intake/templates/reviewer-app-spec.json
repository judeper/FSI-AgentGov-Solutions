{
  "schemaVersion": "1.0.0-preview",
  "appName": "AgentIntakeReviewerApp",
  "appDisplayName": "FSI Agent Intake Reviewer",
  "appDescription": "Model-driven reviewer workspace for Standard and Full agent-intake paths.",
  "solutionName": "AgentIntakeReviewerApp",
  "solutionDisplayName": "FSI Agent Intake Reviewer App",
  "solutionVersion": "1.0.0.0",
  "publisher": {
    "name": "FSIPublisher",
    "uniqueName": "FSIPublisher",
    "prefix": "fsi",
    "customizationOptionValuePrefix": 10000,
    "description": "Shared FSI publisher used for reviewer-app assets."
  },
  "reviewerRoles": [
    "InfoSec",
    "Privacy",
    "Compliance",
    "Legal",
    "MRM"
  ],
  "queueAssumptions": {
    "reviewTableOwnership": "Route each fsi_intakereview row to the assigned reviewer as the Dataverse owner so the My open reviews system view can use ownerid = Current User.",
    "softForeignKeyCaveat": "The preview schema links request and review records by fsi_requestid rather than a Dataverse lookup. The app therefore uses paired request and review forms unless the customer adds a true lookup in a future schema pass.",
    "roleScopedViews": "Dataverse system views do not evaluate a custom role token at runtime. Awaiting my role is materialized as one system view per reviewer role."
  },
  "optionsets": {
    "fsi_intake_pathused": {
      "Express": 100000000,
      "Standard": 100000001,
      "Full": 100000002
    },
    "fsi_intake_status": {
      "Draft": 100000000,
      "Submitted": 100000001,
      "AwaitingSponsor": 100000002,
      "AwaitingReviewers": 100000003,
      "Approved": 100000004,
      "Denied": 100000005,
      "Withdrawn": 100000006,
      "Escalated": 100000007,
      "AutoApproved": 100000008,
      "DeferredOutOfScope": 100000009,
      "SponsorTimeout": 100000010,
      "InReview": 100000011,
      "LiveTracking": 100000012
    },
    "fsi_intake_reviewerrole": {
      "InfoSec": 100000000,
      "Privacy": 100000001,
      "Compliance": 100000002,
      "Legal": 100000003,
      "MRM": 100000004,
      "Sponsor": 100000005
    },
    "fsi_intake_reviewdecision": {
      "Pending": 100000000,
      "Approved": 100000001,
      "Approved with conditions": 100000002,
      "Denied": 100000003,
      "Recused": 100000004,
      "Timeout": 100000005
    },
    "fsi_intake_risktier": {
      "Tier 1 (High)": 100000000,
      "Tier 2 (Medium)": 100000001,
      "Tier 3 (Low)": 100000002
    },
    "fsi_acv_zone": {
      "Unclassified": 100000000,
      "Zone 1 (Enterprise)": 100000001,
      "Zone 2 (Team)": 100000002,
      "Zone 3 (Personal)": 100000003
    },
    "fsi_intake_mrmhandoffstatus": {
      "Pending": 100000000,
      "Handed off": 100000001,
      "NotApplicable": 100000002,
      "Failed": 100000003
    }
  },
  "tables": [
    {
      "logicalName": "fsi_intakerequest",
      "schemaName": "fsi_IntakeRequest",
      "entitySetName": "fsi_intakerequests",
      "primaryIdAttribute": "fsi_intakerequestid",
      "displayName": "Intake Request",
      "appUsage": "Primary reviewer queue and request context surface.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakereview",
      "schemaName": "fsi_IntakeReview",
      "entitySetName": "fsi_intakereviews",
      "primaryIdAttribute": "fsi_intakereviewid",
      "displayName": "Intake Review",
      "appUsage": "Reviewer-owned decision rows for Standard and Full paths.",
      "access": "read-write"
    },
    {
      "logicalName": "fsi_intakeapproval",
      "schemaName": "fsi_IntakeApproval",
      "entitySetName": "fsi_intakeapprovals",
      "primaryIdAttribute": "fsi_intakeapprovalid",
      "displayName": "Intake Approval",
      "appUsage": "Read-only sponsor and approver history.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakesponsorship",
      "schemaName": "fsi_IntakeSponsorship",
      "entitySetName": "fsi_intakesponsorships",
      "primaryIdAttribute": "fsi_intakesponsorshipid",
      "displayName": "Intake Sponsorship",
      "appUsage": "Read-only sponsor attestation evidence.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakedatasource",
      "schemaName": "fsi_IntakeDataSource",
      "entitySetName": "fsi_intakedatasources",
      "primaryIdAttribute": "fsi_intakedatasourceid",
      "displayName": "Intake Data Source",
      "appUsage": "Read-only declared data-source context.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakerisksignal",
      "schemaName": "fsi_IntakeRiskSignal",
      "entitySetName": "fsi_intakerisksignals",
      "primaryIdAttribute": "fsi_intakerisksignalid",
      "displayName": "Intake Risk Signal",
      "appUsage": "Read-only routing and trigger evidence.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakeauditevent",
      "schemaName": "fsi_IntakeAuditEvent",
      "entitySetName": "fsi_intakeauditevents",
      "primaryIdAttribute": "fsi_intakeauditeventid",
      "displayName": "Intake Audit Event",
      "appUsage": "Read-only lifecycle trail for transparency and lock checks.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakedecisionlog",
      "schemaName": "fsi_IntakeDecisionLog",
      "entitySetName": "fsi_intakedecisionlogs",
      "primaryIdAttribute": "fsi_intakedecisionlogid",
      "displayName": "Intake Decision Log",
      "appUsage": "Read-only immutable decision-pack evidence.",
      "access": "read-only"
    },
    {
      "logicalName": "fsi_intakeretentionrecord",
      "schemaName": "fsi_IntakeRetentionRecord",
      "entitySetName": "fsi_intakeretentionrecords",
      "primaryIdAttribute": "fsi_intakeretentionrecordid",
      "displayName": "Intake Retention Record",
      "appUsage": "Read-only Purview retention-stamping evidence for audit visibility.",
      "access": "read-only"
    }
  ],
  "navigation": [
    {
      "title": "My open reviews",
      "table": "fsi_intakereview",
      "defaultView": "My open reviews"
    },
    {
      "title": "Requests in queue",
      "table": "fsi_intakerequest",
      "defaultView": "All Standard requests in queue"
    },
    {
      "title": "Audit",
      "table": "fsi_intakereview",
      "defaultView": "Approved with conditions"
    }
  ],
  "views": [
    {
      "name": "My open reviews",
      "table": "fsi_intakereview",
      "automation": "provisioned",
      "description": "Pending review rows owned by the current reviewer.",
      "conditions": [
        {
          "attribute": "ownerid",
          "operator": "eq-userid"
        },
        {
          "attribute": "fsi_reviewoutcome",
          "operator": "eq",
          "choiceSet": "fsi_intake_reviewdecision",
          "choice": "Pending"
        }
      ],
      "sort": [
        {
          "attribute": "fsi_dueon",
          "descending": false
        },
        {
          "attribute": "createdon",
          "descending": true
        }
      ],
      "columns": [
        {
          "name": "fsi_requestid",
          "width": 150
        },
        {
          "name": "fsi_reviewerrole",
          "width": 120
        },
        {
          "name": "fsi_reviewtype",
          "width": 120
        },
        {
          "name": "fsi_dueon",
          "width": 140
        },
        {
          "name": "fsi_reviewoutcome",
          "width": 130
        },
        {
          "name": "fsi_quorumweight",
          "width": 110
        }
      ]
    },
    {
