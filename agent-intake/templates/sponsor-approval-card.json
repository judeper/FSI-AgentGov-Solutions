{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Agent intake sponsor approval",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Please review this Express-path request and record your FINRA Rule 3110 supervisory decision.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Request ID",
          "value": "${fsi_requestid}"
        },
        {
          "title": "Agent",
          "value": "${fsi_agentdisplayname}"
        },
        {
          "title": "Maker",
          "value": "${fsi_makerdisplayname} (${fsi_makerupn})"
        },
        {
          "title": "Audience",
          "value": "${fsi_intendedaudience}"
        },
        {
          "title": "Submitted",
          "value": "${fsi_submittedon}"
        },
        {
          "title": "Tier / Zone",
          "value": "Tier ${fsi_risktier} / Zone ${fsi_zone}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Business justification",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${fsi_businessjustification}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Sponsor attestation",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "By approving, you confirm that you are the assigned business sponsor; the stated purpose is legitimate and necessary; you accept supervisory responsibility for the agent under FINRA Rule 3110; and you will be notified if the risk profile materially changes. The decision is retained as a supervisory record for 7 years under FINRA 4511, SEC 17a-4, and CFTC 1.31.",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "fsi_sponsornotes",
      "label": "Decision notes (optional)",
      "isMultiline": true,
      "maxLength": 1000,
      "placeholder": "Add conditions, concerns, or rationale."
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Approve",
      "style": "positive",
      "associatedInputs": "auto",
      "data": {
        "action": "sponsorDecision",
        "decision": "Approved",
        "requestId": "${fsi_requestid}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Deny",
      "style": "destructive",
      "associatedInputs": "auto",
      "data": {
        "action": "sponsorDecision",
        "decision": "Denied",
        "requestId": "${fsi_requestid}"
      }
    }
  ]
}