{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://judeper.github.io/FSI-AgentGov-Solutions/controls-covered.schema.json",
  "title": "FSI-AgentGov Solution Control Coverage",
  "description": "Per-solution control-coverage export. Generated by build-manifest.py from manifest.yaml; consumed by the framework solutions-lock.json contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedBy",
    "solutionId",
    "solutionName",
    "solutionVersion",
    "status",
    "controls",
    "controlCount"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for this export format."
    },
    "generatedBy": {
      "type": "string",
      "const": "scripts/build-manifest.py",
      "description": "Build script that produced this file."
    },
    "solutionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Canonical solution ID (matches manifest.yaml id and folder name)."
    },
    "solutionName": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable solution display name."
    },
    "solutionVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "description": "Solution version (semver, no leading v)."
    },
    "status": {
      "type": "string",
      "enum": ["live", "preview"],
      "description": "Solution maturity status."
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "coverage"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "Framework control ID (e.g. 2.12)."
          },
          "coverage": {
            "type": "string",
            "enum": ["full", "partial"],
            "description": "Coverage level. Defaults to full when not overridden in manifest.yaml."
          }
        }
      },
      "uniqueItems": true,
      "description": "Framework controls implemented by this solution with coverage level."
    },
    "controlCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of controls covered (convenience field)."
    }
  }
}
